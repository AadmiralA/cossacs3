// _gui_DoProgressSoundControlCounters
//
procedure _gui_DoProgressSoundControlCounters();
begin
   // _sound_EmitterPlaySound
   //
   function _sound_EmitterPlayWalkSound(const emitterHnd : Integer; const libind, sndlibind : Integer; vol, interval : Float; bplayuniq : Boolean) : Integer;
   begin
      if (emitterHnd<>0) then
      begin
         var newind : Integer;
         var rndind : Integer;
         var maxind : Integer = gSoundLibrary[sndlibind].count-1;
         if (maxind>0) then
         rndind := floor(random*(maxind+1));
         
         // test hack, make different counters for different types and support several counters on one type at once
         if maxind<0 then
         ErrorLog('_sound_EmitterPlayWalkSound maxind<0');
         rndind := gint_soundsteptick mod (maxind+1);
         gint_soundsteptick := gint_soundsteptick+1;
         //
         
         var i : Integer;
         for i:=0 to maxind do
         begin
            newind := rndind+i;
            if (newind>maxind) then
            newind := newind-maxind-1;
            var libname : String;
            case libind of
               gc_sndlib_ind_units : libname := 'units';
               gc_sndlib_ind_interface : libname := 'interface';
               gc_sndlib_ind_ambient : libname := 'ambient';
            end;
            var sndTag : Integer;
            if (not bplayuniq) then
            sndtag := _sound_GetTagByIndexes(sndlibind, newind)
            else
            sndtag := 1000000+sndlibind;
            Result := sndtag;
            
            var sndHnd : Integer = SndGetOrCreateSound(sndtag, libname, emitterHnd);
            if (not GetSndSoundPlaying(sndHnd)) then
            begin
               SetSndSoundSourceName(gSoundLibrary[sndlibind].list[newind], sndHnd);
               SetSndSoundVolume(vol, sndHnd);
               //log('_sound_EmitterPlaySound : '+gSoundLibrary[sndlibind].list[newind]);
               SetSndSoundRadius(8000, sndHnd); //80 - for 3D sound, 8000 for isometric sound
               SetSndSoundPlaying(True, sndHnd);
               break;
            end
            else
            SetSndSoundVolume(vol, sndHnd);
         end;
      end
      else
      Result := 0;
   end;
   
   procedure GetScreenListenerPos(var lx, ly, lz : Float);
   begin
      var rx, ry, rz : Float;
      var px, py, pz : Float;
      ScreenToWorldRayCast(GetViewerWidth div 2, GetViewerHeight div 2{floor((GetViewerHeight div 7)*3)}, rx, ry, rz);
      GetCameraTargetPosition(px, py, pz);
      var dst : Float = VectorDistance(px, py, pz, rx, ry, rz);
      var dirx : Float = rx-px;
      var diry : Float = ry-py;
      var dirz : Float = rz-pz;
      VectorNormalize(dirx, diry, dirz);
      // listner pos
      lx := rx-dst*dirx*0.3;
      ly := ry-dst*diry*0.15;
      lz := rz-dst*dirz*(0.0);
   end;
   
   function GetOrCreateSoundEmitterInListenerPos(lx, ly, lz : Float) : Integer;
   begin
      Result := gSoundManager.emitterhnd;
      if (Result=0) then
      begin
         if (GetCountOfPlayers>=gc_playerind_misc) then
         begin
            var miscplhnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
            Result := CreatePlayerGameObjectHandleByHandle(miscplhnd, gc_racename_misc, 'soundemitter', lx, ly, lz);
            SetGameObjectVisibleByHandle(Result, False);
            gSoundManager.emitterhnd := Result;
         end;
      end
      else
      SetGameObjectPositionByHandle(Result, lx, ly, lz);
   end;
   
   var lastprogresstime : Float = gProgress.soundcounterlastprogresstime;
   var deltatime : Float = GetCurrentTime-lastprogresstime;
   
   if (deltatime>0) and ((MinFloat((GetTimeSpeedFactor/10), 2)*deltatime)>0.09) then // not on pause
   begin
      var lx, ly, lz : Float;
      var lheight : Float;
      GetScreenListenerPos(lx, ly, lz);
      
      var listenerEmitterHnd : Integer = GetOrCreateSoundEmitterInListenerPos(lx, ly, lz);
      var basevol : Float;
      var progresstick : Integer = gProgress.soundcounterprogresstick;
      const minind = 0;
      const maxind = 7;
      var i : Integer;
      for i:=minind to maxind do
      begin
         var counter, sndlibind, ifreq : Integer;
         var dst : Float;
         case i of
            0 : counter := gSoundManager.counter.walkinfcloth;
            1 : counter := gSoundManager.counter.walkinfmetal;
            2 : counter := gSoundManager.counter.walkartwheels;
            3 : counter := gSoundManager.counter.walkartmortar;
            4 : counter := gSoundManager.counter.walkcavfast;
            5 : counter := gSoundManager.counter.walkcavslow;
            6 : counter := gSoundManager.counter.walkpea;
            7 : counter := gSoundManager.counter.walkpeastone;
         end;
         case i of
            0 : dst := gSoundManager.counter.walkdstinfcloth;
            1 : dst := gSoundManager.counter.walkdstinfmetal;
            2 : dst := gSoundManager.counter.walkdstartwheels;
            3 : dst := gSoundManager.counter.walkdstartmortar;
            4 : dst := gSoundManager.counter.walkdstcavfast;
            5 : dst := gSoundManager.counter.walkdstcavslow;
            6 : dst := gSoundManager.counter.walkdstpea;
            7 : dst := gSoundManager.counter.walkdstpeastone;
         end;
         case i of
            0 : sndlibind := gc_snd_ind_walkinfcloth;
            1 : sndlibind := gc_snd_ind_walkinfmetal;
            2 : sndlibind := gc_snd_ind_walkartwheels;
            3 : sndlibind := gc_snd_ind_walkartmortar;
            4 : sndlibind := gc_snd_ind_walkcavfast;
            5 : sndlibind := gc_snd_ind_walkcavslow;
            6 : sndlibind := gc_snd_ind_walkpea;
            7 : sndlibind := gc_snd_ind_walkpeastone;
         end;
         case i of
            0 : ifreq := 3;
            1 : ifreq := Max(3-((counter-1) div 5), 2);
            2 : ifreq := Max(5-((counter-1) div 3), 3);
            3 : ifreq := Max(5-((counter-1) div 3), 3);
            4 : ifreq := Max(5-counter+1, 3);
            5 : ifreq := Max(6-counter+1, 4);
            6 : ifreq := 3;
            7 : ifreq := 3;
         end;
         case i of
            0 : basevol := 1;
            1 : basevol := 1;
            2 : basevol := 0.35;
            3 : basevol := 0.35;
            4 : basevol := 1;
            5 : basevol := 1;
            6 : basevol := 0.1;
            7 : basevol := 1;
         end;
         // temp fix
         ifreq := 3;
         if (counter>0) then
         begin
            //var gametime : Float = GetGameTime;
            //if gametime>gProgress.lastsoundprogresscounterfreqtime[i] then
            //gProgress.lastsoundprogresscounterfreqtime[i] := gametime+ifreq*gc_progress_TimeSoundProgressCounterFreq;
            if ((progresstick mod ifreq)=0) then
            begin
               const interval = 100;
               var vol : Float = basevol*((gSoundManager.frustumrad-(dst/counter))/gSoundManager.frustumrad);
               vol := Clamp(vol, 0, 1);
               var sndtag : Integer = _sound_EmitterPlayWalkSound(listenerEmitterHnd, gc_sndlib_ind_units, sndlibind, vol, interval, False);
               // log
               gint_dbg_logsoundcount := gint_dbg_logsoundcount+1;
               if False then
               begin
                  var sndHnd : Integer = SndGetOrCreateSound(sndtag, 'units', listenerEmitterHnd);
                  SetSndSoundVolume(vol, sndHnd);
                  var sndName : String = GetSndSoundSourceName(sndHnd);
                  if sndName<>'' then
                  TimeLog('listenerEmitterHnd:'+' sndlibind='+IntToStr(sndlibind)+' count='+IntToStr(counter)+' vol='+FloatToStr(vol)+' sndname='+sndName);
               end;
            end;
         end;
      end;
      
      gProgress.soundcounterprogresstick := gProgress.soundcounterprogresstick + 1;
      gProgress.soundcounterlastprogresstime := GetCurrentTime;
   end;
end;

// _gui_DoProgressSoundControl
//
procedure _gui_DoProgressSoundControl();
begin
   procedure GetScreenListenerPos(var lx, ly, lz : Float);
   begin
      var rx, ry, rz : Float;
      var px, py, pz : Float;
      ScreenToWorldRayCast(GetViewerWidth div 2, GetViewerHeight div 2{floor((GetViewerHeight div 7)*3)}, rx, ry, rz);
      GetCameraTargetPosition(px, py, pz);
      var dst : Float = VectorDistance(px, py, pz, rx, ry, rz);
      var dirx : Float = rx-px;
      var diry : Float = ry-py;
      var dirz : Float = rz-pz;
      VectorNormalize(dirx, diry, dirz);
      // listner pos
      lx := rx-dst*dirx*0.3;
      ly := ry-dst*diry*0.15;
      lz := rz-dst*dirz*(0.0);
      //DebugDrawClean('a');
      //DebugDrawBox('a', lx, ly, lz, 1, 1, 1, 1);
   end;
   
   // _sound_EmitterPlaySound
   //
   function _sound_EmitterPlaySound(const emitterHnd : Integer; const libind, sndlibind : Integer; bplayuniq : Boolean) : Integer;
   begin
      if (emitterHnd<>0) then
      begin
         var newind : Integer;
         var rndind : Integer;
         var maxind : Integer = gSoundLibrary[sndlibind].count-1;
         if (maxind>0) then
         rndind := floor(random*(maxind+1));
         var i : Integer;
         for i:=0 to maxind do
         begin
            newind := rndind+i;
            if (newind>maxind) then
            newind := newind-maxind-1;
            var libname : String;
            case libind of
               gc_sndlib_ind_units : libname := 'units';
               gc_sndlib_ind_interface : libname := 'interface';
               gc_sndlib_ind_ambient : libname := 'ambient';
            end;
            var sndTag : Integer;
            if (not bplayuniq) then
            sndtag := _sound_GetTagByIndexes(sndlibind, newind)
            else
            sndtag := 1000000+sndlibind;
            //var sndtag : Integer = floor(random*1000000);
            Result := sndtag;
            //SndRemoveSound(sndtag, emitterHnd);
            
            var sndHnd : Integer = SndGetOrCreateSound(sndtag, libname, emitterHnd);
            
            var loudness : Float = gSoundLibrary[sndlibind].loudness*1.25;
            SetSndSoundRadiuses(0, loudness, sndHnd);
            
            if (not GetSndSoundPlaying(sndHnd)) then
            begin
               SetSndSoundSourceName(gSoundLibrary[sndlibind].list[newind], sndHnd);
               //log('_sound_EmitterPlaySound : '+gSoundLibrary[sndlibind].list[newind]);
               SetSndSoundPlaying(True, sndHnd);
               break;
            end;
         end;
      end
      else
      Result := 0;
   end;
   
   //_misc_ProfilerBegin('SoundControl');
   
   var lastprogresstime : Float = gProgress.soundlastprogresstime;
   var progresstick : Integer = gProgress.soundcounterprogresstick;
   
   procedure IntegerListMove(var fromlist, tolist : TIntegerList);
   begin
      var i : Integer;
      for i:=fromlist.GetCount-1 downto 0 do
      begin
         tolist.Add(fromlist.Get(i));
         fromlist.Delete(i);
      end;
   end;
   
   function GetOrCreateSoundEmitterInPos(posx, posz : Float) : Integer;
   begin
      Result := 0;
      GetGameObjectsInRadius(posx, posz, gc_epsilon, false, false, 0, -1, 0, false, false, false, false, false, false);
      var i : Integer;
      for i:=GetGameObjectListCount-1 downto 0 do
      begin
         var goHnd : Integer = GetGameObjectListByIndex(i);
         if (GetGameObjectStringPropertyTag(goHnd)=gc_properties_stringtag_soundemitter) then
         begin
            Result := goHnd;
            break;
         end;
      end;
      if (Result=0) then
      begin
         Result := CreatePoolGameObjectHandle(gc_racename_misc, 'soundemitter', posx, RayCastHeight(posx, posz), posz);
         GameObjectDelayExecuteStateByHandle(Result, 'FreeToPool', 10);
         SetGameObjectVisibleByHandle(Result, False);
      end;
   end;
   function GetOrCreateSoundEmitterInListenerPos(lx, ly, lz : Float) : Integer;
   begin
      Result := gSoundManager.emitterhnd;
      if (Result=0) then
      begin
         Result := CreatePoolGameObjectHandle(gc_racename_misc, 'soundemitter', lx, ly, lz);
         //FreeToPoolGameObjectTimeoutHandle(Result, 10);
         SetGameObjectVisibleByHandle(Result, False);
         gSoundManager.emitterhnd := Result;
      end
      else
      SetGameObjectPositionByHandle(Result, lx, ly, lz);
   end;
   
   var lx, ly, lz, plx, ply, plz : Float;
   var lheight : Float;
   GetScreenListenerPos(lx, ly, lz);
   GetPosSoundManagerListenerAsObject(plx, ply, plz);
   if (VectorDistance(plx, ply, plz, lx, ly, lz)>1) then
   SetPosSoundManagerListenerAsObject(lx, ly, lz);
   lheight := ly;
   ScreenToWorldRayCast(GetViewerWidth div 2, GetViewerHeight div 2, lx, ly, lz);
   
   //log('----');
   var gridx, gridy : Integer;
   // combine
   const tries = 1;
   var enum : Integer;
   var bfreqok : array [0..3] of Boolean;
   //var gametime : Float = GetGameTime;
   var i : Integer;
   {for i:=0 to 3 do
   begin
      if gametime>gProgress.lastsoundprogressfreqtime[i] then
      begin
         gProgress.lastsoundprogressfreqtime[i] := gametime+(i+1)*gc_progress_TimeSoundProgressFreq;
         bfreqok[i] := True;
      end
      else
      bfreqok[i] := False;
   end;}
   for i:=0 to 3 do
   bfreqok[i] := ((progresstick mod (i+1))=0);
   
   for i:=0 to 3 do
   bfreqok[i] := True;
   
   for enum:=0 to tries-1 do
   begin
      for gridy:=0 to gc_soundgrid_county-1 do
      for gridx:=0 to gc_soundgrid_countx-1 do
      begin
         if (gSoundGrid[gridx, gridy].bsndrequestexist) then
         begin
            var maxdst : Float = 40;
            var gposx, gposz : Float;
            _misc_SoundGridIndicesToPos(gridx, gridy, gposx, gposz);
            var lenx : Float = VectorLength(lx-gposx, 0, 0);
            var lenz : Float = VectorLength(0, 0, lz-gposz);
            var dst : Float = VectorDistance(0, 0, 0, lenx, 0, lenz);
            var m : Integer;
            {if (dst>(maxdst+lheight)) then
            begin
               for m:=gc_snd_ind_count-1 downto 0 do
               if (gSoundGrid[gridx, gridy].sndrequests[m]>0) then
               gSoundGrid[gridx, gridy].sndrequests[m] := 0;
            end
            else}
            begin
               for m:=gc_snd_ind_count-1 downto 0 do
               begin
                  if (gSoundGrid[gridx, gridy].sndrequests[m]>0) and bfreqok[gSoundLibrary[m].sndfreq] then
                  begin
                     var loudness : Float = gSoundLibrary[m].loudness*1.25;
                     if (dst>(maxdst+lheight+loudness)) then
                     gSoundGrid[gridx, gridy].sndrequests[m] := 0
                     else
                     begin
                        const rad = 4+4;
                        var maxcount : Integer;
                        var maxx, maxy : Integer = -1;
                        var i, j : Integer;
                        for i:=-rad to rad do
                        for j:=-rad to rad do
                        begin
                           var testx, testy : Integer;
                           testx := gridx+i;
                           testy := gridy+j;
                           if (i=0) and (j=0) then
                           continue;
                           if (testx<0) or (testx>=gc_soundgrid_countx) or (testy<0) or (testy>=gc_soundgrid_county) then
                           continue;
                           if (gSoundGrid[testx, testy].sndrequests[m]>maxcount) then
                           begin
                              maxcount := gSoundGrid[testx, testy].sndrequests[m];
                              maxx := testx;
                              maxy := testy;
                           end;
                        end;
                        if (maxcount>0) and ((maxx>=0) or (maxx<gc_soundgrid_countx) or (maxy>=0) or (maxy<gc_soundgrid_county)) then
                        begin
                           if (maxcount>=gSoundGrid[gridx, gridy].sndrequests[m]) then
                           begin
                              gSoundGrid[maxx, maxy].sndrequests[m] := gSoundGrid[maxx, maxy].sndrequests[m]+gSoundGrid[gridx, gridy].sndrequests[m];
                              gSoundGrid[gridx, gridy].sndrequests[m] := 0;
                           end
                           else
                           begin
                              gSoundGrid[gridx, gridy].sndrequests[m] := gSoundGrid[gridx, gridy].sndrequests[m]+gSoundGrid[maxx, maxy].sndrequests[m];
                              gSoundGrid[maxx, maxy].sndrequests[m] := 0;
                           end;
                        end;
                     end;
                  end;
               end;
            end;
         end;
      end;
   end;
   // play
   for gridy:=0 to gc_soundgrid_county-1 do
   for gridx:=0 to gc_soundgrid_countx-1 do
   begin
      if (gSoundGrid[gridx, gridy].bsndrequestexist) then
      begin
         var i, j : Integer;
         for i:=gc_snd_ind_count-1 downto 0 do
         if (gSoundGrid[gridx, gridy].sndrequests[i]>0) and bfreqok[gSoundLibrary[i].sndfreq] then
         begin
            //_misc_ProfilerBegin('s2');
            var posx, posy, posz : Float;
            _misc_SoundGridIndicesToPos(gridx, gridy, posx, posz);
            var emitterHnd : Integer = GetOrCreateSoundEmitterInPos(posx, posz);
            //var emitterHnd : Integer = GetOrCreateSoundEmitter;
            var sndlibind : Integer = i;
            
            var bgroup : Boolean;
            var c : Integer = gSoundGrid[gridx, gridy].sndrequests[i];
            for j:=gSoundLibrary[sndlibind].groupscount-1 downto 0 do
            begin
               if (gSoundLibrary[sndlibind].groups[j].maxcount>0) and (c>=gSoundLibrary[sndlibind].groups[j].mincount) and (c<=gSoundLibrary[sndlibind].groups[j].maxcount) then
               begin
                  bgroup := True;
                  sndlibind := gSoundLibrary[sndlibind].groups[j].sndind;
                  break;
               end;
            end;
            
            var sndtag : Integer = _sound_EmitterPlaySound(emitterHnd, gc_sndlib_ind_units, sndlibind, False);
            gSoundGrid[gridx, gridy].sndrequests[i] := 0;
            
            // log
            gint_dbg_logsoundcount := gint_dbg_logsoundcount+1;
            if False then
            begin
               var sndHnd : Integer = SndGetOrCreateSound(sndtag, 'units', emitterHnd);
               var sndName : String = GetSndSoundSourceName(sndHnd);
               if sndName<>'' then
               begin
                  if (bgroup) then
                  TimeLog('posx='+FloatToStr(round(posx))+' posz='+FloatToStr(round(posz))+' sndlibind='+IntToStr(sndlibind)+' count='+IntToStr(c)+' sndname='+sndName+' [group]')
                  else
                  TimeLog('posx='+FloatToStr(round(posx))+' posz='+FloatToStr(round(posz))+' sndlibind='+IntToStr(sndlibind)+' count='+IntToStr(c)+' sndname='+sndName);
               end;
            end;
         end;
      end;
      gSoundGrid[gridx, gridy].bsndrequestexist := False;
   end;
   //_misc_ProfilerEnd('SoundControl');
   
   gProgress.soundprogresstick := gProgress.soundprogresstick + 1;
   gProgress.soundlastprogresstime := GetGameTime;
end;

// _gui_DoProgressSound
//
procedure _gui_DoProgressSound();
begin
   if (gSoundManager.bprocess) then
   _gui_DoProgressSoundControlCounters;
   const cSoundFreq = 0.067+0.02; // 0.05
   
   // used even if sound muted
   if (Abs(GetCurrentTime-gSoundManager.lastprogresstime)>cSoundFreq) then
   begin
      gSoundManager.lastprogresstime := GetCurrentTime; // real life time
      gSoundManager.CalcFrustum;
      if (gSoundManager.bprocess) then
      begin
         _gui_DoProgressSoundControl;
         
         const cMill = 'amb_windmill';
         const cTown = 'amb_towneur';
         const cSea = 'amb_sea';
         
         var ambmill, sndmill, ambtown, sndtown, ambsea, sndsea : Integer;
         ambmill := GetSndAmbientThreadHandleByName(cMill);
         if (ambmill<>0) then
         sndmill := GetSndAmbientThreadSoundHandleByIndex(0, ambmill);
         
         ambtown := GetSndAmbientThreadHandleByName(cTown);
         if (ambmill<>0) then
         sndtown := GetSndAmbientThreadSoundHandleByIndex(0, ambtown);
         
         ambsea := GetSndAmbientThreadHandleByName(cSea);
         if (ambsea<>0) then
         sndsea := GetSndAmbientThreadSoundHandleByIndex(0, ambsea);
         
         var rx, ry, rz : Float;
         var px, py, pz : Float;
         ScreenToWorldRayCast(GetViewerWidth div 2, GetViewerHeight div 2, rx, ry, rz);
         GetCameraTargetPosition(px, py, pz);
         var dst : Float = VectorDistance(px, py, pz, rx, ry, rz);
         var dirx : Float = rx-px;
         var diry : Float = ry-py;
         var dirz : Float = rz-pz;
         VectorNormalize(dirx, diry, dirz);
         // listner pos
         var lx : Float = rx-dst*dirx*0.1;
         var ly : Float = ry-dst*diry*0.3;
         var lz : Float = rz-dst*dirz*0.1;
         var i, j : Integer;
         
         const cBaseVolumeMill = 0.3;
         const cBaseVolumeTown = 1.0;
         const maxdstmill = 60;
         const mindstmill = 20;
         const maxdsttown = 60;
         const mindsttown = 20;
         
         var vol, maxvolmill, maxvoltown, maxvolsea : Float;
         for i:=0 to gc_MaxPlayerCount-1 do
         for j:=gPlayer[i].lists.storehouses.GetCount-1 downto 0 do
         begin
            var hnd : Integer = gPlayer[i].lists.storehouses.Get(j);
            var pobj : Pointer = _unit_GetTObj(hnd);
            if (pobj<>nil) and (TObj(pobj).bbuilt) then
            begin
               var dst : Float = VectorDistance(GetGameObjectPositionXByHandle(hnd), GetGameObjectPositionYByHandle(hnd), GetGameObjectPositionZByHandle(hnd), lx, ly, lz);
               //if (dst>maxdst) then vol := 0
               //else if (dst<mindst) then vol := 1 else
               var usage : Integer = gObjProp[TObj(pobj).cid][TObj(pobj).id].usage;
               if (usage=gc_obj_usage_mill) then
               begin
                  vol := 1-((dst-mindstmill)/(maxdstmill-mindstmill));
                  vol := Clamp(vol, 0, 1);
                  maxvolmill := MaxFloat(vol, maxvolmill);
               end
               else
               if (usage=gc_obj_usage_center) then
               begin
                  vol := 1-((dst-mindsttown)/(maxdsttown-mindsttown));
                  vol := Clamp(vol, 0, 1);
                  maxvoltown := MaxFloat(vol, maxvoltown);
               end;
            end;
         end;
         //_misc_LogFloat(maxvoltown);
         SetSndAmbientThreadSoundVolume(maxvolmill*cBaseVolumeMill, sndmill);
         SetSndAmbientThreadSetPlaying(maxvolmill>0, ambmill);
         SetSndAmbientThreadSoundVolume(maxvoltown*cBaseVolumeTown, sndtown);
         SetSndAmbientThreadSetPlaying(maxvoltown>0, ambtown);
         // sea
         const cBaseVolumeSea = 0.5;
         const maxdstsea = 60;
         const mindstsea = 20;
         const cSeaBorder = 40;
         const cOptimizer = 4;
         var seafactor : Float;
         var theight : Float;
         for [MAIN]j:=(round(gSoundManager.frustumlty-cSeaBorder) div cOptimizer) to (round(gSoundManager.frustumrby+cSeaBorder) div cOptimizer) do
         for i:=(round(gSoundManager.frustumltx-cSeaBorder) div cOptimizer) to (round(gSoundManager.frustumrtx+cSeaBorder) div cOptimizer) do
         begin
            var testX : Float = i*cOptimizer;
            var testZ : Float = j*cOptimizer;
            if (RayCastWater(testX, testZ, theight)) then
            begin
               if (testX>gSoundManager.frustumltx) and (testX<gSoundManager.frustumrtx) and (testZ>gSoundManager.frustumlty) and (testZ<gSoundManager.frustumrby) then
               seafactor := seafactor+1;
               var dst : Float = VectorDistance(testX, theight, testZ, lx, ly, lz);
               vol := 1-((dst-mindstsea)/(maxdstsea-mindstsea));
               vol := Clamp(vol, 0, 1);
               maxvolsea := MaxFloat(vol, maxvolsea);
            end;
         end;
         seafactor := Clamp(seafactor/200, 0, 1);
         var curvolsea : Float = GetSndAmbientThreadSoundVolume(sndsea);
         var delta : Float = maxvolsea*cBaseVolumeSea*seafactor-curvolsea;
         const cDeltaSpeed = 0.075;
         delta := Clamp(delta, -cDeltaSpeed*2, cDeltaSpeed);
         var newvol : Float = curvolsea+delta*cBaseVolumeSea;
         SetSndAmbientThreadSoundVolume(newvol, sndsea);
         SetSndAmbientThreadSetPlaying(newvol>0.01, ambsea);
         //SetSndAmbientThreadSoundVolume(maxvolsea*cBaseVolumeSea, sndsea);
         //SetSndAmbientThreadSoundVolume(maxvolsea*cBaseVolumeSea, sndsea);
      end;
   end;
end;

// _gui_ForceShowUnitControl
//
procedure _gui_ForceShowUnitControl(bResetTimer : Boolean);
begin
   if (bResetTimer) then
   gint_gui_update_unitcontrol_progresstick := 0;
   
   gbool_gui_update_unitcontrol := True;
   GUIExecuteState('ShowUnitControl');

   //if (bResetTimer) then
   //gint_gui_update_unitcontrol_progresstick := 0;

   gbool_gui_updateprogress_unitcontrol := True;
   gbool_gui_update_unitcontrol := False;
   GUIExecuteState('ShowUnitControl');
end;

// _gui_UpdateHighlights
//
procedure _gui_UpdateHighlights(bResetTimer : Boolean);
begin
   if (bResetTimer) then
   gint_gui_update_highlights_progresstick := 0;
   
   if (gint_gui_progresstick=gint_gui_update_highlights_progresstick) then
   exit
   else
   gint_gui_update_highlights_progresstick := gint_gui_progresstick;

   const cHighlightSelected = 'selection.friend';
   const cHighlightSelectedBuilding = 'selection.building';
   const cHighlightSelectedShip = 'selection.ship';
   const cHighlightFriend = 'highlight.friend';
   const cHighlightAlly = 'highlight.ally';
   const cHighlightEnemy = 'highlight.enemy';

   var myPlHnd : Integer = GetPlayerHandleInterfaceIO;
   var myPlInd : Integer = GetPlayerIndexByHandle(myPlHnd);
   if (myPlHnd<>0) then
   begin
      var count : Integer = gGuiUpdateHighlights.GetCount;
      if (count>0) then
      begin
         var i : Integer;
         for i:=count-1 downto 0 do
         begin
            var goHnd : Integer = gGuiUpdateHighlights.Get(i);
            case _misc_GetBaseObjID(goHnd) of
               gc_baseid_obj : begin
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (pobj<>nil) and (not TObj(pobj).bdead) then
                  begin
                     var bPicked, visible : Boolean;
                     var plHnd : Integer = GetGameObjectPlayerHandleByHandle(goHnd);
                     if (myPlHnd=plHnd) and GetGameObjectPickedByHandle(goHnd) then
                     bPicked := True;
                     if (_unit_GetTagStateByType(goHnd, gc_statetag_essential)<>gc_statetag_essential_birth) then
                     visible := True;

                     var mat : String = cHighlightFriend;
                     if (bPicked) then
                     begin
                        if (gObjProp[TObj(pObj).cid][TObj(pObj).id].bbuilding) and not (gObjProp[TObj(pobj).cid][TObj(pobj).id].bwall) then
                        begin
                           visible := True;
                           var w : Integer = GetGameObjectCollisionMaskWidthByHandle(goHnd);
                           var h : Integer = GetGameObjectCollisionMaskHeightByHandle(goHnd);
                           var cmaxh, cmaxw : Integer;
                           var cminh, cminw : Integer = gc_MaxInt;
                           var x, y : Integer;
                           for x := 0 to h-1 do
                           for y := 0 to w-1 do
                           if GetGameObjectCollisionMaskValueByHandle(goHnd, x, y) then
                           begin
                              cminw := Min(cminw, x);
                              cminh := Min(cminh, y);
                              cmaxw := Max(cmaxw, x);
                              cmaxh := Max(cmaxh, y);
                           end;
                           var cw : Integer = cmaxw-cminw+1;
                           var ch : Integer = cmaxh-cminh+1;
                           var mid : Integer = ((cw+ch) div 2);
                           var size : Integer;
                           if (mid>2) then
                           begin
                              if (mid<5) then
                              size := 0
                              else
                              if (mid<8) then
                              size := 1
                              else
                              if (mid<12) then
                              size := 2
                              else
                              size := 3;
                              mat := cHighlightSelectedBuilding+'.'+IntToStr(size);
                           end
                           else
                           visible := False;
                        end
                        else
                        {if (gObjProp[TObj(pObj).cid][TObj(pObj).id].media=gc_obj_media_water) then
                        begin
                           var size : Integer = 0;
                           mat := cHighlightSelectedShip+'.'+IntToStr(size);
                        end
                        else}
                        mat := cHighlightSelected
                     end
                     else
                     if (TObj(pObj).cid=gc_country_ind_mis) then
                     visible := False
                     else
                     if (myPlHnd=plHnd) then
                     mat := cHighlightFriend
                     else
                     begin
                        if ((gPlayer[TObj(pobj).pl].myplmask and gPlayer[myPlInd].enemyplmask)<>0) then
                        mat := cHighlightEnemy
                        else
                        mat := cHighlightAlly;
                     end;
                     if (gProfile.bDbgNoBrushes) then
                     visible := False;
                     //if (not bPicked) and (gObjProp[TObj(pobj).cid][TObj(pobj).id].bbuilding) then //bwall
                     if (gObjProp[TObj(pobj).cid][TObj(pobj).id].bwall) then //bwall
                     visible := False;
                     EffectHighlightGetOrCreate(goHnd, 'h', visible, mat);

                     _misc_UnitUpdateMiniMapPrimitive(goHnd, bPicked);
                  end;
               end;
               gc_baseid_res : begin
                  if (not gbool_gui_screenshotcamera) then
                  begin
                     var bGeology : Boolean = (gPlayer[myPlInd].bgeology);
                     var bNotInFOW : Boolean = (not GetFOWEnable) or (GetFOWLOSData(GetGameObjectPositionXByHandle(goHnd), GetGameObjectPositionZByHandle(goHnd))>0);
                     var bVisible : Boolean = bGeology or (bNotInFOW);
                     var top : Integer = _gui_GetTop;
                     var hudCollection : Integer = GetGUIElementIndexByNameParent('envhud', top);
                     if (hudCollection<>0) then
                     begin
                        var hudHnd, elmHnd : Integer;
                        var userBlend, newUserBlend : Float;
                        var bElmIsVisible : Boolean;
                        if (bVisible) and (not bNotInFOW) then
                        newUserBlend := 0.5
                        else
                        newUserBlend := 1;
                        hudHnd := GetGUIGroupHUDCollectionItemByGameObject(hudCollection, goHnd);
                        if (hudHnd<>0) then
                        elmHnd := GetGUIElementIndexByNameParent('hud_img', hudHnd);
                        if (elmHnd<>0) then
                        begin
                           bElmIsVisible := GetGUIElementVisible(elmHnd);
                           userBlend := GetGUIElementUserBlend(elmHnd);
                        end;
                        if (bVisible) then
                        begin
                           if (elmHnd=0) then
                           begin
                              IntRegister0 := goHnd;
                              GUIExecuteState('ShowHUD');
                              hudHnd := GetGUIGroupHUDCollectionItemByGameObject(hudCollection, goHnd);
                              elmHnd := GetGUIElementIndexByNameParent('hud_img', hudHnd);
                           end;
                        end;

                        if (hudHnd<>0) then
                        begin
                           var elmHnd : Integer = GetGUIElementIndexByNameParent('hud_img', hudHnd);
                           if (elmHnd<>0) then
                           begin
                              if (bVisible) and (userBlend<>newUserBlend) then
                              SetGUIElementUserBlend(elmHnd, newUserBlend);
                              if (bVisible) and (not bElmIsVisible) and (not GetGUIElementFadeStarted(elmHnd)) or (not GetGUIElementVisible(elmHnd)) then
                              begin
                                 SetGUIElementVisible(elmHnd, bVisible);
                                 _gui_FadeElement(elmHnd, 0.75, True)
                              end
                              else
                              if (not bVisible) and (bElmIsVisible) and (not GetGUIElementFadeStarted(elmHnd)) then
                              _gui_FadeElement(elmHnd, 0.5, False);
                           end;
                        end;
                     end;
                  end;
               end;
            end;

            if (GameManagerIsBrushMode) and (GetStretchBrushUseGrid) then
            for i := gPlayer[myPlInd].squads.GetCount-1 downto 0 do
            begin
               var pSquad : Pointer = gPlayer[myPlInd].squads.Get(i);
               if (pSquad<>nil) then
               begin
                  var grHnd : Integer = GetPlayerGrHandleByHandle(myPlHnd, TSquad(pSquad).fGroupName);

                  if TSquad(pSquad).fSelected and (grHnd <> 0) then
                  begin
                     var goGrid : array [0..gc_formation_maskmaxheight] of array [0..gc_formation_maskmaxwidth] of Integer;
                     var i, j : Integer;
                     for i := 0 to gc_formation_maskmaxheight-1 do
                     for j := 0 to gc_formation_maskmaxwidth-1 do
                     goGrid[i, j] := TSquad(pSquad).arGrid[i, j];

                     var x : Float = GetPlayerStretchBrushGroupTargetPositionX(grHnd);
                     var y : Float = GetPlayerStretchBrushGroupTargetPositionY(grHnd);
                     var angle : Float = GetPlayerStretchBrushGroupTargetAngle(grHnd);
                     var dirX : Float;
                     var dirY : Float;
                     var dirZ : Float = -1;
                     VectorRotateY(dirX, dirY, dirZ, angle);

                     _squad_RebuildGrid(pSquad, x, y, dirX, dirZ);
                     _group_Initialize(grHnd, pSquad);

                     for i := 0 to gc_formation_maskmaxheight-1 do
                     for j := 0 to gc_formation_maskmaxwidth-1 do
                     TSquad(pSquad).arGrid[i, j] := goGrid[i, j];
                  end;
               end
               else
               ErrorLog('GUI : DoProgress : pSquad=nil')
            end;
         end;
         gGuiUpdateHighlights.Clear;
      end;
   end;
end;
