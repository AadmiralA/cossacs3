// _gui_SetListBoxHeight
//
function _gui_SetListBoxHeight(elmList, maxcount : Integer) : Boolean;
begin
   var bNeedScroll : Boolean;
   if (elmList<>0) then
   begin
      const cMaterialScrollerDown = 'scroller.btn.down';
      var count : Integer = GetGUIListBoxItemsCount(elmList);
      if (count>maxcount) then
      begin
         bNeedScroll := True;
         count := maxcount;
      end;
      SetGUIElementAllPositionRect(elmList, GetGUIElementPositionX(elmList), GetGUIElementPositionY(elmList), GetGUIElementWidth(elmList), GetGUIListBoxRowHeight(elmList)*count);
      SetGUIElementLogicHeight(elmList, GetGUIListBoxRowHeight(elmList)*count);
      var elmScroll : Integer = GetGUIListBoxScrollerHandle(elmList);
      if (elmScroll<>0) then
      begin
         var height : Integer = GetGUIElementHeight(elmScroll)-GetGUITextureHeight(cMaterialScrollerDown);
         SetGUIElementHeight(elmScroll, height);
         SetGUIElementLogicHeight(elmScroll, height);
      end
      else
      ErrorLog('_gui_SetListBoxHeight : elmScroll=0');
   end;
   Result := bNeedScroll;
end;

// _gui_CreateComboBoxOLD
//
function _gui_CreateComboBoxOLD(const elementName : String; parent : Integer; count, minScrollCount : Integer; hAlign, vAlign : Integer; posX, posY, width : Integer; textHAlign, textVAlign : Integer; tOffX, tOffY, font : Integer; var eventState : String; bGetUpdate : Boolean) : Integer;
begin
   Result := 0;
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this ca.se we are not able to get element handle by name. elmname='+elementName);
   
   var rfont : String = gUIConst.font[font];
   if (font=gc_font_none) then
   rfont := gUIConst.font[gc_font_serif_13];
   const cListOffY = 3;
   const cScrollerMarginY = 0;
   const cMaterialLeft = 'combobox.left';
   const cMaterialMiddle = 'combobox.middle';
   const cMaterialRight = 'combobox.right';
   const cMaterialBtn = 'combobox.btn';
   const cMaterialListSelected = 'combobox.list.selected';
   const cMaterialListHover = 'combobox.list.hover';
   const cMaterialListBackground = 'combobox.list.background';
   const cMaterialScrollerTile = 'scroller.tile';
   const cMaterialScrollerUp = 'scroller.up';
   const cMaterialScrollerDown = 'scroller.down';
   const cMaterialScroller = 'scroller';
   const cBtnDummy = 'btn.dummy';
   var curind : Integer = GetGUICursorIndexByName('crPress');
   
   var iposX : Integer = posX+GetGUITextureWidth(cMaterialLeft);
   var iposY : Integer = posY;
   
   var iwidth : Integer;
   if (width<>0) then
   iwidth := width-GetGUITextureWidth(cMaterialLeft)-GetGUITextureWidth(cMaterialRight)
   else
   iwidth := 200;
   var iminScrollCount : Integer = minScrollCount;
   if (iminScrollCount=0) then
   iminScrollCount := count;
   
   var color : TColor;
   var colorhover : TColor;
   _gui_ConvertHexToTColor('EEEEEE', color);
   _gui_ConvertHexToTColor(gc_font_hex_color_white, colorhover);
   
   // - setup combobox
   if (bGetUpdate) then
   Result := GetGUIElementIndexByNameParent(elementName, parent);
   
   if (Result=0) then
   Result := AddNewElementByClassNameParent(elementName, 'TXGuiComboBox', 0, parent);
   SetGUIElementCursorByName(Result, 'crPress');
   SetGUIElementPressState(Result, eventState);
   SetGUIElementFont(Result, rfont);
   SetGUIElementColor(Result, color.r, color.g, color.b, color.a);
   SetGUIElementTextAlign(Result, gUIConst.halign[textHAlign], gUIConst.valign[textVAlign], tOffX, tOffY);
   SetGUIElementTextFormatted(Result, True);
   SetGUIElementAlign(Result, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementPosition(Result, iposX, iposY);
   SetGUIElementLogicRect(Result, iwidth, GetGUITextureHeight(cMaterialMiddle));
   SetGUIElementRect(Result, iwidth, GetGUITextureHeight(cMaterialMiddle));
   SetGUIElementMaterial(Result, cMaterialMiddle);
   
   SetGUIListBoxSelectedMaterialName(Result, cMaterialListSelected); // selected
   SetGUIListBoxRowHeight(Result, GetGUITextureHeight(cMaterialListSelected));
   SetGUIListBoxVisibleRows(Result, iminScrollCount);
   
   SetGUIListBoxMouseTrack(Result, 3); // 1 - only text change color on hover, 2 - only material appears, 3 - text and material on hover
   SetGUIListBoxMouseTrackMaterialName(Result, cMaterialListHover); // hover
   SetGUIListBoxMouseTrackFontColor(Result, colorhover.r, colorhover.g, colorhover.b, colorhover.a);
   
   {var middleMatW : Integer = GetGUITextureWidth(cMaterialMiddle);
   var side : Integer = GetGUITextureWidth(cMaterialLeft);
   var middleW : Integer = iwidth-side-side;
   if (middleW<>0) then
   begin
      var tileW : Integer = (middleW div middleMatW);
      if ((middleW mod middleMatW)>0) then tileW := tileW+1;
      var i : Integer;
      for i:=0 to tileW-1 do
      begin
         GUIElementSendToBack(_gui_CreateTileScaleImage('t_'+IntToStr(i), Result, cMaterialMiddle, gc_halParentLeft, gc_valParentTop, i*middleMatW, 0, Min(middleMatW, middleW-i*middleMatW), 0, bGetUpdate));
      end;
   end;}
   
   // - setup combobox list
   var tmpHnd : Integer = GetGUIComboBoxListBoxHandle(Result);
   SetGUIElementCursorByName(tmpHnd, 'crPress');
   SetGUIElementAlign(tmpHnd, 'halParentMiddle', 'valParentTop');
   SetGUIElementFont(tmpHnd, rfont);
   SetGUIElementColor(tmpHnd, color.r, color.g, color.b, color.a);
   SetGUIElementTextAlign(tmpHnd, gUIConst.halign[textHAlign], gUIConst.valign[textVAlign], tOffx+GetGUITextureWidth(cMaterialLeft), tOffY);
   SetGUIElementTextFormatted(tmpHnd, True);
   SetGUIElementMaterial(tmpHnd, cMaterialListBackground);
   SetGUIElementAllPositionRect(tmpHnd, 0 ,GetGUIElementHeight(Result)+cListOffY, GetGUIElementLogicWidth(Result)+GetGUITextureWidth(cMaterialLeft)*2, GetGUITextureHeight(cMaterialListSelected)*(Min(count, iminScrollCount)));
   
   // - setup scroller
   var elmVScroll : Integer = GetGUIListBoxScrollerHandle(tmpHnd);
   SetGUIElementAlign(elmVScroll, 'halParentRightWidth', 'valParentTop');
   SetGUIElementCursorByName(elmVScroll, 'crDefault');
   SetGUIAllowEvents(elmVScroll, True, False, False);
   
   SetGUIElementMaterialOffset(elmVScroll, 0, 0);
   SetGUIElementAllPositionRect(elmVScroll, 0, GetGUITextureHeight(cMaterialScrollerUp)+cScrollerMarginY, GetGUITextureWidth(cMaterialScrollerTile), GetGUIElementHeight(tmpHnd)-GetGUITextureHeight(cMaterialScrollerDown)*2-cScrollerMarginY*2);
   SetGUIElementLogicHeight(elmVScroll, GetGUIElementHeight(elmVScroll)+GetGUITextureHeight(cMaterialScrollerUp));
   
   SetGUIElementMaterial(elmVScroll, cMaterialScrollerTile);
   SetGUIScrollButtonSource(elmVScroll, 0, cBtnDummy, true); // cMaterialScrollerUp
   SetGUIScrollButtonSource(elmVScroll, 2, cBtnDummy, true); // cMaterialScrollerDown
   SetGUIScrollButtonSource(elmVScroll, 1, cBtnDummy, true); // cMaterialScroller
   
   var i : Integer;
   for i :=0 to 2 do
   begin
      var mat : String;
      case i of
         0 : mat := cMaterialScrollerUp;
         1 : mat := cMaterialScroller;
         2 : mat := cMaterialScrollerDown;
      end;
      var tmpElm : Integer = GetGUIElementScrollButtonIndex(elmVScroll, i);
      SetGUIElementAllRect(tmpElm, GetGUITextureWidth(mat), GetGUITextureHeight(mat));
      SetGUIElementVisibleProperties(tmpElm, 'UpProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'HoverProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DownProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DisableProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'CheckOnProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      case i of
         0 : begin
            SetGUIElementPositionY(tmpElm, -GetGUITextureHeight(mat));
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentTop'); // halParentLeft
         end;
         1 : begin
            SetGUIElementAlign(tmpElm, 'halParentMiddle', 'valParentTop'); // valParentTop
         end;
         2 : begin
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentBottomHeight'); // halParentLeft
         end;
      end;
   end;
   _gui_CreateImage('btn', Result, cMaterialBtn, gc_halParentRightWidth, gc_valParentMiddle, 2, 0, 0, 0, 0, True);
   _gui_CreateImage('left', Result, cMaterialLeft, gc_halParentLeft, gc_valParentTop, -GetGUITextureWidth(cMaterialLeft), 0, 0, 0, 0, True);
   _gui_CreateImage('right', Result, cMaterialRight, gc_halParentRight, gc_valParentTop, 0, 0, 0, 0, 0, True);
end;

// _gui_TileScaleElementToSize
//
procedure _gui_TileScaleElementToSize(const elmHnd : Integer; const sizeX, sizeY : Integer);
begin
   var fScaleX, fScaleY : Float = 1;
   var elmWidth, elmHeight : Integer;
   if (sizeX<>0) then
   begin
      elmWidth := GetGUIElementWidth(elmHnd);
      fScaleX := sizeX/elmWidth;
      SetGUIElementWidth(elmHnd, sizeX);
   end;
   if (sizeY<>0) then
   begin
      elmHeight := GetGUIElementHeight(elmHnd);
      fScaleY := sizeY/elmHeight;
      SetGUIElementHeight(elmHnd, sizeY);
   end;
   if (sizeX<0) then fScaleX := -fScaleX;
   if (sizeY<0) then fScaleY := -fScaleY;
   SetGUIElementTileScales(elmHnd, fScaleX, fScaleY);
end;

// _gui_CreateInputBox
//
function _gui_CreateInputBox(const inputboxid : String; parent : Integer; var text : String; halign, valign : Integer; posX, posY, width, maxlength : Integer; eventState, hint : String; enabled : Boolean; tposx, tposy, thalign, tvalign, font : Integer; r, g, b, a : Float; bGetUpdate : Boolean) : Integer;
begin
   const cMaterialLeft = 'inputbox.l';
   const cMaterialMiddle = 'inputbox.m';
   const cMaterialRight = 'inputbox.r';
   var sidel : Integer = GetGUITextureWidth(cMaterialLeft);
   var sider : Integer = GetGUITextureWidth(cMaterialRight);
   var rwidth : Integer;
   var matHeight : Integer = floor(GetGUITextureHeight(cMaterialMiddle)*1.5);
   if width=0 then
   rwidth := GetGUIElementWidth(parent)
   else
   rwidth := width;
   var elminputbox : Integer = _gui_CreateImage(inputboxid, parent, gc_gui_material_blank, halign, valign, posX, posY, rwidth, matHeight, 0, bGetUpdate);
   SetGUIElementStringTag(elminputbox, inputboxid);
   var elmHnd : Integer = _gui_CreateImage('l', elminputbox, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, 0, 0, matHeight, 0, bGetUpdate);
   var middleMatW : Integer = GetGUITextureWidth(cMaterialMiddle);
   var middleW : Integer = rwidth-sidel;
   if (middleW<>0) then
   begin
      var tileW : Integer = (middleW div middleMatW);
      if ((middleW mod middleMatW)>0) then tileW := tileW+1;
      var i : Integer;
      for i:=0 to tileW-1 do
      elmHnd := _gui_CreateTileScaleImage('t_'+IntToStr(i), elminputbox, cMaterialMiddle, gc_halParentLeft, gc_valParentTop, sidel+i*middleMatW, 0, Min(middleMatW, middleW-i*middleMatW), matHeight, bGetUpdate);
   end;
   elmHnd := _gui_CreateImage('r', elminputbox, cMaterialRight, gc_halParentLeft, gc_valParentTop, rwidth-sider, 0, 0, matHeight, 0, bGetUpdate);
   var elminputtext : Integer;
   if (bGetUpdate) then
   begin
      elminputtext := GetGUIElementIndexByNameParent('text', elminputbox);
      if elminputtext<>0 then
      begin
         var className : String = GetObjectClassNameByHandle(elminputtext);
         if ((enabled) and (not SameText(className, 'TXEditControl')))
         or ((not enabled) and (SameText(className, 'TXEditControl'))) then
         begin
            RemoveGUIElement(elminputtext);
            elminputtext := 0;
         end;
      end;
   end;
   var bInit : Boolean;
   if (elminputtext=0) then
   begin
      bInit := True;
      if (enabled) then
      elminputtext := AddNewElementByClassNameParent('text', 'TXEditControl', 0, elminputbox)
      else
      elminputtext := AddNewElementByClassNameParent('text', 'TOSWBaseGuiTextControl', 0, elminputbox);
   end;
   SetGUIElementMaxTextLength(elminputtext, maxLength);
   SetGUIElementHint(elminputtext, hint);
   SetGUIElementPressState(elminputtext, eventState);
   SetGUIElementFont(elminputtext, gUIConst.font[font]);
   SetGUIElementColor(elminputtext, 1, 1, 1, 1);
   SetGUIElementAlign(elminputtext, 'halParentLeft', 'valParentTop');
   SetGUIElementAllPositionRect(elminputtext, tposX, tposY, rwidth-tposX*2, GetGUIElementHeight(elminputbox));
   SetGUIElementTextAlign(elminputtext, gUIConst.halign[thalign], gUIConst.valign[tvalign], 0, 0);
   var prevText : String = GetGUIElementText(elminputtext);
   if (prevText<>text) or (bInit) then // need to init text := '' first time, to make text cursor start from 1 char and not from 0
   SetGUIElementText(elminputtext, text);
   SetGUIElementTextFormatted(elminputtext, True);
   //SetGUIElementCursorByIndex(elminputtext, 2);
   SetGUIElementCursorByName(elminputtext, 'crPress');
   if (not enabled) then
   begin
      SetGUIElementUserBlend(elminputbox, 0.9);
      SetGUIElementColor(elminputtext, 0.54, 0.476, 0.296, 1);
   end;
   
   Result := elminputbox;
end;

// _gui_CreateMainWindow
//
function _gui_CreateMainWindow(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, iwidth, iheight : Integer; bgalpha : Float; bGetUpdate : Boolean) : Integer;
begin
   var width, height : Integer;
   if (iwidth<457) then
   begin
      width := 457;
      ErrorLog('_gui_CreateMainWindow width<457, unsupported');
   end
   else
   width := iwidth;
   if (iheight<509) then
   begin
      height := 509;
      ErrorLog('_gui_CreateMainWindow height<509, unsupported');
   end
   else
   height := iheight;
   const bordersize = 106;
   const materialBase = 'mainframe';
   var cMaterialBackground : String = materialBase+'.background';
   var cMaterialHeader : String = materialBase+'.header';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialRight : String = materialBase+'.right';
   var cMaterialTop : String = materialBase+'.top';
   var cMaterialBottom : String = materialBase+'.bottom';
   var cMaterialCornerLT : String = materialBase+'.corner_lt';
   var cMaterialCornerRT : String = materialBase+'.corner_rt';
   var cMaterialCornerLB : String = materialBase+'.corner_lb';
   var cMaterialCornerRB : String = materialBase+'.corner_rb';
   
   // cache width
   var twBackground : Integer = GetGUITextureWidth(cMaterialBackground);
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twRight : Integer = GetGUITextureWidth(cMaterialRight);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   var twBottom : Integer = GetGUITextureWidth(cMaterialBottom);
   
   // cache height
   var thBackground : Integer = GetGUITextureHeight(cMaterialBackground);
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thRight : Integer = GetGUITextureHeight(cMaterialRight);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   var thBottom : Integer = GetGUITextureHeight(cMaterialBottom);
   
   // cache width
   var twCornerLT : Integer = GetGUITextureWidth(cMaterialCornerLT);
   var twCornerRT : Integer = GetGUITextureWidth(cMaterialCornerRT);
   var twCornerLB : Integer = GetGUITextureWidth(cMaterialCornerLB);
   var twCornerRB : Integer = GetGUITextureWidth(cMaterialCornerRB);
   
   // cache height
   var thCornerLT : Integer = GetGUITextureHeight(cMaterialCornerLT);
   var thCornerRT : Integer = GetGUITextureHeight(cMaterialCornerRT);
   var thCornerLB : Integer = GetGUITextureHeight(cMaterialCornerLB);
   var thCornerRB : Integer = GetGUITextureHeight(cMaterialCornerRB);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmWindowHnd : Integer = _gui_CreateParent(elementName, iparent, hAlign, vAlign, posX, posY, iwidth, iheight, bGetUpdate);
   var elmBgHnd : Integer = _gui_CreateImage('bg', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmLHnd : Integer = _gui_CreateImage('l', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize+1, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmRHnd : Integer = _gui_CreateImage('r', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmTHnd : Integer = _gui_CreateImage('t', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmBHnd : Integer = _gui_CreateImage('b', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, bordersize-1, iwidth, iheight, 0, bGetUpdate);
   var elmBackgroundHnd : Integer = _gui_CreateImage('background', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmHeaderHnd : Integer = _gui_CreateImage('head', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   SetGUIElementUserBlend(elmBgHnd, bgalpha);
   SetGUIElementVisible(elmHeaderHnd, width>845);
   
   var backgroundWidth : Integer = iwidth;
   var backgroundHeight : Integer = iheight;
   var tileW, tileH : Integer;
   tileW := (backgroundWidth div twBackground);
   if ((backgroundWidth mod twBackground)>0) then tileW := tileW+1;
   tileH := (backgroundHeight div thBackground);
   if ((backgroundHeight mod thBackground)>0) then tileH := tileH+1;
   var i : Integer;
   for i:=0 to tileW-1 do
   begin
      var tmpX, tmpY : Float;
      var fscaleX : Float = 1;
      var fscaleY : Float = 1;
      var j : Integer;
      for j:=0 to tileH-1 do
      begin
         var elmHnd : Integer = _gui_CreateTileScaleImage('bg_'+IntToStr(i)+'_'+IntToStr(j), elmBgHnd, cMaterialBackground, gc_halParentLeft, gc_valParentTop, i*twBackground, j*thBackground, Min(backgroundWidth-i*twBackground, twBackground), Min(backgroundHeight-j*thBackground, thBackground), bGetUpdate);
         var elmwidth : Integer = twBackground;
         if (iwidth<>0) and (iwidth<(elmwidth+i*twBackground)) then
         fscaleX := (iwidth-i*twBackground)/elmwidth;
         var elmheight : Integer = thBackground;
         if (iheight<>0) and (iheight<(elmheight*(iheight div backgroundHeight)+j*thBackground)) then
         fscaleY := (iheight-j*thBackground)/(elmheight*(iheight div backgroundHeight));
         if (iwidth<0) then fscaleX := -fscaleX;
         if (iheight<0) then fscaleY := -fscaleY;
         SetGUIElementTileScales(elmHnd, fscaleX, fscaleY);
      end;
   end;
   SetGUIElementAllPositionRect(elmBackgroundHnd, 0, 0, iwidth, iheight);
   
   var tmpwidth : Integer = (iwidth-twCornerLT-twCornerRT+bordersize*2);
   var tmpheight : Integer = (iheight-thCornerLT-thCornerRB+bordersize*2);
   tileW := (tmpwidth div twTop);
   if ((tmpwidth mod twTop)>0) then tileW := tileW+1;
   tileH := (tmpheight div thLeft);
   if ((tmpheight mod thLeft)>0) then tileH := tileH+1;
   for i:=0 to tileH-1 do
   begin
      _gui_CreateTileScaleImage('l_'+IntToStr(i), elmLHnd, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, thCornerLT+i*thLeft, 0, Min(thLeft, tmpheight-i*thLeft), bGetUpdate);
      _gui_CreateTileScaleImage('r_'+IntToStr(i), elmRHnd, cMaterialRight, gc_halParentRightWidth, gc_valParentTop, 0, thCornerRT+i*thRight, 0, Min(thRight, +tmpheight-i*thRight), bGetUpdate);
   end;
   for i:=0 to tileW-1 do
   begin
      _gui_CreateTileScaleImage('t_'+IntToStr(i), elmTHnd, cMaterialTop, gc_halParentLeft, gc_valParentTop, twCornerLT+i*twTop, 0, Min(twTop, tmpwidth-i*twTop), 0, bGetUpdate);
      _gui_CreateTileScaleImage('b_'+IntToStr(i), elmBHnd, cMaterialBottom, gc_halParentLeft, gc_valParentBottomHeight, twCornerLB+i*twTop, 0, Min(twBottom, tmpwidth-i*twBottom), 0, bGetUpdate);
   end;
   if (iheight>0) then
   begin
      _gui_CreateImage('clt', elmBackgroundHnd, cMaterialCornerLT, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, 0, 0, 0, bGetUpdate);
      _gui_CreateImage('clb', elmBackgroundHnd, cMaterialCornerLB, gc_halParentLeft, gc_valParentBottomHeight, -bordersize, bordersize, 0, 0, 0, bGetUpdate);
   end;
   if (iwidth>0) then
   begin
      _gui_CreateImage('crt', elmBackgroundHnd, cMaterialCornerRT, gc_halParentRightWidth, gc_valParentTop, bordersize, -bordersize, 0, 0, 0, bGetUpdate);
      _gui_CreateImage('crb', elmBackgroundHnd, cMaterialCornerRB, gc_halParentRightWidth, gc_valParentBottomHeight, bordersize, bordersize, 0, 0, 0, bGetUpdate);
   end;
   //_gui_CreateImage('head', elmHeaderHnd, cMaterialHeader, gc_halParentMiddle, gc_valParentTop, 0, GetGUITextureHeight(cMaterialHeader)-4, 0, -GetGUITextureHeight(cMaterialHeader), 0, bGetUpdate);
   _gui_CreateImage('head', elmHeaderHnd, cMaterialHeader, gc_halParentMiddle, gc_valParentTop, 0, -25, 0, 0, 0, bGetUpdate);
   
   Result := elmWindowHnd;
end;

// _gui_CreateSkinWindow
//
function _gui_CreateSkinWindow(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; bgalpha : Float; bGetUpdate : Boolean) : Integer;
begin
   const bordersize = 0;
   const materialBase = 'skin';
   var cMaterialBackground : String = materialBase+'.background';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialRight : String = materialBase+'.right';
   var cMaterialTop : String = materialBase+'.top';
   var cMaterialBottom : String = materialBase+'.bottom';
   var cMaterialCornerLT : String = materialBase+'.corner_lt';
   var cMaterialCornerRT : String = materialBase+'.corner_rt';
   var cMaterialCornerLB : String = materialBase+'.corner_lb';
   var cMaterialCornerRB : String = materialBase+'.corner_rb';
   
   // cache width
   var twBackground : Integer = GetGUITextureWidth(cMaterialBackground);
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twRight : Integer = GetGUITextureWidth(cMaterialRight);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   var twBottom : Integer = GetGUITextureWidth(cMaterialBottom);
   
   // cache height
   var thBackground : Integer = GetGUITextureHeight(cMaterialBackground);
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thRight : Integer = GetGUITextureHeight(cMaterialRight);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   var thBottom : Integer = GetGUITextureHeight(cMaterialBottom);
   
   // cache width
   var twCornerLT : Integer = GetGUITextureWidth(cMaterialCornerLT);
   var twCornerRT : Integer = GetGUITextureWidth(cMaterialCornerRT);
   var twCornerLB : Integer = GetGUITextureWidth(cMaterialCornerLB);
   var twCornerRB : Integer = GetGUITextureWidth(cMaterialCornerRB);
   
   // cache height
   var thCornerLT : Integer = GetGUITextureHeight(cMaterialCornerLT);
   var thCornerRT : Integer = GetGUITextureHeight(cMaterialCornerRT);
   var thCornerLB : Integer = GetGUITextureHeight(cMaterialCornerLB);
   var thCornerRB : Integer = GetGUITextureHeight(cMaterialCornerRB);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmWindowHnd : Integer = _gui_CreateParent(elementName, iparent, hAlign, vAlign, posX, posY, iwidth, iheight, bGetUpdate);
   var elmBgHnd : Integer = _gui_CreateImage('bg', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmLHnd : Integer = _gui_CreateImage('l', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmRHnd : Integer = _gui_CreateImage('r', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmTHnd : Integer = _gui_CreateImage('t', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmBHnd : Integer = _gui_CreateImage('b', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmBackgroundHnd : Integer = _gui_CreateImage('background', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmHeaderHnd : Integer = _gui_CreateImage('head', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   SetGUIElementUserBlend(elmBgHnd, bgalpha);
   
   var backgroundWidth : Integer = iwidth;
   var backgroundHeight : Integer = iheight;
   var tileW, tileH : Integer;
   tileW := (backgroundWidth div twBackground);
   if ((backgroundWidth mod twBackground)>0) then tileW := tileW+1;
   tileH := (backgroundHeight div thBackground);
   if ((backgroundHeight mod thBackground)>0) then tileH := tileH+1;
   var i : Integer;
   for i:=0 to tileW-1 do
   begin
      var tmpX, tmpY : Float;
      var fscaleX : Float = 1;
      var fscaleY : Float = 1;
      var j : Integer;
      for j:=0 to tileH-1 do
      begin
         var elmHnd : Integer = _gui_CreateTileScaleImage('bg_'+IntToStr(i)+'_'+IntToStr(j), elmBgHnd, cMaterialBackground, gc_halParentLeft, gc_valParentTop, i*twBackground, j*thBackground, Min(backgroundWidth-i*twBackground, twBackground), Min(backgroundHeight-j*thBackground, thBackground), bGetUpdate);
         var elmwidth : Integer = twBackground;
         if (iwidth<>0) and (iwidth<(elmwidth+i*twBackground)) then
         fscaleX := (iwidth-i*twBackground)/elmwidth;
         var elmheight : Integer = thBackground;
         if (iheight<>0) and (iheight<(elmheight*(iheight div backgroundHeight)+j*thBackground)) then
         fscaleY := (iheight-j*thBackground)/(elmheight*(iheight div backgroundHeight));
         if (iwidth<0) then fscaleX := -fscaleX;
         if (iheight<0) then fscaleY := -fscaleY;
         SetGUIElementTileScales(elmHnd, fscaleX, fscaleY);
      end;
   end;
   SetGUIElementAllPositionRect(elmBackgroundHnd, 0, 0, iwidth, iheight);
   
   var tmpwidth : Integer = (iwidth-twCornerLT-twCornerRT+bordersize*2);
   var tmpheight : Integer = (iheight-thCornerLT-thCornerRB+bordersize*2);
   tileW := (tmpwidth div twTop);
   if ((tmpwidth mod twTop)>0) then tileW := tileW+1;
   tileH := (tmpheight div thLeft);
   if ((tmpheight mod thLeft)>0) then tileH := tileH+1;
   for i:=0 to tileH-1 do
   begin
      _gui_CreateTileScaleImage('l_'+IntToStr(i), elmLHnd, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, thCornerLT+i*thLeft, 0, Min(thLeft, tmpheight-i*thLeft), bGetUpdate);
      _gui_CreateTileScaleImage('r_'+IntToStr(i), elmRHnd, cMaterialRight, gc_halParentRightWidth, gc_valParentTop, 0, thCornerRT+i*thRight, 0, Min(thRight, +tmpheight-i*thRight), bGetUpdate);
   end;
   for i:=0 to tileW-1 do
   begin
      _gui_CreateTileScaleImage('t_'+IntToStr(i), elmTHnd, cMaterialTop, gc_halParentLeft, gc_valParentTop, twCornerLT+i*twTop, 0, Min(twTop, tmpwidth-i*twTop), 0, bGetUpdate);
      _gui_CreateTileScaleImage('b_'+IntToStr(i), elmBHnd, cMaterialBottom, gc_halParentLeft, gc_valParentBottomHeight, twCornerLB+i*twTop, 0, Min(twBottom, tmpwidth-i*twBottom), 0, bGetUpdate);
   end;
   if (iheight>0) then
   begin
      _gui_CreateTileScaleImage('clt', elmBackgroundHnd, cMaterialCornerLT, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, min(twCornerLT, iwidth), 0, bGetUpdate);
      _gui_CreateTileScaleImage('clb', elmBackgroundHnd, cMaterialCornerLB, gc_halParentLeft, gc_valParentBottomHeight, -bordersize, bordersize, min(twCornerLT, iwidth), 0, bGetUpdate);
   end;
   if (iwidth>0) then
   begin
      _gui_CreateTileScaleImage('crt', elmBackgroundHnd, cMaterialCornerRT, gc_halParentRightWidth, gc_valParentTop, bordersize, -bordersize, min(twCornerRT, iwidth), 0, bGetUpdate);
      _gui_CreateTileScaleImage('crb', elmBackgroundHnd, cMaterialCornerRB, gc_halParentRightWidth, gc_valParentBottomHeight, bordersize, bordersize, min(twCornerRT, iwidth), 0, bGetUpdate);
   end;
   
   Result := elmWindowHnd;
end;

// _gui_CreateSkinHeadWindow
//
function _gui_CreateSkinHeadWindow(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width : Integer; bGetUpdate : Boolean) : Integer;
begin
   Result := _gui_CreateTileScaleImage(elementName+'_shl', parent, 'skin.header.l', hAlign, vAlign, posx, posy, width, 0, bGetUpdate);
   _gui_CreateTileScaleImage(elementName+'_shr', Result, 'skin.header.r', gc_halParentRight, gc_valParentTop, -GetGUITextureWidth('skin.header.r'), 0, 0, 0, bGetUpdate);
end;

// _gui_CreatePaperWindow
//
function _gui_CreatePaperWindow(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; bgalpha : Float; bShowBlick : Boolean; bGetUpdate : Boolean) : Integer;
begin
   if (width>946) then
   ErrorLog('_gui_CreatePaperWindow unsupported size iwidth>946');
   const bordersize = 0;
   const borderoverlap = 24;
   const materialBase = 'paper';
   var cMaterialBackground : String = materialBase+'.background';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialRight : String = materialBase+'.right';
   var cMaterialTop : String = materialBase+'.top';
   var cMaterialBottom : String = materialBase+'.bottom';
   var cMaterialCornerLT : String = materialBase+'.corner_lt';
   var cMaterialCornerRT : String = materialBase+'.corner_rt';
   var cMaterialCornerLB : String = materialBase+'.corner_lb';
   var cMaterialCornerRB : String = materialBase+'.corner_rb';
   var cMaterialBlick : String = materialBase+'.background.blick';
   
   // cache width
   var twBackground : Integer = GetGUITextureWidth(cMaterialBackground);
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twRight : Integer = GetGUITextureWidth(cMaterialRight);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   var twBottom : Integer = GetGUITextureWidth(cMaterialBottom);
   
   // cache height
   var thBackground : Integer = GetGUITextureHeight(cMaterialBackground);
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thRight : Integer = GetGUITextureHeight(cMaterialRight);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   var thBottom : Integer = GetGUITextureHeight(cMaterialBottom);
   
   // cache width
   var twCornerLT : Integer = GetGUITextureWidth(cMaterialCornerLT);
   var twCornerRT : Integer = GetGUITextureWidth(cMaterialCornerRT);
   var twCornerLB : Integer = GetGUITextureWidth(cMaterialCornerLB);
   var twCornerRB : Integer = GetGUITextureWidth(cMaterialCornerRB);
   
   // cache height
   var thCornerLT : Integer = GetGUITextureHeight(cMaterialCornerLT);
   var thCornerRT : Integer = GetGUITextureHeight(cMaterialCornerRT);
   var thCornerLB : Integer = GetGUITextureHeight(cMaterialCornerLB);
   var thCornerRB : Integer = GetGUITextureHeight(cMaterialCornerRB);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmWindowHnd : Integer = _gui_CreateParent(elementName, iparent, hAlign, vAlign, posX, posY, iwidth, iheight, bGetUpdate);
   var elmBgHnd : Integer = _gui_CreateImage('bg', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmLHnd : Integer = _gui_CreateImage('l', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmRHnd : Integer = _gui_CreateImage('r', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmTHnd : Integer = _gui_CreateImage('t', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmBHnd : Integer = _gui_CreateImage('b', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmBackgroundHnd : Integer = _gui_CreateImage('background', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmBlickHnd : Integer = _gui_CreateImage('blick', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   //var elmHeaderHnd : Integer = _gui_CreateImage('head', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   
   var backgroundWidth : Integer = iwidth-borderoverlap*2;
   var backgroundHeight : Integer = iheight-borderoverlap*2;
   var tileW, tileH : Integer;
   tileW := (backgroundWidth div twBackground);
   if ((backgroundWidth mod twBackground)>0) then tileW := tileW+1;
   tileH := (backgroundHeight div thBackground);
   if ((backgroundHeight mod thBackground)>0) then tileH := tileH+1;
   var i : Integer;
   for i:=0 to tileW-1 do
   begin
      var tmpX, tmpY : Float;
      var fscaleX : Float = 1;
      var fscaleY : Float = 1;
      var j : Integer;
      for j:=0 to tileH-1 do
      begin
         var elmHnd : Integer = _gui_CreateTileScaleImage('bg_'+IntToStr(i)+'_'+IntToStr(j), elmBgHnd, cMaterialBackground, gc_halParentLeft, gc_valParentTop, borderoverlap+i*twBackground, borderoverlap+j*thBackground, Min(twBackground, (backgroundWidth-i*twBackground)), Min(thBackground, (backgroundHeight-j*thBackground)), bGetUpdate);
         var elmwidth : Integer = twBackground;
         if (iwidth<>0) and (iwidth<(elmwidth+i*twBackground)) then
         fscaleX := (iwidth-i*twBackground)/elmwidth;
         var elmheight : Integer = thBackground;
         if (iheight<>0) and (iheight<(elmheight*(iheight div backgroundHeight)+j*thBackground)) then
         fscaleY := (iheight-j*thBackground)/(elmheight*(iheight div backgroundHeight));
         if (iwidth<0) then fscaleX := -fscaleX;
         if (iheight<0) then fscaleY := -fscaleY;
         SetGUIElementTileScales(elmHnd, fscaleX, fscaleY);
      end;
   end;
   SetGUIElementAllPositionRect(elmBackgroundHnd, 0, 0, iwidth, iheight);
   
   var tmpwidth : Integer = (iwidth-twCornerLT-twCornerRT+bordersize*2+borderoverlap*2);
   var tmpheight : Integer = (iheight-thCornerLT-thCornerRB+bordersize*2+borderoverlap*2);
   tileW := (tmpwidth div twTop);
   if ((tmpwidth mod twTop)>0) then tileW := tileW+1;
   tileH := (tmpheight div thLeft);
   if ((tmpheight mod thLeft)>0) then tileH := tileH+1;
   for i:=0 to tileH-1 do
   begin
      _gui_CreateTileScaleImage('l_'+IntToStr(i), elmLHnd, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, thCornerLT+i*thLeft-borderoverlap, 0, Min(thLeft, tmpheight-i*thLeft), bGetUpdate);
      _gui_CreateTileScaleImage('r_'+IntToStr(i), elmRHnd, cMaterialRight, gc_halParentRightWidth, gc_valParentTop, 0, thCornerRT+i*thRight-borderoverlap, 0, Min(thRight, +tmpheight-i*thRight), bGetUpdate);
   end;
   for i:=0 to tileW-1 do
   begin
      _gui_CreateTileScaleImage('t_'+IntToStr(i), elmTHnd, cMaterialTop, gc_halParentLeft, gc_valParentTop, twCornerLT+i*twTop-borderoverlap, 0, Min(twTop, tmpwidth-i*twTop), 0, bGetUpdate);
      _gui_CreateTileScaleImage('b_'+IntToStr(i), elmBHnd, cMaterialBottom, gc_halParentLeft, gc_valParentBottomHeight, twCornerLB+i*twTop-borderoverlap, 0, Min(twBottom, tmpwidth-i*twBottom), 0, bGetUpdate);
   end;
   if (iheight>0) then
   begin
      _gui_CreateTileScaleImage('clt', elmBackgroundHnd, cMaterialCornerLT, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, min(twCornerLT, iwidth), 0, bGetUpdate);
      _gui_CreateTileScaleImage('clb', elmBackgroundHnd, cMaterialCornerLB, gc_halParentLeft, gc_valParentBottomHeight, -bordersize, bordersize, min(twCornerLT, iwidth), 0, bGetUpdate);
   end;
   if (iwidth>0) then
   begin
      _gui_CreateTileScaleImage('crt', elmBackgroundHnd, cMaterialCornerRT, gc_halParentRightWidth, gc_valParentTop, bordersize, -bordersize, min(twCornerRT, iwidth), 0, bGetUpdate);
      _gui_CreateTileScaleImage('crb', elmBackgroundHnd, cMaterialCornerRB, gc_halParentRightWidth, gc_valParentBottomHeight, bordersize, bordersize, min(twCornerRT, iwidth), 0, bGetUpdate);
   end;
   if (bShowBlick) then
   begin
      //_gui_CreateTileScaleImage('bli', elmBlickHnd, cMaterialBlick, gc_halParentLeft, gc_valParentTop, dbgx, dbgz, dbgy, dbgy, bGetUpdate);
      var elmHnd : Integer = _gui_CreateImage('bli', elmBlickHnd, cMaterialBlick, gc_halParentLeft, gc_valParentTop, twCornerLT-borderoverlap*2, thCornerLT-borderoverlap*2, Min(GetGUITextureWidth(cMaterialBlick), Min(tmpwidth, tmpheight)), Min(GetGUITextureWidth(cMaterialBlick), Min(tmpwidth, tmpheight)), 0, bGetUpdate);
      SetGUIElementUserBlend(elmHnd, bgalpha);
   end;
   Result := elmWindowHnd;
end;

// _gui_CreateMetalLine
//
function _gui_CreateMetalLine(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; blefttop, bGetUpdate : Boolean) : Integer;
begin
   Result := 0;
   
   const materialBase = 'metalframe';
   var cMaterialTop : String = materialBase+'.top';
   var cMaterialBottom : String = materialBase+'.bottom';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialRight : String = materialBase+'.right';
   
   // cache width
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   
   // cache height
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmHnd : Integer;
   var i : Integer;
   if (iwidth<>0) then
   begin
      var tileW : Integer = (iwidth div twTop);
      if ((iwidth mod twTop)>0) then tileW := tileW+1;
      for i:=0 to tileW-1 do
      if (blefttop) then
      elmHnd := _gui_CreateTileScaleImage(elementName+'t_'+IntToStr(i), parent, cMaterialTop, hAlign, vAlign, posx+i*twTop, posy, Min(twTop, iwidth-i*twTop), 0, bGetUpdate)
      else
      elmHnd := _gui_CreateTileScaleImage(elementName+'b_'+IntToStr(i), parent, cMaterialBottom, hAlign, vAlign, posx+i*twTop, posy, Min(twTop, iwidth-i*twTop), 0, bGetUpdate);
      if (Result=0) then
      Result := elmHnd;
   end
   else
   begin
      var tileH : Integer = (iheight div thLeft);
      if ((iheight mod thLeft)>0) then tileH := tileH+1;
      for i:=0 to tileH-1 do
      if (blefttop) then
      elmHnd := _gui_CreateTileScaleImage(elementName+'l_'+IntToStr(i), parent, cMaterialLeft, hAlign, vAlign, posx, posy+i*thLeft, 0, Min(thLeft, iheight-i*thLeft), bGetUpdate)
      else
      elmHnd := _gui_CreateTileScaleImage(elementName+'r_'+IntToStr(i), parent, cMaterialRight, hAlign, vAlign, posx, posy+i*thLeft, 0, Min(thLeft, iheight-i*thLeft), bGetUpdate);
      if (Result=0) then
      Result := elmHnd;
   end;
end;

// _gui_CreateFrameLine
//
function _gui_CreateFrameLine(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; bGetUpdate : Boolean) : Integer;
begin
   const materialBase = 'frame';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialTop : String = materialBase+'.top';
   
   // cache width
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   
   // cache height
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmHnd : Integer;
   if (iwidth<>0) then
   begin
      var tileW : Integer = (iwidth div twTop);
      if ((iwidth mod twTop)>0) then tileW := tileW+1;
      var i : Integer;
      for i:=0 to tileW-1 do
      elmHnd := _gui_CreateTileScaleImage('t_'+IntToStr(i), parent, cMaterialTop, hAlign, vAlign, posx+i*twTop, posy, Min(twTop, iwidth-i*twTop), 0, bGetUpdate);
   end
   else
   begin
      var tileH : Integer = (iheight div thLeft);
      if ((iheight mod thLeft)>0) then tileH := tileH+1;
      var i : Integer;
      for i:=0 to tileH-1 do
      elmHnd := _gui_CreateTileScaleImage('l_'+IntToStr(i), parent, cMaterialLeft, hAlign, vAlign, posx, posy+i*thLeft, 0, Min(thLeft, iheight-i*thLeft), bGetUpdate);
   end;
   
   Result := elmHnd;
end;

// _gui_CreateFrameWindow
//
function _gui_CreateFrameWindow(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height, bordersize : Integer; bgalpha : Float; bGetUpdate : Boolean) : Integer;
begin
   const materialBase = 'frame';
   var cMaterialBackground : String = materialBase+'.background';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialRight : String = materialBase+'.right';
   var cMaterialTop : String = materialBase+'.top';
   var cMaterialBottom : String = materialBase+'.bottom';
   var cMaterialCornerLT : String = materialBase+'.corner_lt';
   var cMaterialCornerRT : String = materialBase+'.corner_rt';
   var cMaterialCornerLB : String = materialBase+'.corner_lb';
   var cMaterialCornerRB : String = materialBase+'.corner_rb';
   
   // cache width
   var twBackground : Integer = GetGUITextureWidth(cMaterialBackground);
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twRight : Integer = GetGUITextureWidth(cMaterialRight);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   var twBottom : Integer = GetGUITextureWidth(cMaterialBottom);
   
   // cache height
   var thBackground : Integer = GetGUITextureHeight(cMaterialBackground);
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thRight : Integer = GetGUITextureHeight(cMaterialRight);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   var thBottom : Integer = GetGUITextureHeight(cMaterialBottom);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmWindowHnd : Integer = _gui_CreateParent(elementName, iparent, hAlign, vAlign, posX, posY, iwidth, iheight, bGetUpdate);
   var elmBackgroundHnd : Integer = _gui_CreateImage('background', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmBgHnd : Integer = _gui_CreateImage('bg', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth+bordersize*2, iheight+bordersize*2, 0, bGetUpdate);
   var elmLHnd : Integer = _gui_CreateImage('l', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmRHnd : Integer = _gui_CreateImage('r', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmTHnd : Integer = _gui_CreateImage('t', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, iwidth, iheight, 0, bGetUpdate);
   var elmBHnd : Integer = _gui_CreateImage('b', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, -bordersize, bordersize, iwidth, iheight, 0, bGetUpdate);
   //SetGUIElementUserBlend(elmWindowHnd, bgalpha);
   SetGUIElementUserBlend(elmBgHnd, bgalpha);
   
   var i : Integer;
   var backgroundWidth : Integer = iwidth-twLeft-twRight+bordersize*2;
   var backgroundHeight : Integer = iheight-thTop-thBottom+bordersize*2;
   var tileW, tileH : Integer;
   tileW := (backgroundWidth div twBackground);
   if ((backgroundWidth mod twBackground)>0) then tileW := tileW+1;
   tileH := (backgroundHeight div thBackground);
   if ((backgroundHeight mod thBackground)>0) then tileH := tileH+1;
   for i:=0 to tileW-1 do
   begin
      var tmpX, tmpY : Float;
      var fscaleX : Float = 1;
      var fscaleY : Float = 1;
      var j : Integer;
      for j:=0 to tileH-1 do
      begin
         var elmHnd : Integer = _gui_CreateTileScaleImage('bg_'+IntToStr(i)+'_'+IntToStr(j), elmBgHnd, cMaterialBackground, gc_halParentLeft, gc_valParentTop, twLeft+i*twBackground, thTop+j*thBackground, Min(backgroundWidth-i*twBackground, twBackground), Min(backgroundHeight-j*thBackground, thBackground), bGetUpdate);
         var elmwidth : Integer = twBackground;
         if (iwidth<>0) and (iwidth<(elmwidth+i*twBackground)) then
         fscaleX := (iwidth-i*twBackground)/elmwidth;
         var elmheight : Integer = thBackground;
         if (iheight<>0) and (iheight<(elmheight*(iheight div backgroundHeight)+j*thBackground)) then
         fscaleY := (iheight-j*thBackground)/(elmheight*(iheight div backgroundHeight));
         if (iwidth<0) then fscaleX := -fscaleX;
         if (iheight<0) then fscaleY := -fscaleY;
         SetGUIElementTileScales(elmHnd, fscaleX, fscaleY);
      end;
   end;
   SetGUIElementAllPositionRect(elmBackgroundHnd, 0, 0, iwidth, iheight);
   
   var tmpwidth : Integer = (iwidth-twLeft-twRight+bordersize*2);
   var tmpheight : Integer = (iheight-thTop-thBottom+bordersize*2);
   tileW := (tmpwidth div twTop);
   if ((tmpwidth mod twTop)>0) then tileW := tileW+1;
   tileH := (tmpheight div thLeft);
   if ((tmpheight mod thLeft)>0) then tileH := tileH+1;
   for i:=0 to tileH-1 do
   begin
      _gui_CreateTileScaleImage('l_'+IntToStr(i), elmLHnd, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, thTop+i*thLeft, 0, Min(thLeft, tmpheight-i*thLeft), bGetUpdate);
      _gui_CreateTileScaleImage('r_'+IntToStr(i), elmRHnd, cMaterialRight, gc_halParentRightWidth, gc_valParentTop, 0, thTop+i*thRight, 0, Min(thRight, +tmpheight-i*thRight), bGetUpdate);
   end;
   for i:=0 to tileW-1 do
   begin
      _gui_CreateTileScaleImage('t_'+IntToStr(i), elmTHnd, cMaterialTop, gc_halParentLeft, gc_valParentTop, twLeft+i*twTop, 0, Min(twTop, tmpwidth-i*twTop), 0, bGetUpdate);
      _gui_CreateTileScaleImage('b_'+IntToStr(i), elmBHnd, cMaterialBottom, gc_halParentLeft, gc_valParentBottomHeight, twLeft+i*twTop, 0, Min(twBottom, tmpwidth-i*twBottom), 0, bGetUpdate);
   end;
   if (iheight>0) then
   begin
      _gui_CreateImage('clt', elmBackgroundHnd, cMaterialCornerLT, gc_halParentLeft, gc_valParentTop, -bordersize, -bordersize, 0, 0, 0, bGetUpdate);
      _gui_CreateImage('clb', elmBackgroundHnd, cMaterialCornerLB, gc_halParentLeft, gc_valParentBottomHeight, -bordersize, bordersize, 0, 0, 0, bGetUpdate);
   end;
   if (iwidth>0) then
   begin
      _gui_CreateImage('crt', elmBackgroundHnd, cMaterialCornerRT, gc_halParentRightWidth, gc_valParentTop, bordersize, -bordersize, 0, 0, 0, bGetUpdate);
      _gui_CreateImage('crb', elmBackgroundHnd, cMaterialCornerRB, gc_halParentRightWidth, gc_valParentBottomHeight, bordersize, bordersize, 0, 0, 0, bGetUpdate);
   end;
   
   Result := elmWindowHnd;
end;

// _gui_CreateWindowByTemplate
//
function _gui_CreateWindowByTemplate(const elementName : String; parent : Integer; const materialBase : String; hAlign, vAlign : Integer; posX, posY, width, height : Integer; alpha : Float; bGradientWidth, bGradientHeight, bGetUpdate : Boolean) : Integer;
begin
   var cMaterialBackground : String = materialBase+'.background';
   var cMaterialLeft : String = materialBase+'.left';
   var cMaterialRight : String = materialBase+'.right';
   var cMaterialTop : String = materialBase+'.top';
   var cMaterialBottom : String = materialBase+'.bottom';
   var cMaterialCornerLT : String = materialBase+'.corner_lt';
   var cMaterialCornerRT : String = materialBase+'.corner_rt';
   var cMaterialCornerLB : String = materialBase+'.corner_lb';
   var cMaterialCornerRB : String = materialBase+'.corner_rb';
   
   // cache width
   var twBackground : Integer = GetGUITextureWidth(cMaterialBackground);
   var twLeft : Integer = GetGUITextureWidth(cMaterialLeft);
   var twRight : Integer = GetGUITextureWidth(cMaterialRight);
   var twTop : Integer = GetGUITextureWidth(cMaterialTop);
   var twBottom : Integer = GetGUITextureWidth(cMaterialBottom);
   
   // cache height
   var thBackground : Integer = GetGUITextureHeight(cMaterialBackground);
   var thLeft : Integer = GetGUITextureHeight(cMaterialLeft);
   var thRight : Integer = GetGUITextureHeight(cMaterialRight);
   var thTop : Integer = GetGUITextureHeight(cMaterialTop);
   var thBottom : Integer = GetGUITextureHeight(cMaterialBottom);
   
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this cas.e we are not able to get element handle by name. elmname='+elementName);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var elmWindowHnd : Integer = _gui_CreateParent(elementName, iparent, hAlign, vAlign, posX, posY, iwidth, iheight, bGetUpdate);
   var elmBackgroundHnd : Integer = _gui_CreateImage('background', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmBgHnd : Integer = _gui_CreateImage('bg', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmLHnd : Integer = _gui_CreateImage('l', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmRHnd : Integer = _gui_CreateImage('r', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmTHnd : Integer = _gui_CreateImage('t', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   var elmBHnd : Integer = _gui_CreateImage('b', elmWindowHnd, gc_gui_material_blank, gc_halParentLeft, gc_valParentTop, 0, 0, iwidth, iheight, 0, bGetUpdate);
   SetGUIElementUserBlend(elmWindowHnd, alpha);
   
   var i : Integer;
   var backgroundWidth : Integer = iwidth-twLeft-twRight;
   var backgroundHeight : Integer = iheight-thTop-thBottom;
   var tileW, tileH : Integer;
   tileW := (backgroundWidth div twBackground);
   if ((backgroundWidth mod twBackground)>0) then tileW := tileW+1;
   tileH := (backgroundHeight div thBackground);
   if ((backgroundHeight mod thBackground)>0) then tileH := tileH+1;
   for i:=0 to tileW-1 do
   begin
      var tmpX, tmpY : Float;
      var fscaleX : Float = 1;
      var fscaleY : Float = 1;
      var j : Integer;
      for j:=0 to tileH-1 do
      begin
         var elmHnd : Integer = _gui_CreateTileScaleImage('bg_'+IntToStr(i)+'_'+IntToStr(j), elmBgHnd, cMaterialBackground, gc_halParentLeft, gc_valParentTop, twLeft+i*twBackground, thTop+j*thBackground, Min(backgroundWidth-i*twBackground, twBackground), Min(backgroundHeight-j*thBackground, thBackground), bGetUpdate);
         var elmwidth : Integer = twBackground;
         if (iwidth<>0) and (iwidth<elmwidth) then
         fscaleX := iwidth/elmwidth;
         var elmheight : Integer = thBackground;
         if (iheight<>0) and (iheight<(elmheight*(iheight div backgroundHeight))) then
         fscaleY := iheight/(elmheight*(iheight div backgroundHeight));
         if (iwidth<0) then fscaleX := -fscaleX;
         if (iheight<0) then fscaleY := -fscaleY;
         if (bGradientWidth) then fscaleX := 1;
         if (bGradientHeight) then fscaleY := 1;
         SetGUIElementTileScales(elmHnd, fscaleX, fscaleY);
      end;
   end;
   SetGUIElementAllPositionRect(elmBackgroundHnd, 0, 0, iwidth, iheight);
   
   var tmpwidth : Integer = (iwidth-twLeft-twRight);
   var tmpheight : Integer = (iheight-thTop-thBottom);
   if (twTop<>0) and (thLeft<>0) then
   begin
      tileW := (tmpwidth div twTop);
      if ((tmpwidth mod twTop)>0) then tileW := tileW+1;
      tileH := (tmpheight div thLeft);
      if ((tmpheight mod thLeft)>0) then tileH := tileH+1;
      for i:=0 to tileH-1 do
      begin
         if (bGradientHeight) then
         begin
            _gui_CreateImage('l_'+IntToStr(i), elmLHnd, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, thTop+i*thLeft, 0, Min(thLeft, tmpheight-i*thLeft), 0, bGetUpdate);
            _gui_CreateImage('r_'+IntToStr(i), elmRHnd, cMaterialRight, gc_halParentRightWidth, gc_valParentTop, 0, thTop+i*thRight, 0, Min(thRight, +tmpheight-i*thRight), 0, bGetUpdate);
         end
         else
         begin
            _gui_CreateTileScaleImage('l_'+IntToStr(i), elmLHnd, cMaterialLeft, gc_halParentLeft, gc_valParentTop, 0, thTop+i*thLeft, 0, Min(thLeft, tmpheight-i*thLeft), bGetUpdate);
            _gui_CreateTileScaleImage('r_'+IntToStr(i), elmRHnd, cMaterialRight, gc_halParentRightWidth, gc_valParentTop, 0, thTop+i*thRight, 0, Min(thRight, +tmpheight-i*thRight), bGetUpdate);
         end;
      end;
      for i:=0 to tileW-1 do
      begin
         if (bGradientWidth) then
         begin
            _gui_CreateImage('t_'+IntToStr(i), elmTHnd, cMaterialTop, gc_halParentLeft, gc_valParentTop, twLeft+i*twTop, 0, Min(twTop, tmpwidth-i*twTop), 0, 0, bGetUpdate);
            _gui_CreateImage('b_'+IntToStr(i), elmBHnd, cMaterialBottom, gc_halParentLeft, gc_valParentBottomHeight, twLeft+i*twTop, 0, Min(twBottom, tmpwidth-i*twBottom), 0, 0, bGetUpdate);
         end
         else
         begin
            _gui_CreateTileScaleImage('t_'+IntToStr(i), elmTHnd, cMaterialTop, gc_halParentLeft, gc_valParentTop, twLeft+i*twTop, 0, Min(twTop, tmpwidth-i*twTop), 0, bGetUpdate);
            _gui_CreateTileScaleImage('b_'+IntToStr(i), elmBHnd, cMaterialBottom, gc_halParentLeft, gc_valParentBottomHeight, twLeft+i*twTop, 0, Min(twBottom, tmpwidth-i*twBottom), 0, bGetUpdate);
         end;
      end;
   end;
   if (iheight>0) then
   begin
      _gui_CreateImage('clt', elmBackgroundHnd, cMaterialCornerLT, gc_halParentLeft, gc_valParentTop, 0, 0, 0, 0, 0, bGetUpdate);
      _gui_CreateImage('clb', elmBackgroundHnd, cMaterialCornerLB, gc_halParentLeft, gc_valParentBottomHeight, 0, 0, 0, 0, 0, bGetUpdate);
   end;
   if (iwidth>0) then
   begin
      _gui_CreateImage('crt', elmBackgroundHnd, cMaterialCornerRT, gc_halParentRightWidth, gc_valParentTop, 0, 0, 0, 0, 0, bGetUpdate);
      _gui_CreateImage('crb', elmBackgroundHnd, cMaterialCornerRB, gc_halParentRightWidth, gc_valParentBottomHeight, 0, 0, 0, 0, 0, bGetUpdate);
   end;
   
   Result := elmWindowHnd;
end;

// _gui_GetGUIElementVisibleInherited
//
function _gui_GetGUIElementVisibleInherited(const elmHnd : Integer) : Boolean;
begin
   Result := True;
   if (not GetGUIElementVisible(elmHnd)) then
   begin
      Result := False;
      exit;
   end;
   var top : Integer = _gui_GetTop;
   var parent : Integer = elmHnd;
   var i : Integer;
   for i:=0 to 15 do
   begin
      var tmpHnd : Integer = GetGUIElementParentByIndex(parent);
      if (tmpHnd<>0) then
      begin
         if (tmpHnd=top) then
         exit;
         if (not GetGUIElementVisible(tmpHnd)) then
         begin
            Result := False;
            exit;
         end;
         parent := tmpHnd;
      end;
   end;
end;

// _gui_SetGUIElementVisibleByName
//
function _gui_SetGUIElementVisibleByName(const elmname : String; bVisible : Boolean) : Boolean;
begin
   Result := False;
   var elmHnd : Integer = GetGUIElementIndexByNameParent(elmname, _gui_GetTop);
   if (elmHnd<>0) and (GetGUIElementVisible(elmHnd)<>bVisible) then
   begin
      SetGUIElementVisible(elmHnd, bVisible);
      Result := True;
   end;
end;

// _gui_SetGUIElementEnabledByName
//
function _gui_SetGUIElementEnabledByName(const elmname : String; bEnabled : Boolean) : Boolean;
begin
   Result := False;
   var elmHnd : Integer = GetGUIElementIndexByNameParent(elmname, _gui_GetTop);
   if (elmHnd<>0) and (GetGUIElementEnabled(elmHnd)<>bEnabled) then
   begin
      SetGUIElementEnabled(elmHnd, bEnabled);
      Result := True;
   end;
end;

// _gui_GetProgressBarWidthHeight
//
procedure _gui_GetProgressBarWidthHeight(var width, height : Integer);
begin
   var viewerheight : Integer = GetViewerHeight;
   if (viewerheight<850) then
   begin
      height := 768;
      width := 1440;
   end
   else
   if (viewerheight<950) then
   begin
      height := 900;
      width := 1687;
   end
   else
   begin
      height := 1024;
      width := 1920;
   end;
end;

// _gui_ProcessProgressBar
//
procedure _gui_ProcessProgressBar(const customtext : String; const curval, maxval : Integer; bdoprocessmessages : Boolean);
begin
   var barHnd : Integer = GetGUIProgressBarElementHandle;
   var prevtext : String;
   var bUpdate : Boolean = True;
   RemoveGUIChildren(barHnd);
   
   var w : Integer = GetViewerWidth;
   var h : Integer = GetViewerHeight;
   var xArt : Integer;
   
   const cMinYArt = 902;
   var yArt : Integer;
   if (h<cMinYArt) then
   yArt := (cMinYArt-h) div 2;

   var backgroundwidth, backgroundheight : Integer;
   _gui_GetProgressBarWidthHeight(backgroundwidth, backgroundheight);
   var elmBackground : Integer = _gui_CreateImage('background', barHnd, 'progressbar'+IntToStr(gint_gui_progressbar_picnum), gc_halMiddle, gc_valMiddle, 0, 0, backgroundwidth, backgroundheight, 0, bupdate);
   _gui_AbsScaleByDPI(barHnd);
   var elmTextBackground : Integer = _gui_CreateImage('paper_background', elmBackground, 'header.paper.large', gc_halParentMiddle, gc_valBottomHeight, 0, -120, round(GetGUITextureWidth('header.paper.large')*1.25), round(GetGUITextureHeight('header.paper.large')*1.25), 0, bupdate);
   
   var color : TColor;
   color.r := 0.2;
   color.g := 0.1;
   color.b := 0.1;
   color.a := 1;
   var text : String;
   if (customtext='') and (maxval<=0) then
   text := GetLocaleTableListItemByID('gui', 'progress.pleasewait')
   else
   if (curval>maxval) then
   text := '100%'
   else
   if (maxval>0) then
   text := IntToStr(floor(100*curval/maxval))+'%';
   if (customtext<>'') then
   text := customtext+gc_gui_breakline+text;
   var elmHnd : Integer = GetGUIElementIndexByNameParent('txt', barHnd);
   if (elmHnd<>0) then
   prevtext := GetGUIElementText(elmHnd);
   if (prevtext<>text) then
   begin
      var twidth : Integer = _gui_GetFontTextWidth(text, gc_font_serif_15);
      var theight : Integer = _gui_GetFontTextHeight(text,gc_font_serif_15);
      elmHnd := _gui_CreateText('txt', elmTextBackground, text, gc_halParentMiddle, gc_valParentMiddle, 0, -7, twidth, theight, gc_halMiddle, gc_valMiddle, gc_font_serif_15, color, bUpdate);
   end;
   SetGUIElementVisible(barHnd, True);
   SetGUICursorByName('crWait');
   ViewerBufferRender;
   if (bdoprocessmessages) then
   ApplicationProcessMessages;
   SetGUICursorByName('crWait');
end;

