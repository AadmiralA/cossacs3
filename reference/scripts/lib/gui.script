//
// gui.script
//

// _gui_GetTop
//
function _gui_GetTop() : Integer;
begin
   Result := GetGUIElementTopIndexByName(gc_gui_element_top);
   if (Result=0) then
   begin
      Result := AddNewElementTopByClassName(gc_gui_element_top, 'TOSWImageGuiControl', 0);
      SetGUIElementAlign(Result, 'halLeft', 'valTop');
      SetGUIElementAllPositionRect(Result, 0, 0, GetViewerWidth, GetViewerHeight);
      SetGUIElementMaterial(Result, gc_gui_material_blank);
   end;
end;

// _gui_SendTagToState
//
procedure _gui_SendTagToState(const state : String; tag : Integer);
begin
   SetGUIValue('Status', 'button');
   SetGUIValue('Press', 'c');
   SetGUIIntValue('Tag', tag);
   GUIExecuteState(state);
end;

// _gui_SendTagToStateExt
//
procedure _gui_SendTagToStateExt(const state : String; tag : Integer; const press, key, status : String; elmHnd : Integer);
begin
   if (status<>'') then SetValueByName('Status', status);
   if (press='') then SetValueByName('Press', 'c')
   else SetValueByName('Press', press);
   SetIntValueByName('Tag', tag);
   if (key<>'') then SetValueByName('Key', key);
   if (elmHnd<>0) then SetIntValueByName('ElementHandle', elmHnd);
   GUIExecuteState(state);
end;

// _gui_GetFontTextWidth
//
function _gui_GetFontTextWidth(var text : String; font : Integer) : Integer;
begin
   var w, h : Integer;
   GetGUIElementFontTextFormatRect(gUIConst.font[font], text, w, h);
   Result := w;
end;

// _gui_GetFontTextHeight
//
function _gui_GetFontTextHeight(var text : String; font : Integer) : Integer;
begin
   var w, h : Integer;
   GetGUIElementFontTextFormatRect(gUIConst.font[font], text, w, h);
   Result := h;
end;

// _gui_GetRightPos
//
function _gui_GetRightPos(elmHnd : Integer) : Integer;
begin
   Result := 0;
   if elmHnd<>0 then
   Result := GetGUIElementPositionX(elmHnd)+GetGUIElementWidth(elmHnd);
end;

// _gui_GetBottomPos
//
function _gui_GetBottomPos(elmHnd : Integer) : Integer;
begin
   Result := 0;
   if elmHnd<>0 then
   Result := GetGUIElementPositionY(elmHnd)+GetGUIElementHeight(elmHnd);
end;

// _gui_ConvertIntColorToFloat
//
function _gui_ConvertIntColorToFloat(val : Integer) : Float;
begin
   Result := val/255;
end;

// _gui_SetupTColorInteger
//
procedure _gui_SetupTColorInteger(const r, g, b, a : Integer; const brightness : Float; var color : TColor);
begin
   color.r := _gui_ConvertIntColorToFloat(r)*brightness;
   color.g := _gui_ConvertIntColorToFloat(g)*brightness;
   color.b := _gui_ConvertIntColorToFloat(b)*brightness;
   color.a := _gui_ConvertIntColorToFloat(a)*brightness;
end;

// _gui_SetupTColorFloat
//
procedure _gui_SetupTColorFloat(const r, g, b, a : Float; var color : TColor);
begin
   color.r := r;
   color.g := g;
   color.b := b;
   color.a := a;
end;

// _gui_ConvertHexToTColor
//
procedure _gui_ConvertHexToTColor(const hex : String; var color : TColor);
begin
   if (StrLength(hex)=8) then
   FormatHexToColor4(hex, color.r, color.g, color.b, color.a)
   else
   begin
      color.a := 1;
      FormatHexToColor3(hex, color.r, color.g, color.b);
   end;
end;

// _gui_ConvertTColorToTextColor
//
procedure _gui_ConvertTColorToTextColor(color : TColor; var textcolor : String);
begin
   textcolor := '%color('+FormatColorToHex4(color.r, color.g, color.b, color.a)+')%';
end;

// _gui_GetMaterialWidthHeight
//
procedure _gui_CheckMaterialWidthHeight(const material : String; var width, height : Integer);
begin
   if (material<>gc_gui_material_blank) then
   begin
      if (width=0) then width := GetGUITextureWidth(material);
      if (height=0) then height := GetGUITextureHeight(material);
      if (width=0) and (height=0) then
      ErrorLog('_gui_CheckMaterialWidthHeight unknown material = '+material);
   end;
end;

// _gui_GetAbsScaleByDPI
//
function _gui_GetAbsScaleByDPI(x, y : Integer) : Float;
begin
   // dpi based
   {var cBaseDPI : Integer = round(96/gfloat_gui_interfacescale);
   var dpi : Integer = GetMonitorDPIFromPoint(x, y);
   if dpi=0 then
   begin
      dpi := GetWindowMonitorDPI;
      if dpi=0 then
      begin
         dpi := GetPrimaryMonitorDPI;
         if dpi=0 then
         dpi := cBaseDPI;
      end;
   end;
   Result := dpi/cBaseDPI;}
   
   // resolution based
   if GetViewerHeight>1535 then
   Result := 2
   else
   Result := 1;
end;

// _gui_AbsScaleByDPI
//
function _gui_AbsScaleByDPI(elm : Integer) : Float;
begin
   var x, y : Integer;
   GUIInvalidateParentPositions(elm);
   GetGUIElementAlignPosition(elm, x, y);
   Result := _gui_GetAbsScaleByDPI(x, y);
   if (Result=1) then
   begin
      if (GetGUIElementAbsScaled(elm)) then
      begin
         if (GetGUIElementScaleX(elm)<>Result) or (GetGUIElementScaleY(elm)<>Result) then
         SetGUIElementScale(elm, 1, 1);
         SetGUIElementAbsScaled(elm, False);
      end;
      exit;
   end;
   if (not GetGUIElementAbsScaled(elm)) then
   SetGUIElementAbsScaled(elm, True);
   if (GetGUIElementScaleX(elm)<>Result) or (GetGUIElementScaleY(elm)<>Result) then
   SetGUIElementScale(elm, Result, Result);
end;

// _gui_SetAbsScale
//
function _gui_SetAbsScale(elm : Integer; scale : Float) : Float;
begin
   if (scale=1) then
   begin
      if (GetGUIElementAbsScaled(elm)) then
      begin
         if (GetGUIElementScaleX(elm)<>Result) or (GetGUIElementScaleY(elm)<>Result) then
         SetGUIElementScale(elm, 1, 1);
         SetGUIElementAbsScaled(elm, False);
      end;
      exit;
   end;
   if (not GetGUIElementAbsScaled(elm)) then
   SetGUIElementAbsScaled(elm, True);
   if (GetGUIElementScaleX(elm)<>Result) or (GetGUIElementScaleY(elm)<>Result) then
   SetGUIElementScale(elm, scale, scale);
end;

// _gui_CreateImage
//
function _gui_CreateImage(const elementName : String; parent : Integer; const material : String; hAlign, vAlign : Integer; posX, posY, width, height, tag : Integer; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this ca.se we are not able to get element handle by name. elmname='+elementName);
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   var smaterial : String = material;
   if (smaterial='') then smaterial := gc_gui_material_blank;
   var iwidth : Integer = width;
   var iheight : Integer = height;
   _gui_CheckMaterialWidthHeight(smaterial, iwidth, iheight);
   var elmHnd : Integer;
   if (bGetUpdate) then
   elmHnd := GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmHnd=0) then
   elmHnd := AddNewElementByClassNameParent(elementName, 'TOSWImageGuiControl', tag, iparent);
   SetGUIElementTag(elmHnd, tag);
   SetGUIElementAlign(elmHnd, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementMaterial(elmHnd, smaterial);
   SetGUIElementAllPositionRect(elmHnd, posX, posY, iwidth, iheight);
   SetGUIAllowEvents(elmHnd, False, False, False);
   Result := elmHnd;
end;

// _gui_CreateImageActive
//
function _gui_CreateImageActive(const elementName : String; parent : Integer; const material : String; hAlign, vAlign : Integer; posX, posY, width, height, tag : Integer; const eventState, hint : String; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this case_ we are not able to get element handle by name. elmname='+elementName);
   const cBtnName = 'btn.dummy';
   const cCursorActive = 2;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   var smaterial : String = material;
   if (smaterial='') then smaterial := gc_gui_material_blank;
   var iwidth : Integer = width;
   var iheight : Integer = height;
   _gui_CheckMaterialWidthHeight(smaterial, iwidth, iheight);
   var curind : Integer = -1;
   
   var elmHnd : Integer;
   if (bGetUpdate) then
   elmHnd := GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmHnd=0) then
   elmHnd := AddNewElementParent(cBtnName, elementName, tag, iparent);
   SetGUIElementTag(elmHnd, tag);
   SetGUIElementAllPositionRect(elmHnd, posX, posY, iwidth, iheight);
   SetGUIElementAlign(elmHnd, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementLogicPositionRect(elmHnd, posX, posY, iwidth, iheight);
   SetGUIElementHoverEnabled(elmHnd, true);
   SetGUIElementEnabled(elmHnd, true);
   SetGUIElementHint(elmHnd, hint);
   if (eventState<>'') or (hint<>'') then
   SetGUIAllowEvents(elmHnd, True, False, False);
   if (eventState<>'') then
   begin
      SetGUIElementPressState(elmHnd, eventState);
      curind := cCursorActive;
   end;
   SetGUIElementVisibleProperties(elmHnd, 'UpProperty', smaterial, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
   SetGUIElementVisibleProperties(elmHnd, 'HoverProperty', smaterial, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
   SetGUIElementVisibleProperties(elmHnd, 'DownProperty', smaterial, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
   SetGUIElementVisibleProperties(elmHnd, 'DisableProperty', smaterial, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
   SetGUIElementVisibleProperties(elmHnd, 'CheckOnProperty', smaterial, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
   Result := elmHnd;
end;

// _gui_CreateText
//
function _gui_CreateText(const elementName : String; parent : Integer; var text : String; hAlign, vAlign : Integer; posX, posY, width, height : Integer; texthAlign, textvAlign, font : Integer; color : TColor; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this case_ we are not able to get element handle by name. elmname='+elementName);
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   var tmpText : String;
   _misc_StringToText(text, tmpText);
   var iwidth : Integer = width;
   var iheight : Integer = height;
   if (iwidth=0) or (iheight=0) then
   begin
      var tmpWidth : Integer;
      var tmpHeight : Integer;
      GetGUIElementFontTextFormatRect(gUIConst.font[font], tmpText, tmpWidth, tmpHeight);
      if (iWidth=0) then iwidth := tmpWidth;
      if (iHeight=0) then iheight := tmpHeight;
   end;
   var elmHnd : Integer;
   if (bGetUpdate) then
   elmHnd := GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmHnd=0) then
   elmHnd := AddNewElementByClassNameParent(elementName, 'TOSWBaseGuiTextControl', 0, iparent);
   //var scale : Float = _gui_AbsScaleByDPI(elmHnd);
   SetGUIElementFont(elmHnd, gUIConst.font[font]);
   var fontheight : Integer = GetGUIElementFontHeight(gUIConst.font[font]);
   SetGUIElementTextAlign(elmHnd, gUIConst.halign[texthAlign], gUIConst.valign[textvAlign], 0, 0); //textYOff
   SetGUIElementColor(elmHnd, color.r, color.g, color.b, color.a);
   SetGUIElementAlign(elmHnd, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementText(elmHnd, tmpText);
   SetGUIElementTextFormatted(elmHnd, True);
   SetGUIElementAllPositionRect(elmHnd, posX, posY, iwidth, iheight);
   Result := elmHnd;
end;

// _gui_GetTextShadowElement
//
function _gui_GetTextShadowElement(elmText : Integer) : Integer;
begin
   var elmParent : Integer = GetGUIElementParentByIndex(elmText);
   var elmName : String = GetGUIElementNameByIndex(elmText)+'_shadow';
   Result := GetGUIElementIndexByNameParent(elmName, elmParent);
end;

// _gui_HighlightTextHotkey
//
procedure _gui_HighlightTextHotkey(var textin, eventstate : String; const btnname : String; var textout : String; bAddToEndIfNotFound : Boolean);
begin
   var hotkey : String = GetRegisterGUIShortcut('event|'+eventstate+'|'+btnname);
   if (hotkey<>'') then
   begin
      var pos : Integer = StrPos(hotkey, textin);
      if (pos>0) then
      begin
         var s0 : String = SubStr(textin, 1, pos-1);
         var s1 : String = SubStr(textin, pos, 1);
         var s2 : String = SubStr(textin, pos+1, StrLength(textin)-pos);
         var fontcolor : String = '%color(F0E0C0)%'; //gc_font_color_orange
         textout := s0+fontcolor+s1+gc_font_color_default+s2;
      end
      else
      if (bAddToEndIfNotFound) then
      textout := textin+' ('+hotkey+')';
   end;
end;

// _gui_CreateTextShadowed
//
function _gui_CreateTextShadowed(const elementName : String; parent : Integer; var text : String; hAlign, vAlign : Integer; posX, posY, width, height : Integer; texthAlign, textvAlign, font : Integer; color : TColor; xOff, yOff : Integer; shadowcolor : TColor; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this case_ we are not able to get element handle by name. elmname='+elementName);
   var tmpText : String;
   _misc_StringToText(text, tmpText);
   var shwElementName : String = elementName;
   if (elementName<>'') then
   shwElementName := elementName+'_shadow';
   //var shadowcolor : TColor;
   
   {if (StrLength(hexshadowcolor)=8) then
   FormatHexToColor4(hexshadowcolor, shadowcolor.r, shadowcolor.g, shadowcolor.b, shadowcolor.a)
   else
   begin
      shadowcolor.a := 1;
      FormatHexToColor3(hexshadowcolor, shadowcolor.r, shadowcolor.g, shadowcolor.b);
   end;}
   //_gui_ConvertHexToTColor(hexshadowcolor, shadowcolor);
   var justtext : String = FormatGetJustTextWithoutTags(tmpText, 'color');
   var shwHnd : Integer = _gui_CreateText(shwElementName, parent, justtext hAlign, vAlign, posX+xOff, posY+yOff, width, height, texthAlign, textvAlign, font, shadowcolor, bGetUpdate);
   var elmHnd : Integer = _gui_CreateText(elementName, parent, tmpText, hAlign, vAlign, posX, posY, width, height, texthAlign, textvAlign, font, color, bGetUpdate);
   _gui_AbsScaleByDPI(parent);
   Result := elmHnd;
end;

// _gui_CreateTextShadow
//
function _gui_CreateTextShadow(textHnd : Integer; xOff, yOff : Integer; texthalign, textvalign : Integer; textxoff, textyoff : Integer; shadowcolor : TColor) : Integer;
begin
   var iparent : Integer = GetGUIElementParentByIndex(textHnd);
   var elementName : String = GetGUIElementNameByIndex(textHnd);
   elementName := elementName+'_shadow';
   var justtext : String = FormatGetJustTextWithoutTags(GetGUIElementText(textHnd), 'color');
   var elmHnd : Integer = _gui_CreateText(elementName, iparent, justtext, gUIConst.GetHAlignIndexByName(GetGUIElementHAlign(textHnd)), gUIConst.GetHAlignIndexByName(GetGUIElementVAlign(textHnd)), GetGUIElementPositionX(textHnd)+xOff, GetGUIElementPositionY(textHnd)+yOff, GetGUIElementWidth(textHnd), GetGUIElementHeight(textHnd), texthAlign, textvAlign, gUIConst.GetFontIndexByName(GetGUIElementFont(textHnd)), shadowcolor, True);
   Result := elmHnd;
end;

// _gui_CreateButton
//
function _gui_CreateButton(const elementName : String; parent : Integer; const material : String; hAlign, vAlign : Integer; posX, posY, width, height : Integer; var eventState, hint : String; tag : Integer; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this case_ we are not able to get element handle by name. elmname='+elementName);
   const cBtnName = 'btn.dummy';
   const cCursorActive = 2;
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   var smaterial : String = material;
   if (smaterial='') then smaterial := gc_gui_material_blank;
   var iwidth : Integer = width;
   var iheight : Integer = height;
   if (smaterial<>gc_gui_material_blank) then
   _gui_CheckMaterialWidthHeight(smaterial+'.normal', iwidth, iheight);
   var elmHnd : Integer;
   if (bGetUpdate) then
   elmHnd := GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmHnd=0) then
   elmHnd := AddNewElementParent(cBtnName, elementName, tag, iparent);
   SetGUIElementTag(elmHnd, tag);
   SetGUIElementAllPositionRect(elmHnd, posX, posY, iwidth, iheight);
   SetGUIElementAlign(elmHnd, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementLogicPositionRect(elmHnd, posX, posY, iwidth, iheight);
   if (eventState<>'') then
   begin
      SetGUIAllowEvents(elmHnd, True, False, False);
      SetGUIElementPressState(elmHnd, eventState);
   end;
   SetGUIElementHoverEnabled(elmHnd, true);
   SetGUIElementEnabled(elmHnd, true);
   SetGUIElementHint(elmHnd, hint);
   if (GetGUITextureWidth(material+'.normal')=0) then
   begin
      SetGUIElementVisibleProperties(elmHnd, 'UpProperty', material, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'HoverProperty', material, 0, 0, 0, 0, cCursorActive, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'DownProperty', material, 0, 0, 0, 0, cCursorActive, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'DisableProperty', material, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'CheckOnProperty', material, 0, 0, 0, 0, cCursorActive, 0.5, 0.5, 0.5, 1);
   end
   else
   begin
      SetGUIElementVisibleProperties(elmHnd, 'UpProperty', material+'.normal', 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'HoverProperty', material+'.hover', 0, 0, 0, 0, cCursorActive, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'DownProperty', material+'.pressed', 0, 0, 0, 0, cCursorActive, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'DisableProperty', material+'.disabled', 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(elmHnd, 'CheckOnProperty', material+'.checked', 0, 0, 0, 0, cCursorActive, 0.5, 0.5, 0.5, 1);
   end;
   Result := elmHnd;
end;

// _gui_CreateParent
//
function _gui_CreateParent(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this case_ we are not able to get element handle by name. elmname='+elementName);
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   var elmHnd : Integer = GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmHnd=0) then
   elmHnd := _gui_CreateImage(elementName, iparent, gc_gui_material_blank, hAlign, vAlign, posX, posY, width, height, 0, bGetUpdate)
   else
   begin
      if (not bGetUpdate) then
      RemoveGUIChildren(elmHnd);
      SetGUIElementAlign(elmHnd, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
      SetGUIElementAllPositionRect(elmHnd, posX, posY, width, height);
   end;
   SetGUIElementVisible(elmHnd, True);
   Result := elmHnd;
end;

// _gui_CreateTileScaleImage
//
function _gui_CreateTileScaleImage(const elementName : String; parent : Integer; const material : String; hAlign, vAlign : Integer; posX, posY : Integer; width, height : Integer; bGetUpdate : Boolean) : Integer;
begin
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this case_ we are not able to get element handle by name. elmname='+elementName);
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   var elmHnd : Integer;
   if (bGetUpdate) then
   elmHnd := GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmHnd=0) then
   elmHnd := AddNewElementByClassNameParent(elementName, 'TOSWImageGuiControl', 0, iparent);
   SetGUIElementAlign(elmHnd, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementMaterial(elmHnd, material);
   SetGUIAllowEvents(elmHnd, False, False, False);
   
   var iwidth : Integer = width;
   var iheight : Integer = height;
   var elmwidth : Integer = GetGUITextureWidth(material);
   var fscaleX, fscaleY : Float = 1;
   if (iwidth<>0) {and (iwidth<elmwidth)} then
   fscaleX := iwidth/elmwidth
   else
   iwidth := elmwidth;
   var elmheight : Integer = GetGUITextureHeight(material);
   if (iheight<>0) {and (iheight<elmheight)} then
   fscaleY := iheight/elmheight
   else
   iheight := elmheight;
   if (fscaleX>1) then fscaleX := 1;
   if (fscaleY>1) then fscaleY := 1;
   if (iwidth<0) then fscaleX := -fscaleX;
   if (iheight<0) then fscaleY := -fscaleY;
   
   SetGUIElementTileScales(elmHnd, fscaleX, fscaleY);
   SetGUIElementAllPositionRect(elmHnd, posX, posY, iwidth, iheight);
   Result := elmHnd;
end;

// _gui_FadeElement
//
procedure _gui_FadeElement(elmHnd : Integer; fadeTime : Float; fadeIn : Boolean);
begin
   SetGUIElementFadeAutoDestroy(elmHnd, not fadeIn);
   SetGUIElementFadeInEnabled(elmHnd, fadeIn);
   SetGUIElementFadeOutEnabled(elmHnd, not fadeIn);
   SetGUIElementFreezeEnabled(elmHnd, False);
   SetGUIElementFadingTimes(elmHnd, fadeTime, 0);
   SetGUIElementFadeStart(elmHnd, True);
   if (not fadeIn) then
   SetGUIAllowEvents(elmHnd, False, False, False);
end;

// _gui_FadeElementExt
//
procedure _gui_FadeElementExt(elmHnd : Integer; fadeTime, freezeTime : Float; fadeIn, fadeOut : Boolean);
begin
   SetGUIElementVisible(elmHnd, True);
   SetGUIElementFadeAutoDestroy(elmHnd, fadeOut);
   SetGUIElementFadeInEnabled(elmHnd, fadeIn);
   SetGUIElementFadeOutEnabled(elmHnd, fadeOut);
   SetGUIElementFreezeEnabled(elmHnd, (freezeTime>0));
   SetGUIElementFadingTimes(elmHnd, fadeTime, freezeTime);
   SetGUIElementFadeStart(elmHnd, True);
   if (not fadeIn) then
   SetGUIAllowEvents(elmHnd, False, False, False);
end;

// _gui_PreloadTextures
//
procedure _gui_PreloadTextures(top : Integer);
begin
   procedure PreloadFonts(elmPreload : Integer);
   begin
      var color : TColor;
      var i : Integer;
      for i:=0 to gUIConst.GetFontCount-1 do
      begin
         var ttext : String = '1';
         if gUIConst.font[i]<>'' then
         _gui_CreateText('preload', elmPreload, ttext, gc_halLeft, gc_valTop, GetViewerWidth, GetViewerHeight, 0, 0, gc_halLeft, gc_valTop, i, color, False);
      end;
   end;
   
   var totalphys, availphys, totalvirt, availvirt : Integer;
   GetHardwareRAMInfo(totalphys, availphys, totalvirt, availvirt);
   var ramGB : Integer = round(totalphys/1024) div 1000;
   var lowPC : Boolean = ramGB<=2;
   if (top<>0) then
   begin
      var elmPreload : Integer = AddNewElementByClassNameParent('preloader', 'TOSWImageGuiControl', 0, top);
      var i : Integer;
      for i:=0 to 2 do
      begin
         var mat : String;
         case i of
            0 : mat := 'misc.blank';
            1 : mat := 'icons.bld.hou';
            2 : begin
               if (not lowPC) then
               mat := 'misc.color.black';
            end;
         end;
         if (mat<>'') then
         _gui_CreateImage('', elmPreload, mat, gc_halLeft, gc_valTop, -64, -64, 16, 16, 0, False);
      end;
      if (not lowPC) then
      PreloadFonts(elmPreload);
      GUIPrepareLoad();
      _gui_FadeElement(elmPreload, gc_gui_fade_time_200, False);
   end
   else
   ErrorLog('_gui_PreloadTextures : top element = 0');
end;

// _gui_DoViewerRestrictWindow
//
procedure _gui_DoViewerRestrictWindow(elmHnd, marginl, margint, marginr, marginb, additionyoffset : Integer);
begin
   if (elmHnd<>0) then
   begin
      var px : Integer = GetGUIElementPositionX(elmHnd);
      var py : Integer = GetGUIElementPositionY(elmHnd);
      var dpiscale : Float = _gui_GetAbsScaleByDPI(px, py);
      var width : Integer = round(GetGUIElementWidth(elmHnd)*dpiscale);
      var height : Integer = round(GetGUIElementHeight(elmHnd)*dpiscale);
      var restrictLeft : Integer = marginl;
      var restrictTop : Integer = margint;
      var restrictRight : Integer = GetViewerWidth()-(width+marginr);
      var restrictBottom : Integer = GetViewerHeight()-(height+marginb);
      
      var minimapMinH : Integer = round(GetViewerHeight-GetGUIMiniMapPositionY-GetGUIMiniMapHeight-20*dpiscale);
      var minimapMinW : Integer = round(GetGUIMiniMapPositionX-20*dpiscale);
      if ((px+width)>minimapMinW) and ((py+height)>minimapMinH) then // minimap overlaps, need offset
      restrictRight := restrictRight-round(GetGUIMiniMapWidth+20*dpiscale);
      
      if (px<restrictLeft) then
      px := restrictLeft;
      if (px>restrictRight) then
      px := restrictRight;
      if (py<(restrictTop)) then
      py := restrictTop+additionyoffset;
      if (py>restrictBottom) then
      py := restrictBottom;
      
      SetGUIElementPositionX(elmHnd, px);
      SetGUIElementPositionY(elmHnd, py);
   end;
end;

function FindModifyElementTextHandle(elmHandle : Integer; ichar : Integer; schar : String) : Integer;
begin
   Result := 0;
   if (ichar<32) and (ichar>255) then
   exit;
   if GetGUIElementVisible(elmHandle) then
   begin
      var className : String = GetObjectClassNameByHandle(elmHandle);
      if (SameText(className, 'TOSWBaseGuiTextControl') or SameText(className, 'TXGuiListBox')) then
      begin
         Result := elmHandle;
         var text : String = GetGUIElementText(Result);
         if (text<>'') then
         begin
            if (StrPos(schar, text)>0) {and (StrLength(text)>20)} then
            begin
               var font : String = GetGUIElementFont(elmHandle);
               if (font<>'') then
               begin
                  if (IntRegister7>=0) and (IntRegister7<=31) then
                  begin
                     var ifont : Integer;
                     var i : Integer;
                     for i:=0 to 31 do
                     begin
                        if (font=gFonts[i].font) then
                        begin
                           //IntRegister6 := ClampInt(i, 0, 31);
                           ifont := i;
                           //Log(IntToStr(IntRegister6)+' font = '+font);
                           break;
                        end;
                     end;
                     ifont := ClampInt(IntRegister7, 0, 31);
                     if (ifont=IntRegister7) then
                     begin
                        var restext : String;
                        restext := StrReplace(text, schar, gc_font_color_orange+schar+gc_font_color_default);
                        SetGUIElementText(Result, restext);
                     end;
                  end;
               end;
            end;
         end;
      end
      else
      begin
         var count : Integer = GetGUIElementChildrenCount(elmHandle);
         var i : Integer;
         for i:=0 to count-1 do
         Result := FindModifyElementTextHandle(GetGUIElementChildrenByIndex(elmHandle, i), ichar, schar);
      end;
   end;
end;

// _gui_FindChildHandleByName
//
function _gui_FindChildHandleByName(parent : Integer; var childname : String) : Integer;
begin
   Result := 0;
   if (childname='') then
   begin
      ErrorLog('_gui_FindChildHandleByName childname = ""');
      exit;
   end;
   var rparent : Integer;
   if (parent=0) then rparent := _gui_GetTop
   else rparent := parent;
   if SameText(GetGUIElementNameByIndex(rparent), childname) then
   begin
      Result := rparent;
      exit;
   end;
   var i : Integer;
   for i:=0 to GetGUIElementChildrenCount(rparent)-1 do
   begin
      var elmChildHnd : Integer = GetGUIElementChildrenByIndex(rparent, i);
      Result := _gui_FindChildHandleByName(elmChildHnd, childname);
      if (Result<>0) then
      break;
   end;
end;

// _gui_InputBoxSetupStrCharFilter
//
procedure _gui_InputBoxSetupStrCharFilter(elmInputBox : Integer; bPickTextChild : Boolean; const sCustomFilterString : String);
begin
   var elmTextInputBox : Integer;
   if (bPickTextChild) then
   elmTextInputBox := GetGUIElementIndexByNameParent('text', elmInputBox)
   else
   elmTextInputBox := elmInputBox;
   var text : String = GetGUIElementText(elmTextInputBox);
   var sFilterString : String = sCustomFilterString;
   SetGUIElementEditFilter(elmTextInputBox, sFilterString);
end;

// _gui_InputBoxSetupNumCharFilter
//
procedure _gui_InputBoxSetupNumCharFilter(elmInputBox : Integer; bPickTextChild, bNegative : Boolean);
begin
   var elmTextInputBox : Integer;
   if (bPickTextChild) then
   elmTextInputBox := GetGUIElementIndexByNameParent('text', elmInputBox)
   else
   elmTextInputBox := elmInputBox;
   var text : String = GetGUIElementText(elmTextInputBox);
   var sFilterString : String = gc_gui_charfilter_numeric;
   if (bNegative) then
   sFilterString := '-'+sFilterString;
   SetGUIElementEditFilter(elmTextInputBox, sFilterString);
end;

// _gui_AddScroller
//
function _gui_AddScroller(parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; bEnabled : Boolean) : Integer;
begin
   const cBtnDummy = 'btn.dummy';
   const cMaterialScrollerTile = 'scroller.tile';
   const cMaterialScrollerUp = 'scroller.btn.up';
   const cMaterialScrollerDown = 'scroller.btn.down';
   const cMaterialScroller = 'scroller.btn';
   var curind : Integer = GetGUICursorIndexByName('crPress');
   
   var iwidth : Integer = _misc_SwitchInt(width, GetGUITextureWidth(cMaterialScrollerTile), width=0);
   var iheight : Integer = _misc_SwitchInt(height-GetGUITextureHeight(cMaterialScrollerDown)*2, GetGUIElementHeight(parent)-GetGUITextureHeight(cMaterialScrollerDown)*2, height=0);
   
   var elmVScroll : Integer;
   var className : String = GetObjectClassNameByHandle(parent);
   var bListBox : Boolean = (SameText(className, 'TXGuiListBox'));
   if (bListBox) then
   elmVScroll := GetGUIListBoxScrollerHandle(parent)
   else
   // if (SameText(className, 'TXGuiLayer') then
   elmVScroll := GetGUIElementVScroll(parent);
   
   SetGUIElementAlign(elmVScroll, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementCursorByName(elmVScroll, 'crDefault');
   SetGUIAllowEvents(elmVScroll, True, False, False);
   
   SetGUIElementMaterialOffset(elmVScroll, 0, 0);
   SetGUIElementAllPositionRect(elmVScroll, posX, posY, GetGUITextureWidth(cMaterialScrollerTile), iheight);
   SetGUIElementLogicHeight(elmVScroll, iheight);
   
   SetGUIElementMaterial(elmVScroll, cMaterialScrollerTile);
   SetGUIScrollButtonSource(elmVScroll, 0, cBtnDummy, true); // cMaterialScrollerUp
   SetGUIScrollButtonSource(elmVScroll, 2, cBtnDummy, true); // cMaterialScrollerDown
   SetGUIScrollButtonSource(elmVScroll, 1, cBtnDummy, true); // cMaterialScroller
   
   var i : Integer;
   for i :=0 to 2 do
   begin
      var mat : String;
      case i of
         0 : mat := cMaterialScrollerUp;
         1 : begin
            if (not bEnabled) then
            mat := gc_gui_material_blank
            else
            mat := cMaterialScroller;
         end;
         2 : mat := cMaterialScrollerDown;
      end;
      var tmpElm : Integer = GetGUIElementScrollButtonIndex(elmVScroll, i);
      SetGUIElementAllRect(tmpElm, GetGUITextureWidth(mat), GetGUITextureHeight(mat));
      SetGUIElementVisibleProperties(tmpElm, 'UpProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'HoverProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DownProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DisableProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'CheckOnProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      case i of
         0 : begin
            SetGUIElementPositionY(tmpElm, -GetGUITextureHeight(mat));
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentTop'); // halParentLeft
         end;
         1 : begin
            SetGUIElementPositionX(tmpElm, 1);
            SetGUIElementAlign(tmpElm, 'halParentMiddle', 'valParentTop'); // valParentTop
         end;
         2 : begin
            if (bListBox) then
            SetGUIElementPositionY(tmpElm, GetGUITextureHeight(mat))
            else
            SetGUIElementPositionY(tmpElm, -GetGUITextureHeight(mat));
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentBottomHeight'); // halParentLeft
         end;
      end;
      if (not bEnabled) then
      begin
         SetGUIElementUseUserColor(tmpElm, True);
         SetGUIElementUserColor(tmpElm, 0.6, 0.6, 0.6, 0.5);
      end
      else
      begin
         SetGUIElementUseUserColor(tmpElm, False);
         SetGUIElementUserColor(tmpElm, 1, 1, 1, 1);
      end;
   end;
   if (not bEnabled) then
   begin
      SetGUIElementUseUserColor(elmVScroll, True);
      SetGUIElementUserColor(elmVScroll, 0.6, 0.6, 0.6, 0.5);
      SetGUIElementVisible(elmVScroll, True);
   end
   else
   begin
      SetGUIElementUseUserColor(elmVScroll, False);
      SetGUIElementUserColor(elmVScroll, 1, 1, 1, 1);
   end;
   Result := elmVScroll;
end;

// _gui_CreateScrollLayer
//
function _gui_CreateScrollLayer(const elementName : String; parent, halign, valign : Integer; posX, posY, sizeX, sizeY, scrollX, scrollY, scrollW, scrollH : Integer; showScroller, bGetUpdate : Boolean) : Integer;
begin
   var iparent : Integer = parent;
   if (iparent=0) then iparent := _gui_GetTop;
   
   var rsizex, rsizey : Integer;
   if (sizeX=0) then rsizex := GetGUIElementWidth(iparent)
   else rsizex := sizeX;
   if (sizeY=0) then rsizey := GetGUIElementHeight(iparent)
   else rsizey := sizeY;
   const cScrollerMarginY = 0;
   
   const cMaterialScroller = 'scroller';
   const cBtnDummy = 'btn.dummy';
   var elmScrollLayer : Integer;
   if (bGetUpdate) then
   elmScrollLayer := GetGUIElementIndexByNameParent(elementName, iparent);
   if (elmScrollLayer=0) then
   elmScrollLayer := AddNewElementByClassNameParent(elementName, 'TXGuiLayer', 0, iparent);
   SetGUIElementAlign(elmScrollLayer, gUIConst.halign[halign], gUIConst.valign[valign]);
   SetGUIElementAllPositionRect(elmScrollLayer, posX, posY, rsizeX, rsizeY);
   SetGUIElementMaterial(elmScrollLayer, gc_gui_material_blank);
   SetGUIScrollEnabled(elmScrollLayer, True);
   
   // - setup scroller
   const cMaterialScrollerUp = 'scroller.btn.up';
   const cMaterialScrollerTile = 'scroller.tile';
   const cMaterialScrollerDown = 'scroller.btn.down';
   if (showScroller) then
   _gui_AddScroller(elmScrollLayer, gc_halParentRightWidth, gc_valParentTop, GetGUITextureWidth(cMaterialScrollerTile)+scrollX, GetGUITextureHeight(cMaterialScrollerUp)+scrollY, GetGUITextureWidth(cMaterialScrollerTile), GetGUIElementHeight(elmScrollLayer), True);
   {var elmVScroll : Integer = GetGUIElementVScroll(elmScrollLayer);
   SetGUIElementAlign(elmVScroll, 'halParentRightWidth', 'valParentTop');
   SetGUIElementCursorByIndex(elmVScroll, 1);
   SetGUIAllowEvents(elmVScroll, True, False, False);
   
   SetGUIElementMaterialOffset(elmVScroll, 0, 0);
   SetGUIElementAllPositionRect(elmVScroll, 0, GetGUITextureHeight(cMaterialScrollerUp)+cScrollerMarginY, GetGUITextureWidth(cMaterialScrollerTile), GetGUIElementHeight(elmScrollLayer)-GetGUITextureHeight(cMaterialScrollerDown)*2-cScrollerMarginY*2);
   SetGUIElementLogicHeight(elmVScroll, GetGUIElementHeight(elmVScroll)+GetGUITextureHeight(cMaterialScrollerUp));
   
   SetGUIElementMaterial(elmVScroll, cMaterialScrollerTile);
   SetGUIScrollButtonSource(elmVScroll, 0, cBtnDummy, true); // cMaterialScrollerUp
   SetGUIScrollButtonSource(elmVScroll, 2, cBtnDummy, true); // cMaterialScrollerDown
   SetGUIScrollButtonSource(elmVScroll, 1, cBtnDummy, true); // cMaterialScroller
   
   var i : Integer;
   for i :=0 to 2 do
   begin
      var mat : String;
      case i of
         0 : mat := cMaterialScrollerUp;
         1 : mat := cMaterialScroller;
         2 : mat := cMaterialScrollerDown;
      end;
      var tmpElm : Integer = GetGUIElementScrollButtonIndex(elmVScroll, i);
      SetGUIElementAllRect(tmpElm, GetGUITextureWidth(mat), GetGUITextureHeight(mat));
      SetGUIElementVisibleProperties(tmpElm, 'UpProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'HoverProperty', mat, 0, 0, 0, 0, 2, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DownProperty', mat, 0, 0, 0, 0, 2, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DisableProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'CheckOnProperty', mat, 0, 0, 0, 0, 2, 0.5, 0.5, 0.5, 1);
      case i of
         0 : begin
            SetGUIElementPositionY(tmpElm, -GetGUITextureHeight(mat));
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentTop'); // halParentLeft
         end;
         1 : begin
            SetGUIElementAlign(tmpElm, 'halParentMiddle', 'valParentTop'); // valParentTop
         end;
         2 : begin
            SetGUIElementPositionY(tmpElm, -GetGUITextureHeight(mat));
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentBottomHeight'); // halParentLeft
         end;
      end;
   end;}
   
   Result := elmScrollLayer;
end;

