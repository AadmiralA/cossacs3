// _gui_FindCurrentVideoPreset
//
procedure _gui_FindCurrentVideoPreset(pConfig : Integer; var curPreset : String; var presetIndex : Integer);
begin
   const cProjOptionsPreset = 'Preset';
   const cProjOptionsPresetLow = 'guiSetLow';
   const cProjOptionsPresetMedium = 'guiSetMedium';
   const cProjOptionsPresetHigh = 'guiSetHigh';
   const cProjOptionsPresetCustom = 'guiSetCustom';
   const cProjOptionsResolution = 'Resolution';
   const cProjOptionsAntiAliasing = 'AntiAliasing';
   const cProjOptionsFXAAEnable = 'FXAAEnable';
   const cProjOptionsSSAOEnable = 'SSAOEnable';
   const cProjOptionsHDRType = 'HDRType';
   const cProjOptionsVSyncMode = 'VSyncMode';
   const cProjOptionsShadowMap = 'ShadowMap';
   const cProjOptionsShadowEnabled = 'ShadowMapEnabled';
   const cProjOptionsTextureQuality = 'DDSDetailLevel';
   const cProjOptionsTextureFilter = 'TextureFilteringQuality';
   const cProjOptionsShaderType = 'ShaderType';
   const cProjOptionsWaterReflection = 'WaterReflection';
   
   curPreset := cProjOptionsPresetCustom;
   presetIndex := 3;
   if (pConfig<>0) then
   begin
      var pEngine : Integer = ParserSelectByHandleByKey(pConfig, 'engine');
      if (pEngine<>0) then
      begin
         var pEngineConfigs : Integer = ParserSelectByHandleByKey(pEngine, 'config');
         if (pEngineConfigs<>0) then
         begin
            var tmpPreset : String;
            var i : Integer;
            for i:=0 to 2 do
            begin
               case i of
                  0 : tmpPreset := cProjOptionsPresetLow;
                  1 : tmpPreset := cProjOptionsPresetMedium;
                  2 : tmpPreset := cProjOptionsPresetHigh;
               end;
               ParserSelectByHandle(pEngineConfigs);
               var pEngineConfig : Integer = ParserSelectByHandleByIndex(pEngineConfigs, ParserFindChildIndexByEqualChildKey('Name', tmpPreset));
               if (pEngineConfig<>0) then
               begin
                  var pGui : Integer = ParserSelectByHandleByKey(pEngineConfig, 'Gui');
                  if (pGui<>0) then
                  begin
                     var pOnClick : Integer = ParserSelectByHandleByKey(pGui, 'OnClick');
                     if (pOnClick<>0) then
                     begin
                        if gSettingsTmp.video.hdrtype=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsHDRType)
                        and gSettingsTmp.video.shadertype=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsShaderType)
                        and gSettingsTmp.video.antialiasing=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsAntiAliasing)
                        and gSettingsTmp.video.texturefilter=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsTextureFilter)
                        and gSettingsTmp.video.texturequality=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsTextureQuality)
                        and gSettingsTmp.video.waterreflection=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsWaterReflection)
                        and gSettingsTmp.video.shadowenabled=ParserGetBoolValueByKeyByHandle(pOnClick, cProjOptionsShadowEnabled)
                        and gSettingsTmp.video.shadowmap=ParserGetValueByKeyByHandle(pOnClick, cProjOptionsShadowMap) then
                        begin
                           curPreset := tmpPreset;
                           presetIndex := i;
                           exit;
                        end;
                     end;
                  end;
               end;
            end;
         end;
      end;
   end;
end;

// _gui_GetSettingsValues
//
procedure _gui_GetSettingsValues();
begin
   const cProjOptionsAntiAliasing = 'AntiAliasing';
   const cProjOptionsFXAAEnable = 'FXAAEnable';
   const cProjOptionsSSAOEnable = 'SSAOEnable';
   const cProjOptionsHDRType = 'HDRType';
   const cProjOptionsVSyncMode = 'VSyncMode';
   const cProjOptionsShadowMap = 'ShadowMap';
   const cProjOptionsShadowEnabled = 'ShadowMapEnabled';
   const cProjOptionsTextureFilter = 'TextureFilteringQuality';
   const cProjOptionsTextureQuality = 'DDSDetailLevel';
   const cProjOptionsShaderType = 'ShaderType';
   const cProjOptionsWaterReflection = 'WaterReflection';
   
   gSettings.video.antialiasing := GetProjectOptionAsString(cProjOptionsAntiAliasing);
   gSettings.video.hdrtype := GetProjectOptionAsString(cProjOptionsHDRType);
   gSettings.video.vsyncmode := GetProjectOptionAsString(cProjOptionsVSyncMode);
   gSettings.video.fxaa := GetProjectOptionAsBoolean(cProjOptionsFXAAEnable);
   gSettings.video.ssao := GetProjectOptionAsBoolean(cProjOptionsSSAOEnable);
   gSettings.video.shadowmap := GetProjectOptionAsString(cProjOptionsShadowMap);
   gSettings.video.shadowenabled := GetProjectOptionAsBoolean(cProjOptionsShadowEnabled);
   gSettings.video.texturefilter := GetProjectOptionAsString(cProjOptionsTextureFilter);
   gSettings.video.texturequality := GetProjectOptionAsString(cProjOptionsTextureQuality);
   if (gSettings.video.texturequality='') then
   gSettings.video.texturequality := '0';
   gSettings.video.shadertype := GetProjectOptionAsString(cProjOptionsShaderType);
   gSettings.video.waterreflection := GetProjectOptionAsString(cProjOptionsWaterReflection);
end;

// _gui_ShowSettingsDialog
//
procedure _gui_ShowSettingsDialog();
begin
   _gui_GetSettingsValues;
   
   gInterface.settings := gc_settings_video;
   
   var pConfig : Integer = ParserSelectByKey('Config');
   if (pConfig=0) then
   begin
      pConfig := ParserCreate('Config');
      ParserLoadFromFile('.\data\resources\config.res');
   end;
   
   var presetIndex : Integer;
   _gui_FindCurrentVideoPreset(pConfig, gSettings.video.preset, presetIndex);
   
   gProfileTmp := gProfile;
   gSettingsTmp := gSettings;
   GUIExecuteState('ShowSettings');
end;

