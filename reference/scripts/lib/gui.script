// _gui_UpdateListBoxScrollerPos
//
procedure _gui_UpdateListBoxScrollerPos(elmHnd : Integer);
begin
   var count : Integer = GetGUIListBoxItemsCount(elmHnd);
   var topIndex : Integer = GetGUIListBoxTopIndex(elmHnd);
   var elmScrollHnd : Integer = GetGUIListBoxScrollerHandle(elmHnd);
   var rowheight : Integer = GetGUIListBoxRowHeight(elmHnd);
   var step : Float = ((GetGUIElementHeight(elmHnd)-rowheight)/rowheight);
   var pos : Float = ((topIndex)/((count-1)-step));
   SetGUIScrollBarPosition(elmScrollHnd, pos);
   GUIInvokeMouseMove;
end;

// _gui_CreateCheckBox
//
function _gui_CreateCheckBox(const elementName : String; parent : Integer; bChecked : Boolean; hAlign, vAlign : Integer; posX, posY : Integer; var eventState, hint : String; tag : Integer; bGetUpdate : Boolean) : Integer;
begin
   const cMaterialCheckbox = 'checkbox';
   const cxOff = 0;
   const cyOff = 0;
   const ctxOff = 0;
   const ctyOff = 0;
   //const cLogicWidth = 182;
   //const cLogicHeight = 23;
   var curind : Integer = GetGUICursorIndexByName('crPress');
   {var tmpText : String = text;
   _misc_StringToText(text, tmpText);}
   var elmHnd : Integer = _gui_CreateButton(elementName, parent, cMaterialCheckbox, hAlign, vAlign, posX, posY, 0, 0, eventState, hint, tag, bGetUpdate);
   SetGUIElementChecked(elmHnd, bChecked);
   SetGUIElementTextFormatted(elmHnd, True);
   {SetGUIElementTextAlign(elmHnd, 'halLeft', 'valMiddle', 0, 0);
   SetGUIElementText(elmHnd, tmpText);
   SetGUIElementTextFormatted(elmHnd, True);
   SetGUIElementFont(elmHnd, gUIConst.font[gc_font_default_serif]);
   SetGUIElementLogicRect(elmHnd, cLogicWidth, cLogicHeight);}
   var cTColorNormal : TColor;
   var cTColorHover : TColor;
   var cTColorPressed : TColor;
   var cTColorDisabled : TColor;
   var cTColorChecked : TColor;
   _gui_ConvertHexToTColor(gc_font_hex_color_lightgrey, cTColorNormal);
   _gui_ConvertHexToTColor(gc_font_hex_color_darkgrey, cTColorHover);
   _gui_ConvertHexToTColor(gc_font_hex_color_lightgrey, cTColorPressed);
   _gui_ConvertHexToTColor(gc_font_hex_color_lightgrey, cTColorDisabled);
   _gui_ConvertHexToTColor(gc_font_hex_color_lightgrey, cTColorChecked);
   SetGUIElementVisibleProperties(elmHnd, 'UpProperty', cMaterialCheckbox+'.normal', cxOff, cyOff, ctxOff, ctyOff, -1, cTColorNormal.r, cTColorNormal.g, cTColorNormal.b, cTColorNormal.a);
   SetGUIElementVisibleProperties(elmHnd, 'HoverProperty', cMaterialCheckbox+'.hover', cxOff, cyOff, ctxOff, ctyOff, curind, cTColorHover.r, cTColorHover.g, cTColorHover.b, 1);
   SetGUIElementVisibleProperties(elmHnd, 'DownProperty', cMaterialCheckbox+'.pressed', cxOff, cyOff, ctxOff, ctyOff, curind, cTColorPressed.r, cTColorPressed.g, cTColorPressed.b, 1);
   SetGUIElementVisibleProperties(elmHnd, 'DisableProperty', cMaterialCheckbox+'.disabled', cxOff, cyOff, ctxOff, ctyOff, -1, cTColorDisabled.r, cTColorDisabled.g, cTColorDisabled.b, 1);
   SetGUIElementVisibleProperties(elmHnd, 'CheckOnProperty', cMaterialCheckbox+'.checked', cxOff, cyOff, ctxOff, ctyOff, curind, cTColorChecked.r, cTColorChecked.g, cTColorChecked.b, 1);
   Result := elmHnd;
end;

// _gui_CreateComboBox
//
function _gui_CreateComboBox(const elementName : String; parent : Integer; count, minScrollCount : Integer; hAlign, vAlign : Integer; posX, posY, width : Integer; textHAlign, textVAlign : Integer; tOffX, tOffY, font : Integer; bshowbtn : Boolean; var eventState : String; bGetUpdate, bClear : Boolean) : Integer;
begin
   Result := 0;
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this ca.se we are not able to get element handle by name. elmname='+elementName);
   
   var rfont : String = gUIConst.font[font];
   if (font=gc_font_none) then
   rfont := gUIConst.font[gc_font_serif_12];
   const cListOffY = 5;
   const cScrollerMarginY = 0;
   var cMaterialMiddle : String = 'combobox.background.'+IntToStr(floor(1+RandomExt*6));
   const cMaterialBtn = 'combobox.btn.pressed';
   const cMaterialListSelected = 'combobox.list.selected';
   const cMaterialListHover = 'combobox.list.hover';
   const cMaterialListBackground = 'combobox.list.background';
   const cMaterialScrollerTile = 'scroller.tile';
   const cMaterialScrollerUp = 'scroller.btn.up';
   const cMaterialScrollerDown = 'scroller.btn.down';
   const cMaterialScroller = 'scroller.btn';
   
   var cMaterialListSelectedHeight : Integer = GetGUITextureHeight(cMaterialListSelected)-4;
   var cMaterialMiddleHeight : Integer = GetGUITextureHeight(cMaterialMiddle)+3;
   
   const cBtnDummy = 'btn.dummy';
   var curind : Integer = GetGUICursorIndexByName('crPress');
   
   var iposX : Integer = posX;
   var iposY : Integer = posY;
   
   var iwidth : Integer;
   if (width<>0) then
   iwidth := width
   else
   iwidth := GetGUITextureWidth(cMaterialMiddle);
   var iminScrollCount : Integer = minScrollCount;
   if (iminScrollCount=0) then
   iminScrollCount := count;
   
   var color : TColor;
   var colorhover : TColor;
   _gui_SetupTColorInteger(255, 220, 170, 255, 0.875, color);
   _gui_SetupTColorInteger(255, 220, 170, 255, 1, colorhover);
   
   // - setup combobox
   if (bGetUpdate) then
   begin
      Result := GetGUIElementIndexByNameParent(elementName, parent);
      if (bClear) then
      GUIListBoxClearSilent(Result);
   end;
   
   if (Result=0) then
   Result := AddNewElementByClassNameParent(elementName, 'TXGuiComboBox', 0, parent);
   SetGUIElementCursorByName(Result, 'crPress');
   SetGUIElementPressState(Result, eventState);
   SetGUIElementFont(Result, rfont);
   SetGUIElementColor(Result, color.r, color.g, color.b, color.a);
   SetGUIElementTextAlign(Result, gUIConst.halign[textHAlign], gUIConst.valign[textVAlign], tOffX, tOffY-1);
   SetGUIElementTextFormatted(Result, True);
   SetGUIElementAlign(Result, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementPosition(Result, iposX, iposY);
   SetGUIElementLogicRect(Result, iwidth, cMaterialMiddleHeight);
   SetGUIElementRect(Result, iwidth, cMaterialMiddleHeight);
   SetGUIElementMaterial(Result, cMaterialMiddle);
   
   SetGUIListBoxSelectedMaterialName(Result, cMaterialListSelected); // selected
   SetGUIListBoxRowHeight(Result, cMaterialListSelectedHeight);
   SetGUIListBoxVisibleRows(Result, iminScrollCount);
   
   SetGUIListBoxMouseTrack(Result, 3); // 1 - only text change color on hover, 2 - only material appears, 3 - text and material on hover
   SetGUIListBoxMouseTrackMaterialName(Result, cMaterialListHover); // hover
   SetGUIListBoxMouseTrackFontColor(Result, colorhover.r, colorhover.g, colorhover.b, colorhover.a);
   
   {var middleMatW : Integer = GetGUITextureWidth(cMaterialMiddle);
   var side : Integer = GetGUITextureWidth(cMaterialLeft);
   var middleW : Integer = iwidth-side-side;
   if (middleW<>0) then
   begin
      var tileW : Integer = (middleW div middleMatW);
      if ((middleW mod middleMatW)>0) then tileW := tileW+1;
      var i : Integer;
      for i:=0 to tileW-1 do
      begin
         GUIElementSendToBack(_gui_CreateTileScaleImage('t_'+IntToStr(i), Result, cMaterialMiddle, gc_halParentLeft, gc_valParentTop, i*middleMatW, 0, Min(middleMatW, middleW-i*middleMatW), 0, bGetUpdate));
      end;
   end;}
   
   // - setup combobox list
   var tmpHnd : Integer = GetGUIComboBoxListBoxHandle(Result);
   SetGUIElementCursorByName(tmpHnd, 'crPress');
   SetGUIElementAlign(tmpHnd, 'halParentMiddle', 'valParentTop');
   SetGUIElementFont(tmpHnd, rfont);
   SetGUIElementColor(tmpHnd, color.r, color.g, color.b, color.a);
   SetGUIElementTextAlign(tmpHnd, gUIConst.halign[textHAlign], gUIConst.valign[textVAlign], tOffx, tOffY);
   SetGUIElementTextFormatted(tmpHnd, True);
   SetGUIElementMaterial(tmpHnd, cMaterialListBackground);
   SetGUIElementAllPositionRect(tmpHnd, 0 ,GetGUIElementHeight(Result)+cListOffY, GetGUIElementLogicWidth(Result), cMaterialListSelectedHeight*(Min(count, iminScrollCount)));
   
   // - setup scroller
   var elmVScroll : Integer = GetGUIListBoxScrollerHandle(tmpHnd);
   SetGUIElementAlign(elmVScroll, 'halParentRightWidth', 'valParentTop');
   SetGUIElementCursorByName(elmVScroll, 'crDefault');
   SetGUIAllowEvents(elmVScroll, True, False, False);
   
   SetGUIElementMaterialOffset(elmVScroll, 0, 0);
   SetGUIElementAllPositionRect(elmVScroll, 0, GetGUITextureHeight(cMaterialScrollerUp)+cScrollerMarginY, GetGUITextureWidth(cMaterialScrollerTile), GetGUIElementHeight(tmpHnd)-GetGUITextureHeight(cMaterialScrollerDown)*2-cScrollerMarginY*2);
   SetGUIElementLogicHeight(elmVScroll, GetGUIElementHeight(elmVScroll)+GetGUITextureHeight(cMaterialScrollerUp));
   
   SetGUIElementMaterial(elmVScroll, cMaterialScrollerTile);
   SetGUIScrollButtonSource(elmVScroll, 0, cBtnDummy, true); // cMaterialScrollerUp
   SetGUIScrollButtonSource(elmVScroll, 2, cBtnDummy, true); // cMaterialScrollerDown
   SetGUIScrollButtonSource(elmVScroll, 1, cBtnDummy, true); // cMaterialScroller
   
   var i : Integer;
   for i :=0 to 2 do
   begin
      var mat : String;
      case i of
         0 : mat := cMaterialScrollerUp;
         1 : mat := cMaterialScroller;
         2 : mat := cMaterialScrollerDown;
      end;
      var tmpElm : Integer = GetGUIElementScrollButtonIndex(elmVScroll, i);
      SetGUIElementAllRect(tmpElm, GetGUITextureWidth(mat), GetGUITextureHeight(mat));
      SetGUIElementVisibleProperties(tmpElm, 'UpProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'HoverProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DownProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'DisableProperty', mat, 0, 0, 0, 0, -1, 0.5, 0.5, 0.5, 1);
      SetGUIElementVisibleProperties(tmpElm, 'CheckOnProperty', mat, 0, 0, 0, 0, curind, 0.5, 0.5, 0.5, 1);
      case i of
         0 : begin
            SetGUIElementPositionY(tmpElm, -GetGUITextureHeight(mat));
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentTop'); // halParentLeft
         end;
         1 : begin
            SetGUIElementAlign(tmpElm, 'halParentMiddle', 'valParentTop'); // valParentTop
         end;
         2 : begin
            SetGUIElementAlign(tmpElm, 'halParentLeft', 'valParentBottomHeight'); // halParentLeft
         end;
      end;
   end;
   if (bshowbtn) then
   _gui_CreateImage('btn', Result, cMaterialBtn, gc_halParentRightWidth, gc_valParentMiddle, -2, 1, 0, 0, 0, True)
   else
   begin
      var elm : Integer = GetGUIElementIndexByNameParent('btn', Result);
      if (elm<>0) and GetGUIElementVisible(elm) then
      SetGUIElementVisible(elm, False);
   end;
end;

// _gui_CreateListBox
//
function _gui_CreateListBox(const elementName : String; parent : Integer; hAlign, vAlign : Integer; posX, posY, width, height : Integer; textHAlign, textVAlign : Integer; tOffX, tOffY, font : Integer; var eventState : String; bAddScroller, bGetUpdate : Boolean) : Integer;
begin
   Result := 0;
   if (bGetUpdate) and (elementName='') then log('_gui_Create function with bGet flag must have specified elementName, to work properly');
   if (elementName<>'') and (StrExists(elementName, '.')) then ErrorLog('_gui_Create element name should not have dot char. I this ca.se we are not able to get element handle by name. elmname='+elementName);
   
   var rfont : String = gUIConst.font[font];
   if (font=gc_font_none) then
   rfont := gUIConst.font[gc_font_serif_12];
   const cMaterialListSelected = 'combobox.list.selected';
   const cMaterialListHover = 'combobox.list.hover';
   const cMaterialScrollerUp = 'scroller.btn.up';
   const cMaterialScrollerTile = 'scroller.tile';
   var rowHeight : Integer = GetGUIElementFontHeight(rfont)+4;
   
   var iposX : Integer = posX;
   var iposY : Integer = posY;
   
   var iwidth : Integer;
   if (width<>0) then
   iwidth := width
   else
   iwidth := GetGUIElementWidth(parent);
   
   iwidth := iwidth-GetGUITextureWidth(cMaterialScrollerTile);
   
   var iheight : Integer;
   if (height<>0) then
   iheight := height
   else
   iheight := GetGUIElementHeight(parent);
   
   var color : TColor;
   var colorhover : TColor;
   _gui_SetupTColorInteger(255, 220, 170, 255, 0.875, color);
   _gui_SetupTColorInteger(255, 220, 170, 255, 1, colorhover);
   
   // - setup combobox
   if (bGetUpdate) then
   Result := GetGUIElementIndexByNameParent(elementName, parent);
   
   if (Result=0) then
   Result := AddNewElementByClassNameParent(elementName, 'TXGuiListBox', 0, parent);
   SetGUIElementCursorByName(Result, 'crPress');
   SetGUIElementPressState(Result, eventState);
   SetGUIElementFont(Result, rfont);
   SetGUIElementColor(Result, color.r, color.g, color.b, color.a);
   SetGUIElementTextAlign(Result, gUIConst.halign[textHAlign], gUIConst.valign[textVAlign], tOffX, tOffY-1);
   SetGUIElementTextFormatted(Result, True);
   SetGUIElementAlign(Result, gUIConst.halign[hAlign], gUIConst.valign[vAlign]);
   SetGUIElementPosition(Result, iposX, iposY);
   SetGUIElementLogicRect(Result, iwidth, iheight);
   SetGUIElementRect(Result, iwidth, iheight);
   SetGUIElementMaterial(Result, gc_gui_material_blank{cMaterialMiddle});
   
   SetGUIListBoxSelectedMaterialName(Result, cMaterialListSelected); // selected
   SetGUIListBoxRowHeight(Result, rowHeight);
   SetGUIListBoxVisibleRows(Result, -1);
   SetGUIListBoxItemIndexSilent(Result, -1);
   
   SetGUIListBoxMouseTrack(Result, 3); // 1 - only text change color on hover, 2 - only material appears, 3 - text and material on hover
   SetGUIListBoxMouseTrackMaterialName(Result, cMaterialListHover); // hover
   SetGUIListBoxMouseTrackFontColor(Result, colorhover.r, colorhover.g, colorhover.b, colorhover.a);
   
   if (bAddScroller) then
   _gui_AddScroller(Result, gc_halParentRightWidth, gc_valParentTop, GetGUITextureWidth(cMaterialScrollerTile), GetGUITextureHeight(cMaterialScrollerUp), GetGUITextureWidth(cMaterialScrollerTile), GetGUIElementHeight(Result), True);
end;

// _gui_CreateListBox
//
