   SetGUIElementAllPositionRect(elmVScroll, 0, GetGUITextureHeight(cMaterialScrollerUp)+cScrollerMarginY, GetGUITextureWidth(cMaterialScrollerTile), GetGUIElementHeight(Result)-GetGUITextureHeight(cMaterialScrollerDown)*2-cScrollerMarginY*2);
   SetGUIElementLogicHeight(elmVScroll, GetGUIElementHeight(elmVScroll)+GetGUITextureHeight(cMaterialScrollerUp));
   
   SetGUIElementMaterial(elmVScroll, cMaterialScrollerTile);
   SetGUIScrollButtonSource(elmVScroll, 0, cBtnDummy, true); // cMaterialScrollerUp
   SetGUIScrollButtonSource(elmVScroll, 2, cBtnDummy, true); // cMaterialScrollerDown
   SetGUIScrollButtonSource(elmVScroll, 1, cBtnDummy, true); // cMaterialScroller
   
   var i : Integer;
   for i :=0 to 2 do
   begin
      var mat : String;
      case i of
         0 : mat := cMaterialScrollerUp;
         1 : mat := cMaterialScroller;
         2 : mat := cMaterialScrollerDown;
      end;
