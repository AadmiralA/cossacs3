//
// parser.script
//

// _parser_EmptyParser
//
function _parser_ParserEmpty() : Integer;
begin
   var name : String = gc_parsername_empty;
   Result := ParserSelectByKey(name);
   if (Result=0) then
   Result := ParserCreate(name)
   else
   ParserClearByHandle(Result);
end;

