// _parser_ParserBattles
//
function _parser_ParserBattles(bClear : Boolean) : Integer;
begin
   var name : String = gc_parsername_battles;
   Result := ParserSelectByKey(name);
   if (Result=0) then
   begin
      Result := ParserCreate(name);
      ParserLoadFromFileByHandle(Result, gc_filepath_battles);
   end
   else
   if (bClear) then
   begin
      ParserClearByHandle(Result);
      ParserLoadFromFileByHandle(Result, gc_filepath_battles);
   end;
end;
