procedure _scenario_RunConstructors(var scenario : TScenario);
begin
   scenario.Create('scenario');
   var i, j : Integer;
   for i:=0 to gc_scenario_maxtriggers-1 do
   begin
      for j:=0 to gc_trigger_maxconditions-1 do
      scenario.triggers[i].conditions[j].bactive := True;
      for j:=0 to gc_trigger_maxactions-1 do
      scenario.triggers[i].actions[j].bactive := True;
   end;
end;

_scenario_RunConstructors(gScenario);
_scenario_RunConstructors(gScenarioTmp);

procedure _scenario_WriteScenario(const ptrigger : Pointer);
begin
   var progressPlHnd : Integer = GetPlayerHandleByIndex(gc_playerind_progress);
   if (progressPlHnd<>0) then
   begin
      gpointer_register0 := ptrigger;
      //var smHnd : Integer = GetPlayerStateMachineHandle(progressPlHnd);
      //StateMachineExecuteState(smHnd, 'WriteScenario', 0);
      PlayerExecuteStateByHandle(progressPlHnd, 'WriteScenario'); // uncommented cause got net error on _record creation with smHnd exec
      gpointer_register0 := nil;
   end;
end;

procedure _scenario_CompileSignText(var text : String; sign : Integer; bwords : Boolean);
begin
   text := '';
   if (bwords) then
   case sign of
      gc_trigger_condition_sign_none : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.none');
      gc_trigger_condition_sign_equal : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.equal');
      gc_trigger_condition_sign_notequal : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.notequal');
      gc_trigger_condition_sign_more : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.more');
      gc_trigger_condition_sign_moreequal : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.moreequal');
      gc_trigger_condition_sign_less : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.less');
      gc_trigger_condition_sign_lessequal : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.lessequal');
   end
   else
   case sign of
      gc_trigger_condition_sign_none : text := GetLocaleTableListItemByID('editor', 'triggereditor.condition.sign.nonwordnone');
      gc_trigger_condition_sign_equal : text := '=';
      gc_trigger_condition_sign_notequal : text := '<>';
      gc_trigger_condition_sign_more : text := '>';
      gc_trigger_condition_sign_moreequal : text := '>=';
      gc_trigger_condition_sign_less : text := '<';
      gc_trigger_condition_sign_lessequal : text := '<=';
   end;
end;

