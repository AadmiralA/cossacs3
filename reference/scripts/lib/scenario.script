                     _unit_ProduceUnit(plHnd, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, cid, unitid, amount, False, True, True);
                  end;
               end;
            end;
            gc_trigger_action_order_SetRallyPointToZone : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var zoneid : Integer = TScenarioTriggerAction(ptriggeraction).zoneid;
               var x : Float = gScenario.zones[zoneid].x;
               var z : Float = gScenario.zones[zoneid].y;
               var i : Integer;
               for i:=gScenario.groups[groupid].unitslist.GetCount-1 downto 0 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(i);
                  _unit_SetRallyPoint(goHnd, x, z, true, false);
               end;
            end;
            gc_trigger_action_order_standground : _misc_SetUnitsListUnitState(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, True, False, True, False);
            gc_trigger_action_order_cancelStandGround : _misc_SetUnitsListUnitState(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, True, False, False, False);
            gc_trigger_action_order_enableSearchEnemy : _misc_SetUnitsListUnitState(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, False, True, False, True);
            gc_trigger_action_order_disableSearchEnemy : _misc_SetUnitsListUnitState(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, False, True, False, False);
            gc_trigger_action_order_moveToZone : begin
               var btransport : Boolean;
               if (gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount=1) then
               begin
                  var trgx : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].x;
                  var trgz : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].y;
                  var goHnd : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0);
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (pobj<>nil) then
                  begin
                     var pObjProp : Pointer = _unit_GetObjProp(goHnd);
                     if (pObj <> nil) and (pObjProp <> nil) and (TObjProp(pObjProp).transport > 0) then
                     begin
                        var plInd : Integer = TObj(pobj).pl;
                        var pArmy : Pointer = gPlayer[plInd].aiData.armyList.AddSetup(plInd);
                        if (pArmy<>nil) then
                        begin
                           var squad : Integer = TObj(pobj).squad;
                           var psquad : Pointer = gPlayer[plInd].squads.Get(squad);
                           if psquad<>nil then
                           begin
                              var grHnd : Integer = _squad_GetGroupHandle(pSquad);
                              _group_AddUnitsFromSquad(grHnd, pSquad);
                              _group_Initialize(grHnd, pSquad);
                              
                              TArmy(pArmy).fSpec := _ai_GetUnitArmySpec(goHnd);
                              TArmy(pArmy).Add(pSquad);
                              _ai_FindMoorPosition(pArmy, trgx, trgz);
                              btransport := True;
                           end;
                        end;
                     end;
                  end;
               end;
               
               if (not btransport) and (gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount>0) then
               begin
                  var posx, posz : Float;
                  _misc_GetUnitsListCentralPosExt(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, gc_statetag_essential_none);
                  var trgx : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].x;
                  var trgz : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].y;
                  var angle : Float = _misc_GetAngleToXVector(posx, posz, trgx, trgz);
                  var dirx : Float = 1;
                  var diry, dirz : Float;
                  VectorRotateY(dirx, diry, dirz, angle);
                  var pobj : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0));
                  if (pobj<>nil) then
                  _player_SetUnitsPosition(TObj(pobj).pl, gc_obj_order_move_mode_default, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, trgx, trgz, dirx, dirz);
               end;
            end;
            gc_trigger_action_order_moveToZoneInstanly : begin
               if (gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount>0) then
               begin
                  var trgx : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].x;
                  var trgz : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].y;
                  var angle : Float = TScenarioTriggerAction(ptriggeraction).direction;
                  var dirx : Float = 1;
                  var diry, dirz : Float;
                  VectorRotateY(dirx, diry, dirz, -angle);
                  var lastsquad : Integer = -1;
                  var aloneUnitsList : TIntegerList;
                  var plHnd : Integer;
                  var pobj : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0));
                  if (pobj<>nil) then
                  plHnd := GetPlayerHandleByIndex(TObj(pobj).pl);
                  var i : Integer;
                  for i:=gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount-1 downto 0 do
                  begin
                     var goHnd : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(i);
                     var pobj : Pointer = _unit_GetTObj(goHnd);
                     if (pobj<>nil) then
                     begin
                        if (TObj(pobj).squad<0) then
                        aloneUnitsList.Add(goHnd)
                        else
                        if (TObj(pobj).squad<>lastsquad) then
                        begin
                           lastsquad := TObj(pobj).squad;
                           var psquad : Pointer = gPlayer[TObj(pobj).pl].squads.Get(TObj(pobj).squad);
                           if (psquad<>nil) then
                           _player_StandSquadToPosition(plHnd, psquad, trgx, trgz, dirx, dirz);
                        end;
                     end;
                  end;
                  _player_StandUnitsToPosition(plHnd, aloneUnitsList, trgx, trgz, dirx, dirz);
               end;
            end;
            gc_trigger_action_order_attackGroup : begin
               var groupcount : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount;
               var enemycount : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupidtrg].unitslist.GetCount;
               if (groupcount>0) and (enemycount>0) then
               begin
                  var trgHnd : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupidtrg].unitslist.Get(0);
                  if (trgHnd<>0) then
                  begin
                     var pobj : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0));
                     var pobjtrg : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupidtrg].unitslist.Get(0));
                     if (pobj<>nil) and (pobjtrg<>nil) then
                     begin
                        var posx, posz, trgx, trgz : Float;
                        _misc_GetUnitsListCentralPosExt(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, gc_statetag_essential_none);
                        _misc_GetUnitsListCentralPosExt(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupidtrg].unitslist, trgx, trgz, gc_statetag_essential_none);
                        var angle : Float = VectorAngle(posx, 0, posz, trgx, 0, trgz);
                        var dirx : Float = 1;
                        var diry, dirz : Float;
                        VectorRotateY(dirx, diry, dirz, angle);
                        
                        _player_SetUnitsPosition(TObj(pobj).pl, gc_obj_order_move_mode_attack, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, trgx, trgz, dirx, dirz);
                        var bbuilding : Boolean = gObjProp[TObj(pobjtrg).cid][TObj(pobjtrg).id].bbuilding;
                        var bwall : Boolean = gObjProp[TObj(pobjtrg).cid][TObj(pobjtrg).id].bwall;
                        if (bwall) or (bbuilding) then
                        if ((gPlayer[TObj(pobj).pl].myplmask and gPlayer[TObj(pobjtrg).pl].enemyplmask)<>0) and (_unit_SelectedUnitsCanAttack(TObj(pobj).pl, trgHnd, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist)) then
                        begin
                           gPtrList.Clear;
                           var i, j : Integer;
                           for i:=0 to enemycount-1 do
                           begin
                              gIntegerList.Clear;
                              var minInd : Integer = i*(groupcount div enemycount);
                              var maxInd : Integer = (i+1)*(groupcount div enemycount);
                              if (i>=enemycount-1) or (maxInd>=groupcount) then
                              maxInd := groupcount-1;
                              for j:=minInd to maxInd do
                              gIntegerList.Add(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(j));
                              var wallHnd : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupidtrg].unitslist.Get(i);
                              if (wallHnd<>0) and (_misc_GetBaseObjID(wallHnd)=gc_baseid_obj) then
                              _player_OrderUnitsToAttack(TObj(pobj).pl, wallHnd, gIntegerList, gPtrList, True, True);
                           end;
                        end;
                     end;
                  end;
               end;
            end;
            gc_trigger_action_order_attackZone : begin
               if (gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount>0) then
               begin
                  var posx, posz : Float;
                  _misc_GetUnitsListCentralPosExt(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, gc_statetag_essential_none);
                  var trgx : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].x;
                  var trgz : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].y;
                  var angle : Float = _misc_GetAngleToXVector(posx, posz, trgx, trgz);
                  var dirx : Float = 1;
                  var diry, dirz : Float;
                  VectorRotateY(dirx, diry, dirz, angle);
                  var pobj : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0));
                  if (pobj<>nil) then
                  _player_SetUnitsPosition(TObj(pobj).pl, gc_obj_order_move_mode_attack, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, trgx, trgz, dirx, dirz);
               end;
            end;
            gc_trigger_action_order_setDirectionToZone : begin
               if (gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount>0) then
               begin
                  var posx, posz : Float;
                  _misc_GetUnitsListEndPointCentralPos(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz);
                  var movemode : Integer = _misc_GetUnitsListMoveMode(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist);
                  var trgx : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].x;
                  var trgz : Float = gScenario.zones[TScenarioTriggerAction(ptriggeraction).zoneid].y;
                  var angle : Float = _misc_GetAngleToXVector(posx, posz, trgx, trgz);
                  var dirx : Float = 1;
                  var diry, dirz : Float;
                  VectorRotateY(dirx, diry, dirz, angle);
                  var pobj : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0));
                  if (pobj<>nil) then
                  _player_SetUnitsPosition(TObj(pobj).pl, movemode, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, dirx, dirz);
               end;
            end;
            gc_trigger_action_order_setDirectionToAngle : begin
               if (gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount>0) then
               begin
                  var angle : Float = TScenarioTriggerAction(ptriggeraction).direction;
                  var posx, posz : Float;
                  _misc_GetUnitsListEndPointCentralPos(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz);
                  var movemode : Integer = _misc_GetUnitsListMoveMode(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist);
                  var dirx : Float = 1;
                  var diry, dirz : Float;
                  VectorRotateY(dirx, diry, dirz, -angle);
                  var pobj : Pointer = _unit_GetTObj(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(0));
                  if (pobj<>nil) then
                  _player_SetUnitsPosition(TObj(pobj).pl, movemode, gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, dirx, dirz);
               end;
            end;
            gc_trigger_action_order_runUpgrade : begin
               gIntegerList.Clear;
               var k : Integer;
               for k:=0 to gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist.Get(k);
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (pobj<>nil) then
                  begin
                     if (TObj(pobj).cid=TScenarioTriggerAction(ptriggeraction).countryid) then
                     gIntegerList.Add(goHnd);
                  end;
               end;
               if (gIntegerList.GetCount>0) then
               begin
                  var plHnd : Integer = GetGameObjectPlayerHandleByHandle(gIntegerList.Get(0));
                  _unit_MakeUpgrade(plHnd, gIntegerList, TScenarioTriggerAction(ptriggeraction).upgradeid, True, True);
               end;
            end;
            gc_trigger_action_order_doExtractFood, gc_trigger_action_order_doExtractWood, gc_trigger_action_order_doExtractStone : begin
               var restype : Integer;
               case TScenarioTriggerAction(ptriggeraction).id of
                  gc_trigger_action_order_doExtractFood : restype := gc_resource_type_food;
                  gc_trigger_action_order_doExtractWood : restype := gc_resource_type_wood;
                  gc_trigger_action_order_doExtractStone : restype := gc_resource_type_stone;
               end;
               var posx, posz : Float;
               if (_misc_GetUnitsListCentralPosExt(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, gc_statetag_essential_none)) then
               begin
                  _player_OrderUnitsListToGainRes(gScenario.groups[TScenarioTriggerAction(ptriggeraction).groupid].unitslist, posx, posz, restype, True)
               end;
            end;
            gc_trigger_action_order_findAndAttackEnemyInZone : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var zoneid : Integer = TScenarioTriggerAction(ptriggeraction).zoneid;
               if (gScenario.groups[groupid].unitslist.GetCount>0) then
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(0);
                  if (goHnd<>0) then
                  begin
                     var groupx, groupy : Float;
                     _misc_GetUnitsListCentralPosExt(gScenario.groups[groupid].unitslist, groupx, groupy, gc_statetag_essential_none);
                     
                     var pobj : Pointer = _unit_GetTObj(goHnd);
                     var enemyplmask : Integer = gPlayer[TObj(pobj).pl].enemyplmask;
                     var killmask : Integer = gObjProp[TObj(pobj).cid][TObj(pobj).id].kmask;
                     var cellx, celly, cellxmax, cellymax : Integer;
                     
                     var left, top : Integer;
                     // -2 +2 fix bug when find and attack cant find enemy when he came in zone, cause of floor/roundup of - values fault
                     _misc_PosToScanGridIndices(gScenario.zones[zoneid].x-_misc_RoundUp(gScenario.zones[zoneid].w/2)-2, gScenario.zones[zoneid].y-_misc_RoundUp(gScenario.zones[zoneid].h/2)-2, left, top);
                     var right : Integer = left+_misc_RoundUp((gScenario.zones[zoneid].w+2+gc_scangrid_size)/gc_scangrid_size);
                     var bottom : Integer = top+_misc_RoundUp((gScenario.zones[zoneid].h+2+gc_scangrid_size)/gc_scangrid_size);
                     if (left<0) then left := 0
                     else if (left>=gc_scangrid_countx) then left := gc_scangrid_countx-1;
                     if (right<0) then right := 0
                     else if (right>=gc_scangrid_countx) then right := gc_scangrid_countx-1;
                     if (top<0) then top := 0
                     else if (top>=gc_scangrid_county) then top := gc_scangrid_county-1;
                     if (bottom<0) then bottom := 0
                     else if (bottom>=gc_scangrid_county) then bottom := gc_scangrid_county-1;
                     
                     var mindst : Float = -1;
                     var bestx, besty : Float;
                     var ix, iy : Integer;
                     for ix:=left to right do
                     for iy:=top to bottom do
                     begin
                        var plmask : Integer = gScanGrid[ix,iy].fPlMask;
                        var bisenemy : Boolean = (enemyplmask and plmask<>0);
                        if (bisenemy) then
                        begin
                           var count : Integer;
                           var pl : Integer;
                           for pl:=0 to gc_MaxPlayerCount-1 do
                           begin
                              if ((enemyplmask and (1 shl pl))<>0) then
                              count := count+gScanGrid[ix,iy].fPlCount[pl];
                           end;
                           if (count>0) then
                           begin
                              var cellrx, cellry : Float;
                              _misc_ScanGridIndicesToPos(ix, iy, cellrx, cellry);
                              var length : Float = VectorDistance(groupx, 0, groupy, cellrx, 0, cellry);
                              var dst : Float = length/(count/10);
                              if (dst<mindst) or (mindst<0) then
                              begin
                                 mindst := dst;
                                 bestx := cellrx;
                                 besty := cellry;
                              end;
                           end;
                        end;
                     end;
                     if (mindst>0) then
                     begin
                        var angle : Float = _misc_GetAngleToXVector(groupx, groupy, bestx, besty);
                        var dirx : Float = 1;
                        var diry, dirz : Float;
                        VectorRotateY(dirx, diry, dirz, angle);
                        _player_SetUnitsPosition(TObj(pobj).pl, gc_obj_order_move_mode_attack, gScenario.groups[groupid].unitslist, bestx, besty, dirx, dirz);
                     end;
                  end;
               end;
            end;
            gc_trigger_action_order_dismissSquadsInGroup : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var k : Integer;
               for k:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(k);
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (pobj<>nil) then
                  begin
                     if (TObj(pObj).squad>=0) then
                     begin
                        var plHnd : Integer = GetPlayerHandleByIndex(TObj(pObj).pl);
                        _misc_DisbandSquad(plHnd, TObj(pObj).squad, true);
                     end;
                  end;
               end;
            end;
            gc_trigger_action_order_ArtilleryAttackZoneCenterWithDispertion : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var zoneid : Integer = TScenarioTriggerAction(ptriggeraction).zoneid;
               var radius : Float = TScenarioTriggerAction(ptriggeraction).radius;
               var k : Integer;
               for k:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(k);
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (pobj<>nil) and (_misc_GetUnitType(goHnd)=gc_result_unittype_art) then
                  begin
                     var dx, dy, dz : Float;
                     _weapon_CalcShotDispertion(goHnd, radius, gScenario.zones[zoneid].x, 0, gScenario.zones[zoneid].y, dx, dy, dz);
                     _unit_OrderAttackPoint(goHnd, dx, dz, False, True);
                  end;
               end;
            end;
            gc_trigger_action_order_goInside : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var groupidtrg : Integer = TScenarioTriggerAction(ptriggeraction).groupidtrg;
               if (gScenario.groups[groupidtrg].unitslist.GetCount>0) and (gScenario.groups[groupid].unitslist.GetCount>0) then
               begin
                  var plHnd : Integer = GetGameObjectPlayerHandleByHandle(gScenario.groups[groupid].unitslist.Get(0));
                  var plInd : Integer = GetPlayerIndexByHandle(plHnd);
                  var trgHnd : Integer;
                  trgHnd := gScenario.groups[groupidtrg].unitslist.Get(0);
                  
                  gPtrList.Clear;
                  if (trgHnd<>0) and (_unit_UnitsCanGoInside(trgHnd, gScenario.groups[groupid].unitslist, gPtrList)) then
                  _player_OrderUnitsToGoInside(plInd, gScenario.groups[groupid].unitslist, gPtrList, trgHnd, True, true);
               end;
            end;
            gc_trigger_action_gate_gateOpen : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var k : Integer;
               for k:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(k);
                  _unit_SetTagStates(goHnd, gc_statetag_visual_stage_0);
               end;
            end;
            gc_trigger_action_gate_gateClose : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var k : Integer;
               for k:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(k);
                  _unit_SetTagStates(goHnd, gc_statetag_visual_none);
               end;
            end;
            gc_trigger_action_ferry_goOutside : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var bPicked : Boolean;
               gIntegerList.Clear;
               var k : Integer;
               for k:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(k);
                  var pObjInside : Pointer = _misc_GetObjectArgData(goHnd, gc_argunit_inside);
                  if (pObjInside<>nil) then
                  begin
                     var pobj : Pointer = _unit_GetTObj(goHnd);
                     var pObjProp : Pointer = _unit_GetObjProp(goHnd);
                     if (pObj<>nil) and (pObjProp<>nil) and ((TObjProp(pObjProp).transport=0) or (TObj(pobj).brally)) then
                     begin
                        bPicked := bPicked or GetGameObjectPickedByHandle(goHnd);
                        var m : Integer;
                        for m:=TIntegerList(pobjinside).GetCount-1 downto 0 do
                        begin
                           var unitHnd : Integer = TIntegerList(pobjinside).Get(m);
                           var pobjunit : Pointer = _unit_GetTObj(unitHnd);
                           if (not TObj(pobjunit).bLeaveRequested) then
                           gIntegerList.Add(unitHnd);
                        end;
                     end;
                  end;
               end;
               if (gIntegerList.GetCount>0) then
               begin
                  _unit_DoUnitsGoOutside(gIntegerList, false, true);
                  if (bPicked) then
                  gbool_gui_update_unitcontrol := True;
               end;
            end;
            gc_trigger_action_endgame_win : begin
               gPlayer[myplind].victorystate := gc_player_victorystate_win;
               if (gPlayer[myplind].victorystategametime=0) then
               gPlayer[myplind].victorystategametime := GetGameTime;

               //if (gMap.bbattle) and (_net_IsOnline) then
               //gInterface.gamemode := gc_gamemode_spectator;
               var p : Pointer = _misc_GetOrCreateCampaignMissionProgressPointer(gScenario.campname, gScenario.missname);
               if (p<>nil) then
               begin
                  if (TCampaignProgress(p).started=0) then
                  TCampaignProgress(p).started := 1;
                  TCampaignProgress(p).finished := Min(TCampaignProgress(p).finished+1, TCampaignProgress(p).started);
                  TCampaignProgress(p).maxfinishdifficulty := Max(TCampaignProgress(p).maxfinishdifficulty, gScenario.difficulty);
                  
                  var sind : String = SubStr(gScenario.missname, StrLength(gScenario.missname), 1);
                  var misind : Integer = StrToInt(sind);
                  case gScenario.campname of
                     'auscam' : begin
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalaus].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalaus].cur or (1 shl misind);
                        if (TCampaignProgress(p).maxfinishdifficulty=gc_player_difficulty_veryhard) then
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalaus_impossible].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalaus_impossible].cur or (1 shl misind);
                     end;
                     'engcam' : begin
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finaleng].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finaleng].cur or (1 shl misind);
                        if (TCampaignProgress(p).maxfinishdifficulty=gc_player_difficulty_veryhard) then
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finaleng_impossible].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finaleng_impossible].cur or (1 shl misind);
                     end;
                     'fracam' : begin
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalfra].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalfra].cur or (1 shl misind);
                        if (TCampaignProgress(p).maxfinishdifficulty=gc_player_difficulty_veryhard) then
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalfra_impossible].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalfra_impossible].cur or (1 shl misind);
                     end;
                     'ukrcam' : begin
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalukr].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalukr].cur or (1 shl misind);
                        if (TCampaignProgress(p).maxfinishdifficulty=gc_player_difficulty_veryhard) then
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalukr_impossible].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalukr_impossible].cur or (1 shl misind);
                     end;
                     'ruscam' : begin
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalrus].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalrus].cur or (1 shl misind);
                        if (TCampaignProgress(p).maxfinishdifficulty=gc_player_difficulty_veryhard) then
                        gProfileUserStruct.achs.ach[gc_ach_campaign_finalrus_impossible].cur := gProfileUserStruct.achs.ach[gc_ach_campaign_finalrus_impossible].cur or (1 shl misind);
                     end;
                     'tutcam' : begin
                        if (misind=1) then
                        gProfileUserStruct.achs.ach[gc_ach_camp_tutmis1_fin].cur := gProfileUserStruct.achs.ach[gc_ach_camp_tutmis1_fin].cur+1
                        else
                        if (misind=2) then
                        gProfileUserStruct.achs.ach[gc_ach_camp_tutmis2_fin].cur := gProfileUserStruct.achs.ach[gc_ach_camp_tutmis2_fin].cur+1;
                     end;
                  end;
                  _profile_SaveStructToUserProfileParser('gProfileUserStruct');
               end;
            end;
            gc_trigger_action_endgame_lose : begin
               gPlayer[myplind].victorystate := gc_player_victorystate_lose;
               if (gPlayer[myplind].victorystategametime=0) then
               gPlayer[myplind].victorystategametime := GetGameTime;

               //if (gMap.bbattle) and (_net_IsOnline) then
               //gInterface.gamemode := gc_gamemode_spectator;
               var p : Pointer = _misc_GetOrCreateCampaignMissionProgressPointer(gScenario.campname, gScenario.missname);
               if (p<>nil) then
               begin
                  if (TCampaignProgress(p).started=0) then
                  TCampaignProgress(p).started := 1;
                  TCampaignProgress(p).lose := Min(TCampaignProgress(p).lose+1, TCampaignProgress(p).started);
                  TCampaignProgress(p).maxfinishdifficulty := Max(TCampaignProgress(p).maxfinishdifficulty, gScenario.difficulty);
                  _profile_SaveStructToUserProfileParser('gProfileUserStruct');
               end;
            end;
            gc_trigger_action_advanced_ifThenElse : begin
               log('todo : gc_trigger_action_advanced_ifThenElse');
            end;
            gc_trigger_action_advanced_enableTrigger : begin
               if (not gScenario.triggers[TScenarioTriggerAction(ptriggeraction).triggerid].bactive) then
               begin
                  gScenario.triggers[TScenarioTriggerAction(ptriggeraction).triggerid].bactive := True;
                  //_scenario_UpdateAIRegionsActiveStateToTriggers(gScenario); // done after progress
               end;
            end;
            gc_trigger_action_advanced_disableTrigger : begin
               if (gScenario.triggers[TScenarioTriggerAction(ptriggeraction).triggerid].bactive) then
               begin
                  gScenario.triggers[TScenarioTriggerAction(ptriggeraction).triggerid].bactive := False;
                  //_scenario_UpdateAIRegionsActiveStateToTriggers(gScenario); // done after progress
               end;
            end;
            gc_trigger_action_advanced_enableThisTrigger : begin
               TScenarioTrigger(ptrigger).bactive := True;
            end;
            gc_trigger_action_service_DebugLog : Log('trigger action debug log : name='+TScenarioTrigger(ptrigger).name);
            gc_trigger_action_service_DebugMessage : Log('trigger action debug message : name='+TScenarioTrigger(ptrigger).name);
            gc_trigger_action_save_save : begin
               var name : String;
               if (gMap.name<>'') then
               name := gMap.name
               else
               name := 'camp';
               var filename : String = name+'.map';
               //_misc_SaveMap(filename, True);
               if GetGUIDelayExecuteState='' then begin
                  gbool_gui_quicksave := false;
                  gstring_gui_saving := filename;
                  GUIDelayExecuteState('DoAutoSave', 3);
               end;
            end;
            gc_trigger_action_save_load : begin
               var name : String;
               if (gMap.name<>'') then
               name := gMap.name
               else
               name := 'camp';
               var filename : String = name+'.autosave.1.map';
               _misc_LoadMap(filename);
            end;
            gc_trigger_action_advanced_executeState : begin
               var smHnd : Integer = GetTriggerManagerStateMachineHandle('trigger0');
               if (smHnd<>0) then
               begin
                  var statename : String = TScenarioTriggerAction(ptriggeraction).executestate;
                  IntRegister0 := gScenario.counters[TScenarioTriggerAction(ptriggeraction).counterid].value;
                  StringRegister0 := TScenarioTriggerAction(ptriggeraction).stringregister;
                  StateMachineExecuteState(smHnd, statename, 0);
               end;
            end;
            gc_trigger_action_advanced_ExecuteTriggerActions : begin
               var ptriggerTrg : Pointer = gScenario.triggers[TScenarioTriggerAction(ptriggeraction).triggerid];
               _scenario_EvaluateTriggerActions(ptriggerTrg);
            end;
            gc_trigger_action_objective_PlaceMarkerInZone : begin
               var zoneid : Integer = TScenarioTriggerAction(ptriggeraction).zoneid;
               var x : Float = gScenario.zones[zoneid].x;
               var z : Float = gScenario.zones[zoneid].y;
               var miscplhnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
               var markerbasename : String = gConstScenarioMarkers[TScenarioTriggerAction(ptriggeraction).marker];
               var hnd : Integer = CreatePlayerGameObjectHandleByHandle(miscplhnd, gc_racename_misc, markerbasename, x, 0, z);
               //_misc_ApplyKeyColorRecursiveChild(hnd, gMap.players[pl].color); // apply some color in future
            end;
            gc_trigger_action_objective_RemoveMarkerInZone : begin
               var zoneid : Integer = TScenarioTriggerAction(ptriggeraction).zoneid;
               var x : Float = gScenario.zones[zoneid].x;
               var z : Float = gScenario.zones[zoneid].y;
               var miscplhnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
               GetGameObjectsInRadius(x, z, gc_epsilon, false, false, miscplhnd, -1, 0, false, false, false, false, false, false);
               var i, j : Integer;
               for i:=GetGameObjectListCount-1 downto 0 do
               begin
                  var goHnd : Integer = GetGameObjectListByIndex(i);
                  var basename : String = GetGameObjectBaseNameByHandle(goHnd);
                  for j:=0 to gc_scenario_marker_count-1 do
                  begin
                     if (gConstScenarioMarkers[j]=basename) then
                     GameObjectRequestToDestroyByHandle(goHnd);
                     //GameObjectDestroyByHandle(goHnd);
                  end;
               end;
            end;
            gc_trigger_action_objective_AddMarkerToGroup : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var miscplhnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
               var markerbasename : String = gConstScenarioMarkers[TScenarioTriggerAction(ptriggeraction).marker];
               var i : Integer;
               for i:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(i);
                  var hnd : Integer = CreatePlayerGameObjectHandleByHandle(miscplhnd, gc_racename_misc, markerbasename, GetGameObjectPositionXByHandle(goHnd), 0, GetGameObjectPositionZByHandle(goHnd));
                  GameObjectParentToChildAbsolute(hnd, goHnd);
                  //_misc_ApplyKeyColorRecursiveChild(hnd, gMap.players[pl].color); // apply some color in future
               end;
            end;
            gc_trigger_action_objective_RemoveMarkerFromGroup : begin
               var groupid : Integer = TScenarioTriggerAction(ptriggeraction).groupid;
               var miscplhnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
               var i, j, k : Integer;
               for i:=0 to gScenario.groups[groupid].unitslist.GetCount-1 do
               begin
                  var goHnd : Integer = gScenario.groups[groupid].unitslist.Get(i);
                  for j:=GetGameObjectCountChildByHandle(goHnd)-1 downto 0 do
                  begin
                     var hnd : Integer = GetGameObjectGOHandleChildByHandle(goHnd, j);
                     if (GetGameObjectRaceTag(hnd)=gc_racetag_misc) then
                     begin
                        var basename : String = GetGameObjectBaseNameByHandle(hnd);
                        for k:=0 to gc_scenario_marker_count-1 do
                        begin
                           if (gConstScenarioMarkers[k]=basename) then
                           begin
                              var bHnd : Integer = GetBehaviourByClassName(goHnd, 'TXTLFAnimationBehaviour');
                              if (bHnd<>0) then
                              SetBehaviourIntProperty(bHnd, 'RemoveAndDestroyObject', hnd)
                              else
                              GameObjectRequestToDestroyByHandle(hnd);
                           end;
                           //GameObjectDestroyByHandle(hnd);
                        end;
                     end;
                  end;
               end;
            end;
            gc_trigger_action_net_SetTriggerActive : begin
               if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var triggerid : Integer = TScenarioTriggerAction(ptriggeraction).triggerid;
                  var bstate : Boolean = TScenarioTriggerAction(ptriggeraction).bstate;
                  gScenario.triggers[triggerid].bactive := bstate;
               end;
            end;
            gc_trigger_action_net_SetFlagState : begin
               if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var flagid : Integer = TScenarioTriggerAction(ptriggeraction).flagid;
                  var bstate : Boolean = TScenarioTriggerAction(ptriggeraction).bstate;
                  gScenario.flags[flagid].bactive := bstate;
               end;
            end;
            gc_trigger_action_net_SetCounterValue : begin
               if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var counterid : Integer = TScenarioTriggerAction(ptriggeraction).counterid;
                  var amount : Integer;
                  if (TScenarioTriggerAction(ptriggeraction).busecounterasamount) then
                  amount := gScenario.counters[TScenarioTriggerAction(ptriggeraction).usecounterid].value
                  else
                  amount := TScenarioTriggerAction(ptriggeraction).amount;
                  gScenario.counters[counterid].value := amount;
               end;
            end;
            gc_trigger_action_net_ExecuteTriggerActions : begin
               if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var triggerid : Integer = TScenarioTriggerAction(ptriggeraction).triggerid;
                  var ptrigger : Pointer = gScenario.triggers[triggerid];
                  _scenario_EvaluateTriggerActions(ptrigger);
               end;
            end;
            gc_trigger_action_net_TeamSetTriggerActive : begin
               if (gMap.players[TScenarioTriggerAction(ptriggeraction).player].team=gMap.players[myplind].team) then
               //if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var triggerid : Integer = TScenarioTriggerAction(ptriggeraction).triggerid;
                  var bstate : Boolean = TScenarioTriggerAction(ptriggeraction).bstate;
                  gScenario.triggers[triggerid].bactive := bstate;
               end;
            end;
            gc_trigger_action_net_TeamSetFlagState : begin
               if (gMap.players[TScenarioTriggerAction(ptriggeraction).player].team=gMap.players[myplind].team) then
               //if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var flagid : Integer = TScenarioTriggerAction(ptriggeraction).flagid;
                  var bstate : Boolean = TScenarioTriggerAction(ptriggeraction).bstate;
                  gScenario.flags[flagid].bactive := bstate;
               end;
            end;
            gc_trigger_action_net_TeamSetCounterValue : begin
               if (gMap.players[TScenarioTriggerAction(ptriggeraction).player].team=gMap.players[myplind].team) then
               //if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var counterid : Integer = TScenarioTriggerAction(ptriggeraction).counterid;
                  var amount : Integer;
                  if (TScenarioTriggerAction(ptriggeraction).busecounterasamount) then
                  amount := gScenario.counters[TScenarioTriggerAction(ptriggeraction).usecounterid].value
                  else
                  amount := TScenarioTriggerAction(ptriggeraction).amount;
                  gScenario.counters[counterid].value := amount;
               end;
            end;
            gc_trigger_action_net_TeamExecuteTriggerActions : begin
               if (gMap.players[TScenarioTriggerAction(ptriggeraction).player].team=gMap.players[myplind].team) then
               //if (TScenarioTriggerAction(ptriggeraction).player=myplind) then
               begin
                  var triggerid : Integer = TScenarioTriggerAction(ptriggeraction).triggerid;
                  var ptrigger : Pointer = gScenario.triggers[triggerid];
                  _scenario_EvaluateTriggerActions(ptrigger);
               end;
            end;
            gc_trigger_action_net_SetCounterSpecialValue : begin
               if (myplind>=0) and (myplind<gc_MaxPlayerCount) then
               begin
                  //var player : Integer = TScenarioTriggerAction(ptriggeraction).player;
                  var counterid : Integer = TScenarioTriggerAction(ptriggeraction).counterid;
                  var amount : Integer = TScenarioTriggerAction(ptriggeraction).amount;
                  case amount of
                     0 : gScenario.counters[counterid].value := myplind;
                     1 : gScenario.counters[counterid].value := gMap.players[myplind].team;
                     2 : gScenario.counters[counterid].value := gMap.players[myplind].cid;
                     3 : begin
                        var count : Integer;
                        var i : Integer;
                        for i:=0 to gc_MaxPlayerCount-1 do
                        if (gMap.players[i].team=1) then
                        count := count+1;
                        gScenario.counters[counterid].value := count;
                     end;
                     4 : begin
                        var count : Integer;
                        var i : Integer;
                        for i:=0 to gc_MaxPlayerCount-1 do
                        count := count+1;
                        gScenario.counters[counterid].value := count;
                     end;
                  end;
               end;
            end;
         end;
      end;
   end;
   if (bupdateally) then
   begin
      var plIO : Integer = GetPlayerIndexByHandle(GetPlayerHandleInterfaceIO);
      _player_UpdateFOW(plIO);
      _misc_UpdateMiniMapPrimitives(False);
   end;
end;

function _scenario_GetSelectedGroupIndex() : Integer;
begin
   var selind : Integer = -1;
   var i, j : Integer;
   for i:=0 to gc_scenario_maxgroups-1 do
   begin
      for j:=gScenario.groups[i].unitslist.GetCount-1 downto 0 do
      begin
         var goHnd : Integer = gScenario.groups[i].unitslist.Get(j);
         if (GetGameObjectPickedByHandle(goHnd)) then
         begin
            if (selind<>-2) then
            begin
               if (selind<>-1) and (selind<>i) then
               selind := -2
               else
               selind := i;
            end;
         end;
      end;
   end;
   Result := selind;
end;
{procedure _scenario_RunConstructors;
begin
   var i : Integer;
   for i:=0 to gc_scenario_maxgroups-1 do
   begin
      gScenario.groups[i].unitslist.Create(SizeOf(Integer));
      gScenarioTmp.groups[i].unitslist.Create(SizeOf(Integer));
   end;
   for i:=0 to gc_scenario_maxzones-1 do
   begin
      gScenario.zones[i].unitslist.Create(SizeOf(Integer));
      gScenarioTmp.zones[i].unitslist.Create(SizeOf(Integer));
   end;
end;}
