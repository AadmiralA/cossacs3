procedure _scenario_CompileConditionText(var text : String; var condition : TScenarioTriggerCondition);
begin
   text := '';
   var base : String;
   _scenario_CompileConditionTextBase(base, condition.id);
   text := base;
   var textcolor : String = gc_font_color_orange;
   text := StrReplace(text, '%triggerid%', textcolor+gScenario.triggers[condition.triggerid].name+gc_font_color_default);
   text := StrReplace(text, '%flagid%', textcolor+gScenario.flags[condition.flagid].name+gc_font_color_default);
   text := StrReplace(text, '%counterid%', textcolor+gScenario.counters[condition.counterid].name+gc_font_color_default);
   text := StrReplace(text, '%timerid%', textcolor+gScenario.timers[condition.timerid].name+gc_font_color_default);
   text := StrReplace(text, '%groupid%', textcolor+gScenario.groups[condition.groupid].name+gc_font_color_default);
   text := StrReplace(text, '%zoneid%', textcolor+gScenario.zones[condition.zoneid].name+gc_font_color_default);
   text := StrReplace(text, '%resultid%', textcolor+gScenario.results[condition.resultid].name+gc_font_color_default);
   if condition.player>=0 then
   text := StrReplace(text, '%player%', textcolor+gScenario.players[condition.player].name+gc_font_color_default)
   else
   if condition.player=-1 then
   text := StrReplace(text, '%player%', textcolor+'All players'+gc_font_color_default)
   else
   if condition.player=-2 then
   text := StrReplace(text, '%player%', textcolor+'Server'+gc_font_color_default);
   text := StrReplace(text, '%difficulty%', textcolor+GetLocaleTableListItemByID('gui', 'difficulty.'+IntToStr(condition.difficulty+1))+gc_font_color_default);
   text := StrReplace(text, '%resource%', textcolor+GetLocaleTableListItemByID('gui', 'restype.'+IntToStr(condition.resource))+gc_font_color_default);
   text := StrReplace(text, '%amount%', textcolor+IntToStr(condition.amount)+gc_font_color_default);
   text := StrReplace(text, '%time%', textcolor+FloatToStr(condition.time)+gc_font_color_default);
   if (condition.bstate) then
   text := StrReplace(text, '%includebuildings%', textcolor+GetLocaleTableListItemByID('editor', 'triggereditor.flag.includebuildings')+gc_font_color_default)
   else
   text := StrReplace(text, '%includebuildings%', '');
   text := StrReplace(text, '%bstate%', textcolor+BoolToStr(condition.bstate)+gc_font_color_default);
   text := StrReplace(text, '%state%', textcolor+condition.executestate+gc_font_color_default);
   text := StrReplace(text, '%stringregister%', textcolor+condition.stringregister+gc_font_color_default);
   if (condition.counterid>-1) then
   text := StrReplace(text, '%countervalue%', textcolor+' ('+IntToStr(gScenario.counters[condition.counterid].value)+')'+gc_font_color_default);
   if (StrExists(text, '%sign%')) then
   begin
      var signtext : String;
      _scenario_CompileSignText(signtext, condition.sign, True);
      text := StrReplace(text, '%sign%', textcolor+signtext+gc_font_color_default);
   end;
end;

