begin
   // read from stream
   var typdst: Pointer=AddrToPointer(tpd);
   var typsrc: Pointer=AddrToPointer(tps);
   var addr  : Pointer=val;
   //LoadStreamTypeBase(fs, typdst, addr, nam, sm, false);
   MergeStreamTypeBase(fs, typdst, addr, nam, sm, false{useproc}, typsrc, cmp=1{compared});
   if (val.uniqrnd=0) then
   val.uniqrnd := random;
end;

// _serial_ObjSize
//
