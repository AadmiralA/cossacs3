//
// serial.script
//

// arg0 - file stream
// arg1 - data pointer
// arg2 - string name of variable
// arg3 - handle of statemachine
// arg4 - handle of destination TDSTypeBase
// arg5 - handle of source TDSTypeBase
// arg6 - compared
// procedure DoSerialize(const arg0, arg1, arg2, arg3, arg4: Pointer);
// procedure DoUnserialize(const arg0, arg1, arg2, arg3, arg4, arg5, arg6: Pointer);
// function  GetSerializeSize(const arg1, arg2, arg3, arg4: Pointer): Integer;
// procedure DoSeek(const arg0, arg2, arg3, arg4: Pointer);
// procedure DoPost(const arg1, arg2, arg3: Pointer);

// in ca.se of troubles on load check
// 1. if some global constant was changed, check reader/size/seek to use older const value by gSerialVersion
// 2. check places like SizeOf(val.) cause here can be hidden use of changed consts

global gDataVersion: Integer;
global gSerialVersion: Integer;
global gSerialMode: Integer; // 0 - none; 1 - serial; 2 - unserial;
global gSerialLoaded: Boolean;

gDataVersion:=92;
gSerialVersion:=gDataVersion;
gSerialMode:=0;
gSerialLoaded:=false;

// _serial_BeforeProcWriter
//
procedure _serial_BeforeProcWriter(const fs: Integer);
begin
   gSerialMode:=1;
   WriteInteger(fs, gDataVersion);
end;

// _serial_AfterProcWriter
//
procedure _serial_AfterProcWriter(const fs: Integer);
begin
end;

// _serial_FinalProcWriter
//
procedure _serial_FinalProcWriter(const fs: Integer);
begin
   gSerialMode:=0;
end;

// _serial_BeforeProcReader
//
procedure _serial_BeforeProcReader(const fs: Integer);
begin
   gSerialMode:=2;
   ReadInteger(fs, gSerialVersion);
end;

// _serial_AfterProcReader
//
procedure _serial_AfterProcReader(const fs: Integer);
begin
end;

// _serial_FinalProcReader
//
procedure _serial_FinalProcReader(const fs: Integer);
begin
   if gSerialVersion<53 then
   begin
      var breplay : Boolean = _net_IsReplay;
      if (not breplay) then
      begin
         var index : Integer = 8;
         if GetPlayerHandleByName('player'+IntToStr(index))=0 then
         begin
            var plhnd : Integer = CreatePlayerInsert('player'+IntToStr(index), gc_racename_units, 'cmPlayer', index);
            PlayerExecuteStateByHandle(plhnd, 'Initial');
            _player_ResetSaveLoadStates(plhnd);
            var i, j : Integer;
            for i:=0 to gc_MaxPlayerCount-1 do begin
               var myteam: Integer = gMap.players[i].team;
               for j:=0 to gc_MaxPlayerCount-1 do begin
                  if (i<>j) and ((i=index) or (j=index)) then begin
                     var histeam: Integer = gMap.players[j].team;
                     if(myteam<>histeam) or (histeam=0) or (myteam=0) then begin
                        gPlayer[i].enemyplmask:=gPlayer[i].enemyplmask or (1 shl j);
                        AddPlayerEnemyPlayerByHandle(GetPlayerHandleByIndex(i), GetPlayerHandleByIndex(j));
                     end else AddPlayerFriendPlayerByHandle(GetPlayerHandleByIndex(i), GetPlayerHandleByIndex(j));
                  end;
               end;
            end;
            for j:=0 to gc_ResCount-1 do
            case gMap.settings.gen.resourcestart of
               0: begin
                  _res_SetResToPlayerByIndex(index, j, 1000);
                  gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                  gPlayer[index].res[j] := gPlayer[index].setres[j];
               end;
               1: begin
                  _res_SetResToPlayerByIndex(index, j, 4000);
                  gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                  gPlayer[index].res[j] := gPlayer[index].setres[j];
               end;
               2: begin
                  _res_SetResToPlayerByIndex(index, j, 5000);
                  gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                  gPlayer[index].res[j] := gPlayer[index].setres[j];
               end
               else
               begin
                  _res_SetResToPlayerByIndex(index, j, 1000000);
                  gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                  gPlayer[index].res[j] := gPlayer[index].setres[j];
               end;
            end;
            var plpoolhnd : Integer = GetPlayerHandleByName(gc_plname_pool);
            if (plpoolhnd<>0) then
            AddPlayerEnemyPlayerByHandle(plpoolhnd, plhnd);
            var plmischnd : Integer = GetPlayerHandleByName(gc_plname_misc);
            if (plmischnd<>0) then
            AddPlayerEnemyPlayerByHandle(plmischnd, plhnd);
         end;
      end;
   end;
   var bSV88bug : Boolean;
   var envplhnd : Integer = GetPlayerHandleByName(gc_plname_env);
   var envplind : Integer = GetPlayerIndexByHandle(envplhnd);
   if (envplind<>gc_playerind_env) then
   begin
      var i : Integer;
      for i:=gc_MaxNonSpectatorsCount+1 to gc_MaxPlayerCount-1 do
      begin
         var plhnd : Integer = GetPlayerHandleByName('player'+IntToStr(i));
         if (plhnd<>0) then
         begin
            var plind : Integer = GetPlayerIndexByHandle(plhnd);
            if (plind<>i) or (bSV88bug) then
            begin
               DeletePlayerByHandle(plhnd);
               bSV88bug := True;
            end;
         end;
      end;
   end;

   if (gSerialVersion<89) or (bSV88bug) then
   begin
      var breplay : Boolean = _net_IsReplay;
      if (not breplay) then
      begin
         var pl : Integer;
         for pl:=(gc_MaxNonSpectatorsCount+1) to gc_MaxPlayerCount-1 do
         begin
            var index : Integer = pl;
            if GetPlayerHandleByName('player'+IntToStr(index))=0 then
            begin
               var plhnd : Integer = CreatePlayerInsert('player'+IntToStr(index), gc_racename_units, 'cmPlayer', index);
               PlayerExecuteStateByHandle(plhnd, 'Initial');
               _player_ResetSaveLoadStates(plhnd);
               var i, j : Integer;
               for i:=0 to gc_MaxPlayerCount-1 do begin
                  var myteam: Integer = gMap.players[i].team;
                  for j:=0 to gc_MaxPlayerCount-1 do begin
                     if (i<>j) and ((i=index) or (j=index)) then begin
                        var histeam: Integer = gMap.players[j].team;
                        if(myteam<>histeam) or (histeam=0) or (myteam=0) then begin
                           gPlayer[i].enemyplmask:=gPlayer[i].enemyplmask or (1 shl j);
                           AddPlayerEnemyPlayerByHandle(GetPlayerHandleByIndex(i), GetPlayerHandleByIndex(j));
                        end else AddPlayerFriendPlayerByHandle(GetPlayerHandleByIndex(i), GetPlayerHandleByIndex(j));
                     end;
                  end;
               end;
               for j:=0 to gc_ResCount-1 do
               case gMap.settings.gen.resourcestart of
                  0: begin
                     _res_SetResToPlayerByIndex(index, j, 1000);
                     gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                     gPlayer[index].res[j] := gPlayer[index].setres[j];
                  end;
                  1: begin
                     _res_SetResToPlayerByIndex(index, j, 4000);
                     gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                     gPlayer[index].res[j] := gPlayer[index].setres[j];
                  end;
                  2: begin
                     _res_SetResToPlayerByIndex(index, j, 5000);
                     gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                     gPlayer[index].res[j] := gPlayer[index].setres[j];
                  end
                  else
                  begin
                     _res_SetResToPlayerByIndex(index, j, 1000000);
                     gPlayer[index].lanres[j] := gPlayer[index].setres[j];
                     gPlayer[index].res[j] := gPlayer[index].setres[j];
                  end;
               end;
               var plpoolhnd : Integer = GetPlayerHandleByName(gc_plname_pool);
               if (plpoolhnd<>0) then
               AddPlayerEnemyPlayerByHandle(plpoolhnd, plhnd);
               var plmischnd : Integer = GetPlayerHandleByName(gc_plname_misc);
               if (plmischnd<>0) then
               AddPlayerEnemyPlayerByHandle(plmischnd, plhnd);
            end;
         end;
      end;
   end;
   
   if (bSV88bug) then
   begin
      _res_ResGridClear;
      _res_ResGridResetEnvironment;
   end;

   var i, j, k : Integer;
   for i:=0 to gc_MaxPlayerCount-1 do
   begin
      var plHnd : Integer = GetPlayerHandleByIndex(i);
      if (gSerialVersion<9) then
      begin
         var cid, id : Integer;
         for cid:=0 to gc_MaxCountryCount-1 do
         for id:=0 to gc_country_maxmembers-1 do
         begin
            var objprop : Pointer = gObjProp[cid][id];
            var wind : Integer;
            for wind:=0 to gc_obj_MaxWeapon-1 do
            begin
               if (TObjProp(objprop).weapon[wind].enabled) then
               begin
                  if (TObjProp(objprop).weapon[wind].weaponsid<>'') then
                  TObjProp(objprop).weapon[wind].weaponid := _weapon_GetWeaponIdBySID(TObjProp(objprop).weapon[wind].weaponsid);
               end;
            end;
         end;
      end;
      if (gSerialVersion<15) then
      begin
         _res_ResGridClear;
         _res_ResGridResetEnvironment;
      end;
      
      var grHnd : Integer = GetPlayerGrHandleByHandle(plHnd, gc_group_selected);
      SetGroupCollisionPriorityByHandle(grHnd, gc_collisiontag_stretchland);
      SetGroupTestPriorityOptionByHandle(grHnd, gc_TestPriorityOption_Land);
      
      for j := gPlayer[i].squads.GetCount-1 downto 0 do
      begin
         var pSquad : Pointer = gPlayer[i].squads.Get(j);
         _squad_SetGroupCollisionOptions(pSquad);
      end;
      
      if gPlayer[i].bai then
      _ai_InitInitialLists(i);
   end;

   if (gSerialVersion<20) then
   begin
      var miscplhnd : Integer = GetPlayerHandleByName(gc_racename_misc);
      if (miscplhnd<>0) then
      begin
         for i:=0 to gc_MaxPlayerCount-1 do
         AddPlayerEnemyPlayerByHandle(miscplhnd, GetPlayerHandleByIndex(i));
      end;
   end;

   if gSerialVersion<26 then
   begin
      gbool_peacemode := false;
      gfloat_peacetime := 0;
      
      for i := 0 to gc_scangrid_countx-1 do
      for j := 0 to gc_scangrid_county-1 do
      begin
         gScanGrid[i, j].owner := -1;
         gScanGrid[i, j].dist := 0;
      end;
   end;

   if gSerialVersion<28 then
   gWallSystem.Clear;

   if gSerialVersion<31 then
   begin
      var w : Integer = GetMapWidth;
      var h : Integer = GetMapHeight;
      var isWater : Boolean;
      
      for j := 0 to 2*w-1 do
      for k := 0 to 2*h-1 do
      begin
         var x : Float = (j-w)/2;
         var y : Float = (k-h)/2;
         if GetMapCollisionTag(x, y, false) = 200 then
         begin
            MapDrawCollision(x, y, gc_collisiontag_water, 0, false);
            isWater := true;
         end;
      end;
      
      if isWater then
      _misc_SetShoresCollision;
   end;

   //if gSerialVersion<33 then
   if gSerialVersion<55 then
   _player_FixPlayersUpgStateBadIndexes; // fix old mission upgstate indexes

   if gSerialVersion<34 then
   _misc_BuildIslandsGrid;

   if gSerialVersion<35 then
   _misc_CalcIslandShores;

   if gSerialVersion<36 then
   _player_FixGameObjectsWallVariations; // arg_obj.wallvariation

   if gSerialVersion<40 then
   begin
      _player_FixGameObjectsChildLODActorName;
      for i:=0 to gc_MaxPlayerCount-1 do
      begin
         for j:=0 to gPlayer[i].squads.GetCount-1 do
         begin
            var pSquad : Pointer = gPlayer[i].squads.Get(j);
            if (pSquad<>nil) then
            TSquad(pSquad).fUID := j;
         end;
         gPlayer[i].squads.fNextUID := gPlayer[i].squads.GetCount;
      end;
      
      _player_FixPortBuiChildren;
      _player_FixPlayerLists;
      if (gScenario.bexists) then
      _player_FixRallyPos;
   end;

   if (gSerialVersion<41) and (gScenario.bexists) then
   begin
      for i:=0 to gc_MaxPlayerCount-1 do
      begin
         var plHnd : Integer = GetPlayerHandleByIndex(i);
         for j:=gPlayer[i].squads.GetCount-1 downto 0 do
         begin
            var psquad : Pointer = gPlayer[i].squads.Get(j);
            if (psquad<>nil) then
            begin
               var posx, posz, dirx, dirz : Float;
               _squad_GetCentralPosAndDir(psquad, posx, posz, dirx, dirz);
               _player_SetSquadPosition(plHnd, j, posx, posz, dirx, dirz, False, True, gc_obj_order_move_mode_default, True);
               _player_StopSquad(i, j);
            end;
         end;
      end;
   end;

   if (gSerialVersion<42) then
   _player_FixGameObjects(gSerialVersion);

   if (gSerialVersion<43) and (gScenario.bexists) then
   _player_FixPlayersCounters;

   if (gSerialVersion<47) then
   begin
      for i:=0 to gc_MaxPlayerCount-1 do
      begin
         for j:=gPlayer[i].aiData.agressors.GetCount-1 downto 0 do
         if (_unit_IsOfficerOrDrummer(gPlayer[i].aiData.agressors.Get(j))) then
         begin
            Log('Fix: officers removed from aggresors list');
            gPlayer[i].aiData.agressors.Delete(j);
         end;
      end;
   end;

   if (gSerialVersion<48) then
   _player_FixInvalidHandlesInLists(True);

   if (gSerialVersion<49) and (gScenario.bexists) then
   gMap.players[5].color := 13;

   if (gSerialVersion<50) then
   begin
      if (GetPlayerHandleByName(gc_plname_pool)=0) then begin
         var hnd: Integer=CreatePlayerInsert(gc_plname_pool, gc_racename_misc, 'cmPC', gc_playerind_pool);
         _player_ResetSaveLoadStates(hnd);
         var i : Integer;
         for i:=0 to gc_MaxPlayerCount-1 do
         AddPlayerEnemyPlayerByHandle(hnd, GetPlayerHandleByIndex(i));
      end;
   end;

   if (gSerialVersion<89) then
   begin
      _res_ResGridClear;
      _res_ResGridResetEnvironment;
   end;

   //if (gSerialVersion<53) then
   //begin
   //   _res_ResGridClear;
   //   _res_ResGridResetEnvironment;
   //end;

   if (gSerialVersion<54) and (gScenario.bexists) and (not gScenario.bactive) then
   begin
      var i : Integer;
      for i:=CountOfAIRegions-1 downto 0 do
      DeleteAIRegionByIndex(i);
      _scenario_UpdateAIRegions(gScenario);
   end;

   //if (gSerialVersion<63) and (gScenario.bexists) then
   //begin
   //   Log('_serial_FinalProcReader : gSerialVersion<63 and gScenario.bexists : ResGrid Clear and ResetEnvironment');
   //   _res_ResGridClear;
   //   _res_ResGridResetEnvironment;
   //end;

   if (gSerialVersion>68) and (gSerialVersion<72) and (gScenario.bexists) and (not gScenario.bactive) then
   begin
      _player_ReInitAllPlayersBaseObj;
      _player_FixRallyPos;
      if GetCountOfPlayers>=gc_MaxPlayerCount then
      begin
         var pl, i : Integer;
         for [MAIN]pl:=0 to gc_MaxPlayerCount-1 do
         begin
            var plHnd : Integer = GetPlayerHandleByIndex(pl);
            for i:=0 to GetPlayerGameObjectsCountByHandle(plHnd)-1 do
            begin
               var goHnd : Integer = GetGameObjectHandleByIndex(i, plHnd);
               if (_misc_GetBaseObjID(goHnd)=gc_baseid_obj) then
               begin
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (not TObj(pobj).bdead) and (TObj(pobj).hp>0) then
                  TObj(pobj).hp := gPlayer[pl].objbase[TObj(pobj).cid][TObj(pobj).id].maxhp;
               end;
            end;
         end;
      end;
      var pl, cid, upgid : Integer;
      for pl:=0 to gc_MaxPlayerCount-1 do
      for cid:=0 to gc_MaxCountryCount-1 do
      for upgid:=0 to gc_country_maxupgradecount-1 do
      begin
         _player_ClearUpgradeState(gPlayer[pl].upgstate[cid][upgid]);
         gPlayer[pl].upgstate[cid][upgid].sid := gCountry[cid].upgrade[upgid].id;
         gPlayer[pl].upgstate[cid][upgid].enabled := gCountry[cid].upgrade[upgid].enabled;
      end;
   end;

   if (gSerialVersion<74) and (gScenario.bexists) and (not gScenario.bactive) then // fix balance changes in old campaign maps after rebalance patch
   begin
      _player_ReInitAllPlayersBaseObj;
      if GetCountOfPlayers>=gc_MaxPlayerCount then
      begin
         var pl, i : Integer;
         for [MAIN]pl:=0 to gc_MaxPlayerCount-1 do
         begin
            var plHnd : Integer = GetPlayerHandleByIndex(pl);
            for i:=0 to GetPlayerGameObjectsCountByHandle(plHnd)-1 do
            begin
               var goHnd : Integer = GetGameObjectHandleByIndex(i, plHnd);
               if (_misc_GetBaseObjID(goHnd)=gc_baseid_obj) then
               begin
                  var pobj : Pointer = _unit_GetTObj(goHnd);
                  if (not TObj(pobj).bdead) and (TObj(pobj).hp>0) then
                  TObj(pobj).hp := gPlayer[pl].objbase[TObj(pobj).cid][TObj(pobj).id].maxhp;
               end;
            end;
         end;
      end;
      var pl, cid, upgid : Integer;
      for pl:=0 to gc_MaxPlayerCount-1 do
      for cid:=0 to gc_MaxCountryCount-1 do
      for upgid:=0 to gc_country_maxupgradecount-1 do
      begin
         _player_ClearUpgradeState(gPlayer[pl].upgstate[cid][upgid]);
         gPlayer[pl].upgstate[cid][upgid].sid := gCountry[cid].upgrade[upgid].id;
         gPlayer[pl].upgstate[cid][upgid].enabled := gCountry[cid].upgrade[upgid].enabled;
      end;
   end;

   if (gSerialVersion=73) and (gScenario.bexists) and (not gScenario.bactive) then
   begin
      _misc_RemoveEnvObjectsOutsideOfMap;
   end;

   // fix fNextUID for squads
   var pl : Integer;
   for pl:=0 to gc_MaxPlayerCount-1 do
   begin
      var maxUID : Integer = gPlayer[pl].squads.fNextUID;
      for i:=0 to gPlayer[pl].squads.GetCount-1 do
      begin
         var psquad : Pointer = gPlayer[pl].squads.Get(i);
         maxUID := Max(maxUID, TSquad(psquad).fUID+1);
      end;
      if (gPlayer[pl].squads.fNextUID<maxUID) then
      begin
         ErrorLog('fNextUID for player '+IntToStr(pl)+' was fixed. preval='+IntToStr(gPlayer[pl].squads.fNextUID)+' newval='+IntToStr(maxUID));
         gPlayer[pl].squads.fNextUID := maxUID;
      end;
   end;

   if (gSerialVersion<91) then
   begin
      var i, cid, id : Integer;
      for i:=0 to gc_MaxPlayerCount-1 do
      begin
         for cid:=0 to gc_MaxCountryCount-1 do
         for id:=0 to gc_country_maxmembers-1 do
         gPlayer[i].objbase[cid][id].speed := 1;
      end;
   end;

   if (gSerialVersion<92) then
   begin
      var pl, i : Integer;
      for pl:=0 to gc_MaxPlayerCount-1 do
      for i:=0 to gc_ResCount-1 do
      begin
         if (gPlayer[pl].res[i]>=0) then
         gPlayer[pl].res[i] := not gPlayer[pl].res[i];
         gPlayer[pl].lanres[i] := gPlayer[pl].res[i];
         gPlayer[pl].setres[i] := gPlayer[pl].res[i];
      end;
   end;

   gSerialMode:=0;
   gSerialVersion:=gDataVersion;
   gSerialLoaded:=true;
   gInt_UpdateAreasCount := 0;
   
   gGuiUpdateHighlights.Clear;
   gGuiSelectionHelper.Clear;
   
   var count: Integer = gSelectedObjects.GetCount;
   if count>0 then begin
      GameManagerBeginSelection;
      GameManagerStartSelection('spmRunTime');
      var i: Integer;
      for i:=count-1 downto 0 do begin
         var hnd: Integer = gSelectedObjects.Get(i);
         var pobj : Pointer = _unit_GetTObj(hnd);
         if (pobj<>nil) and (not TObj(pobj).bdead) then
         SetGameObjectPickedByHandle(hnd, True)
         else
         begin
            gSelectedObjects.Delete(i);
            ErrorLog('Something gone wrong and was fixed');
         end;
         if i=count-1 then
         GameManagerCancelSelection;
         //gGuiUpdateHighlights.Add(hnd);
      end;
   end;

   _unit_ScanGridClear;
   _unit_ScanGridResetUnits;
   _unit_IdleGridClear;
   _unit_IdleGridResetUnits;

   _player_FixPlayersObjBaseBadIndexes; // only newer maps >=33 have objbase.sid, for older maps all indexes will be taken from objprop
   _player_FixGameObjectsUnitIDs;

   //_misc_UpdateMiniMapPrimitives;
end;

//
// TPlayerArgs
//

// _serial_PlayerArgsWriter
//
procedure _serial_PlayerArgsWriter(const fs: Integer; var val: TPlayerArgs; var nam: String; const sm, tp: Integer);
begin
   // clear temporary handles and do not save them to map
   val.fhandle:=0;
   val.ftarget:=0;
   val.fofficer:=0;
   val.fdrummer:=0;
   val.fresult:=0;
   
   // write to stream
   var typ : Pointer=AddrToPointer(tp);
   var addr: Pointer=val;
   SaveStreamTypeBase(fs, typ, addr, nam, sm, false{useproc});
end;

// _serial_PlayerArgsReader
//
procedure _serial_PlayerArgsReader(const fs: Integer; var val: TPlayerArgs; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   // read from stream
   var typdst: Pointer=AddrToPointer(tpd);
   var typsrc: Pointer=AddrToPointer(tps);
   var addr  : Pointer=val;
   //LoadStreamTypeBase(fs, typdst, addr, nam, sm, false);
   MergeStreamTypeBase(fs, typdst, addr, nam, sm, false{useproc}, typsrc, cmp=1{compared});
end;

// _serial_PlayerArgsSize
//
procedure _serial_PlayerArgsSize(var res: Integer; var val: TPlayerArgs; var nam: String; const sm, tp: Integer);
begin
   var typ : Pointer=AddrToPointer(tp);
   var addr: Pointer=val;
   res:=GetStreamSizeTypeBase(typ, addr, nam, sm, false{useproc});
end;

// _serial_PlayerArgsPost
//
procedure _serial_PlayerArgsPost(var val: TPlayerArgs{; var nam: String; const sm: Integer});
begin
   val.fintlst:=nil; // TIntegerList(val.fintlst)
end;

// _serial_PlayerArgsSeek
//
procedure _serial_PlayerArgsSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   var typ: Pointer=AddrToPointer(tp);
   SeekStreamTypeBase(fs, typ, nam, sm, false{useproc});
end;

//
// TIntegerList
//

// _serial_IntegerListIsHandles
//
function _serial_IntegerListIsHandles(var nam: String): Boolean;
begin
   // test for handles by name
   result:=false;
   case StrToLowerCase(nam) of
      'arg_stolist',
      'arg_attlist',
      'arg_ordlist',
      'arg_inside' ,
      'ggopathlist',
      'gwaterpathlist',
      'gctrlgroups',
      'gguiupdatehighlights',
      'gselectedobjects',
      'buildings',
      'storehouses',
      'ports',
      'defenders',
      'guards',
      'agressors',
      'freewarriors',
      'unitslist' : result:=true;
   end;
end;

// _serial_IntegerListWriter
//
procedure _serial_IntegerListWriter(const fs: Integer; var val: TIntegerList; var nam: String{; const sm, tp: Integer});
begin
   // write props to stream
   WriteInteger(fs, val.GetItemSize);
   WriteInteger(fs, val.GetCount);
   // test for handles
   var handles: boolean=_serial_IntegerListIsHandles(nam);
   // handle to uniqid
   if handles then begin
      var i: Integer;
      for i:=0 to val.GetCount-1 do
      val.Set(GetGameObjectUniqueIdByHandle(val.Get(i)), i);
   end;
   // write to stream
   if val.DataSize>0 then
   WriteBuffer(fs, val.GetBaseList, val.DataSize);
   // uniqid to handle
   if handles then begin
      var i: Integer;
      for i:=0 to val.GetCount-1 do
      val.Set(GetGameObjectHandleByUniqueId(val.Get(i)), i);
   end;
end;

// _serial_IntegerListReader
//
procedure _serial_IntegerListReader(const fs: Integer; var val: TIntegerList{; var nam: String; const sm, tpd, tps, cmp: Integer});
begin
   // read props from stream
   var itemsize, count: Integer;
   ReadInteger(fs, itemsize);
   ReadInteger(fs, count);
   // allocate memory
   val.SetItemSize(itemsize);
   val.SetCount(count);
   var p: Pointer=val.GetBaseList;
   // read from stream
   if val.DataSize>0 then
   ReadBuffer(fs, p, count*itemsize); //val.DataSize
end;

// _serial_IntegerListSize
//
procedure _serial_IntegerListSize(var res: Integer; var val: TIntegerList{; var nam: String; const sm, tp: Integer});
begin
   res:=val.DataSize+SizeOf(Integer)*2;
end;

// _serial_IntegerListPost
//
procedure _serial_IntegerListPost(var val: TIntegerList; var nam: String{; const sm: Integer});
begin
   // test for handles
   var handles: boolean=_serial_IntegerListIsHandles(nam);
   // uniqid to handle
   if handles then begin
      var i: Integer;
      for i:=0 to val.GetCount-1 do
      val.Set(GetGameObjectHandleByUniqueId(val.Get(i)), i);
   end;
end;

// _serial_IntegerListSeek
//
procedure _serial_IntegerListSeek(const fs: Integer{; var nam: String; const sm, tp: Integer});
begin
   // read props from stream
   var itemsize, count: Integer;
   ReadInteger(fs, itemsize);
   ReadInteger(fs, count);
   // stream seek
   if itemsize*count>0 then
   SeekBuffer(fs, itemsize*count);
end;

//
// TPtrList
//

// _serial_PtrListWriter
//
procedure _serial_PtrListWriter(const fs: Integer; var val: TPtrList; var nam: String{; const sm, tp: Integer});
begin
   // write props to stream
   WriteInteger(fs, val.GetItemSize);
   WriteInteger(fs, val.GetCount);
   // write to stream
   if val.DataSize>0 then
   WriteBuffer(fs, val.GetBaseList, val.DataSize);
end;

// _serial_PtrListReader
//
procedure _serial_PtrListReader(const fs: Integer; var val: TPtrList{; var nam: String; const sm, tpd, tps, cmp: Integer});
begin
   // read props from stream
   var itemsize, count: Integer;
   ReadInteger(fs, itemsize);
   ReadInteger(fs, count);
   // allocate memory
   val.SetItemSize(itemsize);
   val.SetCount(count);
   var p: Pointer=val.GetBaseList;
   // read from stream
   if val.DataSize>0 then
   ReadBuffer(fs, p, count*itemsize); //val.DataSize
end;

// _serial_PtrListSize
//
procedure _serial_PtrListSize(var res: Integer; var val: TPtrList{; var nam: String; const sm, tp: Integer});
begin
   res:=val.DataSize+SizeOf(Integer)*2;
end;

// _serial_PtrListPost
//
procedure _serial_PtrListPost(var val: TPtrList; var nam: String{; const sm: Integer});
begin
end;

// _serial_PtrListSeek
//
procedure _serial_PtrListSeek(const fs: Integer{; var nam: String; const sm, tp: Integer});
begin
   // read props from stream
   var itemsize, count: Integer;
   ReadInteger(fs, itemsize);
   ReadInteger(fs, count);
   // stream seek
   if itemsize*count>0 then
   SeekBuffer(fs, itemsize*count);
end;

