      SeekInteger(fs); // val.owner
      SeekInteger(fs); // val.dist
   end;
end;

//
// TResGridList
//

// _serial_ResGridListWriter
//
procedure _serial_ResGridListWriter(const fs: Integer; var val: TResGridList);
begin
   // write props to stream
   WriteInteger(fs, val.GetItemSize);
   WriteInteger(fs, val.GetCount);
   // handle to uniqid
   var i: Integer;
   for i:=0 to val.GetCount-1 do
   val.Set(GetGameObjectUniqueIdByHandle(val.Get(i)), i);
   // write to stream
   if val.DataSize>0 then
   WriteBuffer(fs, val.GetBaseList, val.DataSize);
   // uniqid to handle
   for i:=0 to val.GetCount-1 do
   val.Set(GetGameObjectHandleByUniqueId(val.Get(i)), i);
   // write fResCount array
   var buf: Pointer=val.fResCount;
   WriteBuffer (fs, buf, SizeOf(val.fResCount));
   // write fWorkerCount array
   buf:=val.fWorkerCount;
   WriteBuffer (fs, buf, SizeOf(val.fWorkerCount));
end;

// _serial_ResGridListReader
//
procedure _serial_ResGridListReader(const fs: Integer; var val: TResGridList);
begin
   // read props from stream
   var itemsize, count: Integer;
   ReadInteger(fs, itemsize);
   ReadInteger(fs, count);
   // allocate memory
   val.SetItemSize(itemsize);
   val.SetCount(count);
   var p: Pointer=val.GetBaseList;
   // read from stream
   if val.DataSize>0 then
   ReadBuffer(fs, p, count*itemsize); //val.DataSize
   // read fResCount array
   var buf: Pointer=val.fResCount;
   ReadBuffer (fs, buf, SizeOf(val.fResCount));
   // read fWorkerCount array
   buf:=val.fWorkerCount;
   if gSerialVersion<53 then
   ReadBuffer (fs, buf, SizeOf(Integer)*8*gc_ResCount)
   else
   if gSerialVersion<89 then
   ReadBuffer (fs, buf, SizeOf(Integer)*(gc_MaxNonSpectatorsCount+1)*gc_ResCount)
   else
   ReadBuffer (fs, buf, SizeOf(val.fWorkerCount));
end;

// _serial_ResGridListSize
//
procedure _serial_ResGridListSize(var res: Integer; var val: TResGridList);
begin
   if gSerialVersion<53 then
   res:=val.DataSize+SizeOf(Integer)*2+SizeOf(val.fResCount)+SizeOf(Integer)*8*gc_ResCount
   else
   if (gSerialVersion<89) then
   res:=val.DataSize+SizeOf(Integer)*2+SizeOf(val.fResCount)+SizeOf(Integer)*(gc_MaxNonSpectatorsCount+1)*gc_ResCount // TODO check 16.05.18 strange value
   else
   res:=val.DataSize+SizeOf(Integer)*2+SizeOf(val.fResCount)+SizeOf(val.fWorkerCount);
end;

// _serial_ResGridListPost
//
procedure _serial_ResGridListPost(var val: TResGridList);
begin
   // uniqid to handle
   var i: Integer;
   for i:=0 to val.GetCount-1 do
   val.Set(GetGameObjectHandleByUniqueId(val.Get(i)), i);
end;

// _serial_ResGridListSeek
//
procedure _serial_ResGridListSeek(const fs: Integer);
begin
   // read props from stream
   var itemsize, count: Integer;
   ReadInteger(fs, itemsize);
   ReadInteger(fs, count);
   // stream seek
   if itemsize*count>0 then
   SeekBuffer(fs, itemsize*count);
   // seek fResCount array
   SeekBuffer (fs, SizeOf(Integer)*gc_ResCount);
   // seek fWorkerCount array
   if gSerialVersion<53 then
   SeekBuffer (fs, SizeOf(Integer)*8*gc_ResCount)
   else
   if gSerialVersion<89 then
   SeekBuffer (fs, SizeOf(Integer)*(gc_MaxNonSpectatorsCount+1)*gc_ResCount)
   else
   SeekBuffer (fs, SizeOf(Integer)*gc_MaxPlayerCount*gc_ResCount);
end;

