//
// TWallSystem
//

// _serial_WallSystemWriter
//
procedure _serial_WallSystemWriter(const fs: Integer; var val: TWallSystem; var nam: String; const sm, tp: Integer);
begin
   var count : Integer = val.GetCount;
   WriteInteger(fs, count);
   var i, j : Integer;
   for i := 0 to count-1 do
   begin
      var pbuf : Pointer = val.Get(i);
      var ptyp : Pointer = PointerOf(TWallCluster);
      SaveStreamTypeBase(fs, ptyp, pbuf, 'flist', sm, true);
   end;
end;

// _serial_WallSystemReader
//
procedure _serial_WallSystemReader(const fs: Integer; var val: TWallSystem; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   if gSerialVersion>=28 then
   begin
      val.Clear;
      var count : Integer;
      ReadInteger(fs, count);
      var i, j : Integer;
      for i := 0 to count-1 do
      begin
         var pbuf : Pointer = val.Add;
         var typdst: Pointer = PointerOf(TWallCluster);
         var typsrc: Pointer = GetTypeBaseByTypeName('TWallCluster', true);
         MergeStreamTypeBase(fs, typdst, pbuf, 'flist', sm, true{useproc}, typsrc, cmp=1{compared});
      end;
   end;
end;

// _serial_WallSystemSize
//
procedure _serial_WallSystemSize(var res: Integer; var val: TWallSystem; var nam: String; const sm, tp: Integer);
begin
   res := SizeOf(Integer);
   var count : Integer = val.GetCount;
   var i, j : Integer;
   for i := 0 to count-1 do
   begin
      var pbuf : Pointer = val.Get(i);
      var ptyp: Pointer = PointerOf(TTower);
      res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'flist', sm, true);
   end;
end;

// _serial_WallSystemSeek
//
procedure _serial_WallSystemSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   if gSerialVersion>=28 then
   begin
      var i, count : Integer;
      ReadInteger(fs, count);
      for i := 0 to count-1 do
      begin
         var ptyp : Pointer = GetTypeBaseByTypeName('TWallCluster', true);
         SeekStreamTypeBase(fs, ptyp, 'flist', sm, true{useproc});
      end;
   end;
end;

//
// TWallCluster
//

// _serial_WallClusterWriter
//
procedure _serial_WallClusterWriter(const fs: Integer; var val: TWallCluster; var nam: String; const sm, tp: Integer);
begin
   WriteInteger(fs, val.wallType);
   
   var pbuf : Pointer = val.cornPt;
   var ptyp : Pointer = PointerOf(TIntegerList);
   SaveStreamTypeBase(fs, ptyp, pbuf, 'cornPt', sm, true);
   
   var count : Integer = val.cells.GetCount;
   WriteInteger(fs, count);
   var i : Integer;
   for i := 0 to count-1 do
   begin
      var pbuf : Pointer = val.cells.GetPointer(i);
      var ptyp : Pointer = PointerOf(TWallCell);
      SaveStreamTypeBase(fs, ptyp, pbuf, 'cells', sm, true);
   end;
   
   WriteInteger(fs, val.lastX);
   WriteInteger(fs, val.lastY);
   WriteInteger(fs, val.finalX);
   WriteInteger(fs, val.finalY);
   WriteInteger(fs, val.plIndex);
   WriteInteger(fs, val.cid);
   WriteBoolean(fs, val.firstWall);
   WriteBoolean(fs, val.buildWall);
end;

// _serial_WallClusterReader
//
procedure _serial_WallClusterReader(const fs: Integer; var val: TWallCluster; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   ReadInteger(fs, val.wallType);
   
   var typdst : Pointer = PointerOf(TIntegerList);
   var typsrc : Pointer = GetTypeBaseByTypeName('TIntegerList', true);
   var pbuf : Pointer = val.cornPt;
   MergeStreamTypeBase(fs, typdst, pbuf, 'cornPt', sm, true{useproc}, typsrc, cmp=1{compared});
   
   val.cells.Clear;
   var i, count : Integer;
   ReadInteger(fs, count);
   for i := 0 to count-1 do
   begin
      var typdst : Pointer = PointerOf(TWallCell);
      var typsrc : Pointer = GetTypeBaseByTypeName('TWallCell', true);
      var pbuf : Pointer = val.AddCell;
      MergeStreamTypeBase(fs, typdst, pbuf, 'cells', sm, true{useproc}, typsrc, cmp=1{compared});
   end;
   
   ReadInteger(fs, val.lastX);
   ReadInteger(fs, val.lastY);
   ReadInteger(fs, val.finalX);
   ReadInteger(fs, val.finalY);
   ReadInteger(fs, val.plIndex);
   ReadInteger(fs, val.cid);
   ReadBoolean(fs, val.firstWall);
   ReadBoolean(fs, val.buildWall);
end;

// _serial_WallClusterSize
//
procedure _serial_WallClusterSize(var res: Integer; var val: TWallCluster; var nam: String; const sm, tp: Integer);
begin
   res := SizeOf(Integer); // val.wallType
   
   var ptyp : Pointer = PointerOf(TIntegerList);
   var pBuf : Pointer = val.cornPt;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'cornPt', sm, true);
   
   res := res + SizeOf(Integer); // val.cells.GetCount
   var count : Integer = val.cells.GetCount;
   ptyp := PointerOf(TWallCell);
   var i : Integer;
   for i := 0 to count-1 do begin
      pbuf := val.cells.GetPointer(i);
      res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'cells', sm, true);
   end;
   
   res := res + SizeOf(Integer); // val.lastX
   res := res + SizeOf(Integer); // val.lastY
   res := res + SizeOf(Integer); // val.finalX
   res := res + SizeOf(Integer); // val.finalY
   res := res + SizeOf(Integer); // val.plIndex
   res := res + SizeOf(Integer); // val.cid
   res := res + SizeOf(Boolean); // val.firstWall
   res := res + SizeOf(Boolean); // val.buildWall
end;

// _serial_WallClusterSeek
//
procedure _serial_WallClusterSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   SeekInteger(fs); // val.wallType
   
   var ptyp : Pointer = GetTypeBaseByTypeName('TIntegerList', true);
   SeekStreamTypeBase(fs, ptyp, 'cornPt', sm, true);
   
   var i, count : Integer;
   ptyp := GetTypeBaseByTypeName('TWallCell', true);
   ReadInteger(fs, count);
   for i := 0 to count-1 do
   SeekStreamTypeBase(fs, ptyp, 'cells', sm, true{useproc});
   
   SeekInteger(fs); // val.lastX
   SeekInteger(fs); // val.lastY
   SeekInteger(fs); // val.finalX
   SeekInteger(fs); // val.finalY
   SeekInteger(fs); // val.plIndex
   SeekInteger(fs); // val.cid
   SeekBoolean(fs); // val.firstWall
   SeekBoolean(fs); // val.buildWall
end;

//
// TWallCell
//

// _serial_WallCellWriter
//
procedure _serial_WallCellWriter(const fs: Integer; var val: TWallCell; var nam: String; const sm, tp: Integer);
begin
   WriteInteger(fs, val.fSprite);
   WriteInteger(fs, val.x);
   WriteInteger(fs, val.y);
   WriteInteger(fs, val.wallType);
   WriteInteger(fs, val.cid);
   WriteBoolean(fs, val.visible);
   WriteInteger(fs, GetGameObjectUniqueIdByHandle(val.goHnd));
   WriteInteger(fs, val.plInd);
end;

// _serial_WallCellReader
//
procedure _serial_WallCellReader(const fs: Integer; var val: TWallCell; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   ReadInteger(fs, val.fSprite);
   ReadInteger(fs, val.x);
   ReadInteger(fs, val.y);
   ReadInteger(fs, val.wallType);
   ReadInteger(fs, val.cid);
   ReadBoolean(fs, val.visible);
   ReadInteger(fs, val.goHnd);
   ReadInteger(fs, val.plInd);
end;

// _serial_WallCellSize
//
procedure _serial_WallCellSize(var res: Integer; var val: TWallCell; var nam: String; const sm, tp: Integer);
begin
   res := res + SizeOf(Integer); // val.fSprite
   res := res + SizeOf(Integer); // val.x
   res := res + SizeOf(Integer); // val.y
   res := res + SizeOf(Integer); // val.wallType
   res := res + SizeOf(Integer); // val.cid
   res := res + SizeOf(Boolean); // val.visible
   res := res + SizeOf(Integer); // val.goHnd
   res := res + SizeOf(Integer); // val.plInd
end;

// _serial_WallCellPost
//
procedure _serial_WallCellPost(var val: TWallCell);
begin
   val.goHnd := GetGameObjectHandleByUniqueId(val.goHnd);
end;

// _serial_WallCellSeek
//
procedure _serial_WallCellSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   SeekInteger(fs); // val.fSprite
   SeekInteger(fs); // val.lastY
   SeekInteger(fs); // val.finalX
   SeekInteger(fs); // val.finalY
   SeekInteger(fs); // val.plIndex
   SeekInteger(fs); // val.cid
   SeekBoolean(fs); // val.firstWall
   SeekBoolean(fs); // val.buildWall
end;
