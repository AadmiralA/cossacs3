//
// TSquadList
//

// _serial_SquadListWriter
//
procedure _serial_SquadListWriter(const fs: Integer; var val: TSquadList{; var nam: String; const sm, tp: Integer});
begin
   // write to stream
   WriteInteger(fs, val.GetCount);
   var i: Integer;
   for i:=0 to val.GetCount-1 do begin
      var j: Integer;
      var p: Pointer=val.Get(i);
      WriteInteger(fs, TSquad(p).GetCount);
      for j:=0 to TSquad(p).GetCount-1 do
      WriteInteger(fs, GetGameObjectUniqueIdByHandle(TSquad(p).Get(j)));
      
      var h: Integer=TSquad(p).fHeight;
      var w: Integer=TSquad(p).fWidth;
      WriteInteger(fs, h);
      WriteInteger(fs, w);
      for h:=0 to TSquad(p).fHeight-1 do
      for w:=0 to TSquad(p).fWidth-1 do
      WriteInteger(fs, GetGameObjectUniqueIdByHandle(TSquad(p).arGrid[h, w]));
      WriteInteger(fs, TSquad(p).fFormation);
      WriteInteger(fs, TSquad(p).fBaseCount);
      WriteBoolean(fs, TSquad(p).fStandGround);
      WriteBoolean(fs, TSquad(p).fSearchVictim);
      WriteBoolean(fs, TSquad(p).fSelected);
      WriteInteger(fs, TSquad(p).fIndex);
      WriteInteger(fs, TSquad(p).fOfficerID);
      WriteInteger(fs, TSquad(p).fPlIndex);
      WriteString( fs, TSquad(p).fGroupName);
      WriteBoolean(fs, TSquad(p).fHoldMode);
      WriteInteger(fs, TSquad(p).fAddDamage);
      WriteInteger(fs, TSquad(p).fAddShield);
      WriteInteger(fs, TSquad(p).fAddDamageHold);
      WriteInteger(fs, TSquad(p).fAddShieldHold);
      WriteFloat(  fs, TSquad(p).fDirX);
      WriteFloat(  fs, TSquad(p).fDirZ);
      WriteInteger(fs, TSquad(p).fArmy);
      WriteInteger(fs, TSquad(p).fType);
      WriteInteger(fs, TSquad(p).fWarType);
      WriteBoolean(fs, TSquad(p).fAgressive);
      WriteBoolean(fs, TSquad(p).fAttackMode);
      WriteFloat(  fs, TSquad(p).fHoldModeProgress);
      WriteBoolean(fs, TSquad(p).fNeedRebuild);
      
      // ver = 19
      WriteInteger(fs, TSquad(p).fMoveCount);
      WriteInteger(fs, TSquad(p).fAttackCount);
      WriteFloat(  fs, TSquad(p).fTag);
      WriteFloat(  fs, TSquad(p).fCurX);
      WriteFloat(  fs, TSquad(p).fCurZ);
      
      // ver = 22
      WriteInteger(fs, TSquad(p).fDelayCount);
      
      // ver = 37
      WriteInteger(fs, TSquad(p).fUID);
   end;
end;

// _serial_SquadListReader
//
procedure _serial_SquadListReader(const fs: Integer; var val: TSquadList{; var nam: String; const sm, tpd, tps, cmp: Integer});
begin
   val.Clear;
   var i, c: Integer;
   // read from stream
   ReadInteger(fs, c);
   for i:=0 to c-1 do begin
      var j: Integer;
      var p: Pointer=val.Add;
      var n: Integer;
      ReadInteger(fs, n);
      for j:=0 to n-1 do begin
         var uid: Integer;
         ReadInteger(fs, uid);
         //var hnd: Integer=GetGameObjectHandleByUniqueId(uid);
         //if hnd<>0 then
         TSquad(p).Add(uid{hnd});
      end;
      var h, w: Integer;
      ReadInteger(fs, TSquad(p).fHeight);
      ReadInteger(fs, TSquad(p).fWidth);
      for h:=0 to TSquad(p).fHeight-1 do
      for w:=0 to TSquad(p).fWidth-1 do begin
         var hnd, uid: Integer;
         ReadInteger(fs, uid);
         //if uid<>0 then
         //   hnd:=GetGameObjectHandleByUniqueId(uid)
         //else hnd:=0;
         TSquad(p).arGrid[h, w]:=uid{hnd};
      end;
      ReadInteger(fs, TSquad(p).fFormation);
      ReadInteger(fs, TSquad(p).fBaseCount);
      ReadBoolean(fs, TSquad(p).fStandGround);
      ReadBoolean(fs, TSquad(p).fSearchVictim);
      ReadBoolean(fs, TSquad(p).fSelected);
      ReadInteger(fs, TSquad(p).fIndex);
      ReadInteger(fs, TSquad(p).fOfficerID);
      ReadInteger(fs, TSquad(p).fPlIndex);
      ReadString( fs, TSquad(p).fGroupName);
      ReadBoolean(fs, TSquad(p).fHoldMode);
      ReadInteger(fs, TSquad(p).fAddDamage);
      ReadInteger(fs, TSquad(p).fAddShield);
      ReadInteger(fs, TSquad(p).fAddDamageHold);
      ReadInteger(fs, TSquad(p).fAddShieldHold);
      ReadFloat(  fs, TSquad(p).fDirX);
      ReadFloat(  fs, TSquad(p).fDirZ);
      
      if gSerialVersion>=1 then
      begin
         ReadInteger(fs, TSquad(p).fArmy);
         ReadInteger(fs, TSquad(p).fType);
         ReadInteger(fs, TSquad(p).fWarType);
      end;
      
      if gSerialVersion>=7 then
      begin
         ReadBoolean(fs, TSquad(p).fAgressive);
      end;
      
      if gSerialVersion>=8 then
      begin
         ReadBoolean(fs, TSquad(p).fAttackMode);
      end;
      
      if gSerialVersion>=9 then
      begin
         ReadFloat(fs, TSquad(p).fHoldModeProgress);
      end;
      
      if gSerialVersion>=16 then
      ReadBoolean(fs, TSquad(p).fNeedRebuild)
      else
      TSquad(p).fNeedRebuild := false;
      
      if gSerialVersion>=19 then
      begin
         ReadInteger(fs, TSquad(p).fMoveCount);
         ReadInteger(fs, TSquad(p).fAttackCount);
         ReadFloat(  fs, TSquad(p).fTag);
         ReadFloat(  fs, TSquad(p).fCurX);
         ReadFloat(  fs, TSquad(p).fCurZ);
      end;
      
      if gSerialVersion>=22 then
      ReadInteger(fs, TSquad(p).fDelayCount);
      
      if gSerialVersion>=37 then
      ReadInteger(fs, TSquad(p).fUID);
   end;
end;

// _serial_SquadListSize
//
procedure _serial_SquadListSize(var res: Integer; var val: TSquadList{; var nam: String; const sm, tp: Integer});
begin
   res:=SizeOf(Integer);
   var i: Integer;
   for i:=0 to val.GetCount-1 do begin
      var p: Pointer=val.Get(i);
      res:=res+SizeOf(Integer)+TSquad(p).GetCount*SizeOf(Integer);
      res:=res+2*SizeOf(Integer);
      res:=res+TSquad(p).fHeight*TSquad(p).fWidth*SizeOf(Integer);
      res:=res+SizeOf(Integer); //TSquad(p).fFormation
      res:=res+SizeOf(Integer); //TSquad(p).fBaseCount
      res:=res+SizeOf(Boolean); //TSquad(p).fStandGround
      res:=res+SizeOf(Boolean); //TSquad(p).fSearchVictim
      res:=res+SizeOf(Boolean); //TSquad(p).fSelected
      res:=res+SizeOf(Integer); //TSquad(p).fIndex
      res:=res+SizeOf(Integer); //TSquad(p).fOfficerID
      res:=res+SizeOf(Integer); //TSquad(p).fPlIndex
      res:=res+SizeOf(Integer)+StrLength(TSquad(p).fGroupName);
      res:=res+SizeOf(Boolean); //TSquad(p).fHoldMode
      res:=res+SizeOf(Integer); //TSquad(p).fAddDamage
      res:=res+SizeOf(Integer); //TSquad(p).fAddShield
      res:=res+SizeOf(Integer); //TSquad(p).fAddDamageHold
      res:=res+SizeOf(Integer); //TSquad(p).fAddShieldHold
      res:=res+SizeOf(Float);   //TSquad(p).fDirX
      res:=res+SizeOf(Float);   //TSquad(p).fDirZ
      res:=res+SizeOf(Integer); //TSquad(p).fArmy
      res:=res+SizeOf(Integer); //TSquad(p).fType
      res:=res+SizeOf(Integer); //TSquad(p).fWarType
      res:=res+SizeOf(Boolean); //TSquad(p).fAgressive
      res:=res+SizeOf(Boolean); //TSquad(p).fAttackMode
      res:=res+SizeOf(Float); //TSquad(p).fHoldModeProgress
      res:=res+SizeOf(Boolean); //TSquad(p).fNeedRebuild
      
      res:=res+SizeOf(Integer); //TSquad(p).fMoveCount
      res:=res+SizeOf(Integer); //TSquad(p).fAttackCount
      res:=res+SizeOf(Float);   //TSquad(p).fTag
      res:=res+SizeOf(Float);   //TSquad(p).fCurX
      res:=res+SizeOf(Float);   //TSquad(p).fCurZ
      res:=res+SizeOf(Integer); //TSquad(p).fDelayCount
      res:=res+SizeOf(Integer); //TSquad(p).fUID
   end;
end;

// _serial_SquadListPost
//
procedure _serial_SquadListPost(var val: TSquadList{; var nam: String; const sm: Integer});
begin
   // uniqid to handle
   var i: Integer;
   for i:=0 to val.GetCount-1 do begin
      var j: Integer;
      var p: Pointer=val.Get(i);
      for j:=0 to TSquad(p).GetCount-1 do
      TSquad(p).Set(GetGameObjectHandleByUniqueId(TSquad(p).Get(j)), j);
      var h, w: Integer;
      for h:=0 to TSquad(p).fHeight-1 do
      for w:=0 to TSquad(p).fWidth-1 do
      TSquad(p).arGrid[h, w]:=GetGameObjectHandleByUniqueId(TSquad(p).arGrid[h, w]);
   end;
end;

// _serial_SquadListSeek
//
procedure _serial_SquadListSeek(const fs: Integer{; var nam: String; const sm, tp: Integer});
begin
   var i, c: Integer;
   ReadInteger(fs, c);
   for i:=0 to c-1 do begin
      var j, n: Integer;
      ReadInteger(fs, n);
      if SizeOf(Integer)*n>0 then
      SeekBuffer(fs, SizeOf(Integer)*n);
      var h, w: Integer;
      ReadInteger(fs, h);
      ReadInteger(fs, w);
      if SizeOf(Integer)*h*w>0 then
      SeekBuffer(fs, SizeOf(Integer)*h*w);
      SeekInteger(fs); //TSquad(p).fFormation
      SeekInteger(fs); //TSquad(p).fBaseCount
      SeekBoolean(fs); //TSquad(p).fStandGround
      SeekBoolean(fs); //TSquad(p).fSearchVictim
      SeekBoolean(fs); //TSquad(p).fSelected
      SeekInteger(fs); //TSquad(p).fIndex
      SeekInteger(fs); //TSquad(p).fOfficerID
      SeekInteger(fs); //TSquad(p).fPlIndex
      SeekString( fs); //TSquad(p).fGroupName
      SeekBoolean(fs); //TSquad(p).fHoldMode
      SeekInteger(fs); //TSquad(p).fAddDamage
      SeekInteger(fs); //TSquad(p).fAddShield
      SeekInteger(fs); //TSquad(p).fAddDamageHold
      SeekInteger(fs); //TSquad(p).fAddShieldHold
      SeekFloat(  fs); //TSquad(p).fDirX
      SeekFloat(  fs); //TSquad(p).fDirZ
      if gSerialVersion>=1 then
      begin
         SeekInteger(fs); //TSquad(p).fArmy
         SeekInteger(fs); //TSquad(p).fType
         SeekInteger(fs); //TSquad(p).fWartType
      end;
      
      if gSerialVersion>=7 then
      begin
         SeekBoolean(fs); //TSquad(p).fAgressive;
      end;
      
      if gSerialVersion>=8 then
      begin
         SeekBoolean(fs); //TSquad(p).fAttackMode;
      end;
      
      if gSerialVersion>=9 then
      begin
         SeekFloat(fs); //TSquad(p).fHoldModeProgress;
      end;
      
      if gSerialVersion>=16 then
      begin
         SeekBoolean(fs); //TSquad(p).fNeedRebuild;
      end;
      
      if gSerialVersion>=19 then
      begin
         SeekInteger(fs); // TSquad(p).fMoveCount
         SeekInteger(fs); // TSquad(p).fAttackCount
         SeekFloat(  fs); // TSquad(p).fTag
         SeekFloat(  fs); // TSquad(p).fCurX
         SeekFloat(  fs); // TSquad(p).fCurZ
      end;
      if gSerialVersion>=22 then
      SeekInteger(fs); // TSquad(p).fDelayCount
      if gSerialVersion>=37 then
      SeekInteger(fs); // TSquad(p).fUID
   end;
end;

