// _serial_ObjPost
//
procedure _serial_ObjPost(var val: TObj{; var nam: String; const sm: Integer});
begin
   // uniqid to handle
   //var i: Integer;
   //for i:=0 to gc_obj_MaxOrderCount-1 do
   //if val.orders[i].info.trg<>0 then
   //   val.orders[i].info.trg:=GetGameObjectHandleByUniqueId(val.orders[i].info.trg);
   if val.trghnd<>0 then
   val.trghnd:=GetGameObjectHandleByUniqueId(val.trghnd);
   if val.artHnd <> 0 then
   val.artHnd := GetGameObjectHandleByUniqueId(val.artHnd);
   
   val.topzone:=-1;
   
   val.lasttimecheckcapture := random*gc_unit_TimeCheckCapture;
   val.lasttimeidlegrid := random*gc_unit_TimeIdleGrid;
   val.lasttimescangrid := random*gc_unit_TimeScanGrid;
   val.lasttimetopology := random*gc_unit_TimeTopology;
   val.lasttimebestposition := random*gc_unit_TimeFindBestPosition;
   val.lastsearchenemy := random;
end;

