//
// TArmyList
//

// _serial_ArmyListWriter
//
procedure _serial_ArmyListWriter(const fs: Integer; var val: TArmyList; var nam: String; const sm, tp: Integer);
begin
   var count : Integer = val.GetCount;
   WriteInteger(fs, count);
   var i : Integer;
   for i := 0 to count-1 do
   begin
      var p : Pointer = val.Get(i);
      var sCount : Integer = TArmy(p).fSquadList.GetCount;
      WriteInteger(fs, sCount);
      var j : Integer;
      for j := 0 to sCount-1 do
      begin
         var pSquad : Pointer = TArmy(p).fSquadList.GetPointer(j);
         WriteInteger(fs, TSquad(pSquad).fIndex);
      end;
      
      WriteInteger(fs, TArmy(p).fIndex);
      WriteFloat(fs, TArmy(p).fOffsetCol);
      WriteFloat(fs, TArmy(p).fOffsetRow);
      WriteInteger(fs, TArmy(p).fSpec);
      WriteInteger(fs, TArmy(p).fTopZone);
      WriteBoolean(fs, TArmy(p).fSpecialOrder);
      WriteInteger(fs, TArmy(p).fOrder.iType);
      WriteFloat(fs, TArmy(p).fX);
      WriteFloat(fs, TArmy(p).fZ);
      WriteFloat(fs, TArmy(p).fCurX);
      WriteFloat(fs, TArmy(p).fCurZ);
      WriteInteger(fs, TArmy(p).fOrder.targetUID);
      WriteInteger(fs, TArmy(p).fOrder.tag);
      WriteInteger(fs, TArmy(p).fOrder.tag2);
      
      // ver = 11
      WriteFloat(fs, TArmy(p).fLastBattleTime);
      
      // ver = 14
      WriteInteger(fs, TArmy(p).fOrder.tag3);
      WriteFloat(fs, TArmy(p).fOrder.tagFloat);
      
      // ver = 18
      WriteInteger(fs, TArmy(p).fCurTopZone);
      
      // ver = 23
      WriteInteger(fs, TArmy(p).fPlIndex);
      
      // ver = 34
      WriteBoolean(fs, TArmy(p).fActive);
      
      // ver = 45
      WriteFloat(fs, TArmy(p).fLastArtTime);
      
      // ver = 46
      WriteBoolean(fs, TArmy(p).fOnEnemyLand);
   end;
end;

// _serial_ArmyListReader
//
procedure _serial_ArmyListReader(const fs: Integer; var val: TArmyList; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   val.Clear;
   var i, count : Integer;
   ReadInteger(fs, count);
   
   for i := 0 to count-1 do
   begin
      var p : Pointer = val.Add;
      var sCount : Integer;
      ReadInteger(fs, sCount);
      var j : Integer;
      for j := 0 to sCount-1 do
      begin
         var ind : Integer;
         ReadInteger(fs, ind);
         var p1 : Pointer = AddrToPointer(ind);
         TArmy(p).fSquadList.AddPointer(p1);
      end;
      
      ReadInteger(fs, TArmy(p).fIndex);
      ReadFloat(fs, TArmy(p).fOffsetCol);
      ReadFloat(fs, TArmy(p).fOffsetRow);
      ReadInteger(fs, TArmy(p).fSpec);
      ReadInteger(fs, TArmy(p).fTopZone);
      ReadBoolean(fs, TArmy(p).fSpecialOrder);
      ReadInteger(fs, TArmy(p).fOrder.iType);
      ReadFloat(fs, TArmy(p).fX);
      ReadFloat(fs, TArmy(p).fZ);
      
      if gSerialVersion>=3 then
      begin
         ReadFloat(fs, TArmy(p).fCurX);
         ReadFloat(fs, TArmy(p).fCurZ);
      end;
      
      if gSerialVersion>=4 then
      begin
         ReadInteger(fs, TArmy(p).fOrder.targetUID);
         ReadInteger(fs, TArmy(p).fOrder.tag);
         ReadInteger(fs, TArmy(p).fOrder.tag2);
      end;
      
      if gSerialVersion>=11 then
      ReadFloat(fs, TArmy(p).fLastBattleTime);
      
      if gSerialVersion>=14 then
      begin
         ReadInteger(fs, TArmy(p).fOrder.tag3);
         ReadFloat(fs, TArmy(p).fOrder.tagFloat);
      end;
      
      if gSerialVersion>=18 then
      ReadInteger(fs, TArmy(p).fCurTopZone);
      
      if gSerialVersion>=23 then
      ReadInteger(fs, TArmy(p).fPlIndex);
      
      if gSerialVersion>=34 then
      ReadBoolean(fs, TArmy(p).fActive)
      else
      TArmy(p).fActive := true;
      
      if gSerialVersion>=45 then
      ReadFloat(fs, TArmy(p).fLastArtTime)
      else
      TArmy(p).fLastArtTime := 0;
      
      if gSerialVersion>=46 then
      ReadBoolean(fs, TArmy(p).fOnEnemyLand)
      else
      TArmy(p).fOnEnemyLand := false;
   end;
end;

// _serial_ArmyListSize
//
procedure _serial_ArmyListSize(var res: Integer; var val: TArmyList; var nam: String; const sm, tp: Integer);
begin
   res := SizeOf(Integer);
   
   var i: Integer;
   for i := 0 to val.GetCount-1 do
   begin
      var p : Pointer = val.Get(i);
      res := res + SizeOf(Integer) + TArmy(p).fSquadList.GetCount*SizeOf(Integer);
      
      res := res + SizeOf(Integer); // TArmy(p).fIndex
      res := res + SizeOf(Float);   // TArmy(p).fOffsetCol
      res := res + SizeOf(Float);   // TArmy(p).fOffsetRow
      res := res + SizeOf(Integer); // TArmy(p).fSpec
      res := res + SizeOf(Integer); // TArmy(p).fTopZone
      res := res + SizeOf(Boolean); // TArmy(p).fSpecialOrder
      res := res + SizeOf(Integer); // TArmy(p).fOrder.iType
      res := res + SizeOf(Float);   // TArmy(p).fX
      res := res + SizeOf(Float);   // TArmy(p).fZ
      res := res + SizeOf(Float);   // TArmy(p).fCurX
      res := res + SizeOf(Float);   // TArmy(p).fCurZ
      res := res + SizeOf(Integer); // TArmy(p).fOrder.targetUID
      res := res + SizeOf(Integer); // TArmy(p).fOrder.tag
      res := res + SizeOf(Integer); // TArmy(p).fOrder.tag2
      res := res + SizeOf(Float);   // TArmy(p).fLastBattleTime
      res := res + SizeOf(Integer); // TArmy(p).fOrder.tag3
      res := res + SizeOf(Float);   // TArmy(p).fOrder.tagFloat
      res := res + SizeOf(Integer); // TArmy(p).fCurTopZone
      res := res + SizeOf(Integer); // TArmy(p).fPlIndex
      res := res + SizeOf(Boolean); // TArmy(p).fActive
      res := res + SizeOf(Float);   // TArmy(p).fLastArtTime
      res := res + SizeOf(Boolean); // TArmy(p).fOnEnemyLand
   end;
end;

// _serial_ArmyListPost
//
procedure _serial_ArmyListPost(var val: TArmyList{; var nam: String; const sm: Integer});
begin
end;

// _serial_ArmyListSeek
//
procedure _serial_ArmyListSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   var i, c: Integer;
   ReadInteger(fs, c);
   for i := 0 to c-1 do begin
      var n: Integer;
      ReadInteger(fs, n);
      if SizeOf(Integer)*n > 0 then
      SeekBuffer(fs, SizeOf(Integer)*n);
      
      SeekInteger(fs); // TArmy(p).fIndex
      SeekFloat(fs);   // TArmy(p).fOffsetCol
      SeekFloat(fs);   // TArmy(p).fOffsetRow
      SeekInteger(fs); // TArmy(p).fSpec
      SeekInteger(fs); // TArmy(p).fTopZone
      SeekBoolean(fs); // TArmy(p).fSpecialOrder
      SeekInteger(fs); // TArmy(p).fOrder.iType
      SeekFloat(fs);   // TArmy(p).fX
      SeekFloat(fs);   // TArmy(p).fZ
      
      if gSerialVersion>=3 then
      begin
         SeekFloat(fs);   // TArmy(p).fCurX
         SeekFloat(fs);   // TArmy(p).fCurZ
      end;
      
      if gSerialVersion>=4 then
      begin
         SeekInteger(fs); // TArmy(p).fOrder.targetUID
         SeekInteger(fs); // TArmy(p).fOrder.tag
         SeekInteger(fs); // TArmy(p).fOrder.tag2
      end;
      
      if gSerialVersion>=11 then
      SeekFloat(fs); // TArmy(p).fLastBattleTime
      
      if gSerialVersion>=14 then
      begin
         SeekInteger(fs); // TArmy(p).fOrder.tag3
         SeekFloat(fs);   // TArmy(p).fOrder.tagFloat
      end;
      
      if gSerialVersion>=18 then
      SeekInteger(fs); // TArmy(p).fCurTopZone
      
      if gSerialVersion>=23 then
      SeekInteger(fs); // TArmy(p).fPlIndex
      
      if gSerialVersion>=34 then
      SeekBoolean(fs); // TArmy(p).fActive
      
      if gSerialVersion>=45 then
      SeekFloat(fs); // TArmy(p).fLastArtTime
      
      if gSerialVersion>=46 then
      SeekBoolean(fs); // TArmy(p).fOnEnemyLand
   end;
end;

//
// TAiProtectedBuildingList
//

// _serial_AiProtectedBuildingListWriter
//
procedure _serial_AiProtectedBuildingListWriter(const fs: Integer; var val: TAiProtectedBuildingList; var nam: String; const sm, tp: Integer);
begin
   WriteInteger(fs, val.GetCount);
   var i : Integer;
   for i := 0 to val.GetCount-1 do
   begin
      var p : Pointer = val.Get(i);
      
      var uid : Integer = GetGameObjectUniqueIdByHandle(TAiProtectedBuilding(p).targetHnd);
      WriteInteger(fs, uid);
      WriteInteger(fs, TAiProtectedBuilding(p).aiPriority);
      
      var pbuf : Pointer = TAiProtectedBuilding(p).defenders;
      var ptyp : Pointer = PointerOf(TIntegerList);
      SaveStreamTypeBase(fs, ptyp, pbuf, 'defenders', sm, true);
   end;
end;

// _serial_AiProtectedBuildingListReader
//
procedure _serial_AiProtectedBuildingListReader(const fs: Integer; var val: TAiProtectedBuildingList; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   val.Clear;
   var i, c : Integer;
   ReadInteger(fs, c);
   for i := 0 to c-1 do
   begin
      var p : Pointer = val.Add;
      
      ReadInteger(fs, TAiProtectedBuilding(p).targetHnd);
      ReadInteger(fs, TAiProtectedBuilding(p).aiPriority);
      
      var typdst : Pointer = PointerOf(TIntegerList);
      var typsrc : Pointer = GetTypeBaseByTypeName('TIntegerList', true);
      var pbuf : Pointer = TAiProtectedBuilding(p).defenders;
      MergeStreamTypeBase(fs, typdst, pbuf, 'defenders', sm, true{useproc}, typsrc, cmp=1{compared});
   end;
end;

// _serial_AiProtectedBuildingListSize
//
procedure _serial_AiProtectedBuildingListSize(var res: Integer; var val: TAiProtectedBuildingList; var nam: String; const sm, tp: Integer);
begin
   res := SizeOf(Integer);
   var i: Integer;
   for i := 0 to val.GetCount-1 do
   begin
      var p : Pointer = val.Get(i);
      res := res+SizeOf(Integer); // TAiProtectedBuilding(p).targetHnd
      res := res+SizeOf(Integer); // TAiProtectedBuilding(p).aiPriority
      
      var ptyp : Pointer = PointerOf(TIntegerList);
      var pBuf : Pointer = TAiProtectedBuilding(p).defenders;
      res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'defenders', sm, true);
   end;
end;

// _serial_AiProtectedBuildingListPost
//
procedure _serial_AiProtectedBuildingListPost(var val: TAiProtectedBuildingList{; var nam: String; const sm: Integer});
begin
   var i : Integer;
   for i := 0 to val.GetCount-1 do
   begin
      var p : Pointer = val.Get(i);
      var uid : Integer = TAiProtectedBuilding(p).targetHnd;
      TAiProtectedBuilding(p).targetHnd := GetGameObjectHandleByUniqueId(uid);
   end;
end;

// _serial_AiProtectedBuildingListSeek
//
procedure _serial_AiProtectedBuildingListSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   var i, c : Integer;
   ReadInteger(fs, c);
   for i := 0 to c-1 do
   begin
      SeekInteger(fs); // TAiProtectedBuilding(p).targetHnd
      SeekInteger(fs); // TAiProtectedBuilding(p).aiPriority
      
      var ptyp : Pointer = GetTypeBaseByTypeName('TIntegerList', true);
      SeekStreamTypeBase(fs, ptyp, 'defenders', sm, true);
   end;
end;

//
// TAiData
//

// _serial_AiDataWriter
//
procedure _serial_AiDataWriter(const fs: Integer; var val: TAiData; var nam: String; const sm, tp: Integer);
begin
   WriteInteger(fs, val.basenation);
   WriteBoolean(fs, val.centerfound);
   WriteFloat  (fs, val.centerx);
   WriteFloat  (fs, val.centerz);
   var pbuf: Pointer=val.developmentera;
   WriteBuffer (fs, pbuf, SizeOf(val.developmentera));
   var ptyp: Pointer=PointerOf(TAIBuildingProject); //GetTypeBaseByTypeName('TAIBuildingProject', false);
   var i, j : Integer;
   for i:=0 to gc_ai_max_construction_sites-1 do begin
      pbuf:=val.buildprojects[i];
      SaveStreamTypeBase(fs, ptyp, pbuf, 'buildprojects', sm, true);
   end;
   pbuf:=val.resbalance;
   WriteBuffer (fs, pbuf, SizeOf(val.resbalance));
   
   pbuf := val.defenders;
   ptyp := PointerOf(TIntegerList);
   SaveStreamTypeBase(fs, ptyp, pbuf, 'defenders', sm, true);
   
   pbuf := val.guards;
   SaveStreamTypeBase(fs, ptyp, pbuf, 'guards', sm, true);
   
   pbuf := val.agressors;
   SaveStreamTypeBase(fs, ptyp, pbuf, 'agressors', sm, true);
   
   pbuf := val.freewarriors;
   SaveStreamTypeBase(fs, ptyp, pbuf, 'freewarriors', sm, true);
   
   pbuf := val.armyList;
   ptyp := PointerOf(TArmyList);
   SaveStreamTypeBase(fs, ptyp, pbuf, 'armylist', sm, true);
   
   pbuf := val.defBuildings;
   ptyp := PointerOf(TAiProtectedBuildingList);
   SaveStreamTypeBase(fs, ptyp, pbuf, 'defBuildings', sm, true);
   
   for i := 0 to gc_ai_max_flags-1 do
   WriteBoolean(fs, val.bFlags[i]);
   
   // ver = 5
   WriteBoolean(fs, val.defenceStage);
   WriteBoolean(fs, val.makeDiversion);
   WriteBoolean(fs, val.landBattle);
   
   // ver = 6
   WriteInteger(fs, val.agressorsSent);
   
   // ver = 10
   WriteFloat(fs, val.inittime);
   
   // ver = 14
   for i := 0 to gc_MaxCountryCount-1 do
   for j := 0 to gc_country_maxmembers-1 do
   WriteBoolean(fs, val.avUnits[i][j]);
   
   // ver = 21
   var uid : Integer;
   for i := 0 to gc_MaxCountryCount-1 do
   begin
      if val.officer17[i] <> 0 then
      uid := GetGameObjectUniqueIdByHandle(val.officer17[i])
      else uid := 0;
      WriteInteger(fs, uid);
   end;
   
   for i := 0 to gc_MaxCountryCount-1 do
   begin
      if val.drummer17[i] <> 0 then
      uid := GetGameObjectUniqueIdByHandle(val.drummer17[i])
      else uid := 0;
      WriteInteger(fs, uid);
   end;
   
   for i := 0 to gc_MaxCountryCount-1 do
   begin
      if val.officer18[i] <> 0 then
      uid := GetGameObjectUniqueIdByHandle(val.officer18[i])
      else uid := 0;
      WriteInteger(fs, uid);
   end;
   
   for i := 0 to gc_MaxCountryCount-1 do
   begin
      if val.drummer18[i] <> 0 then
      uid := GetGameObjectUniqueIdByHandle(val.drummer18[i])
      else uid := 0;
      WriteInteger(fs, uid);
   end;
   
   // ver = 24
   WriteBoolean(fs, val.bhumanai);
   WriteBoolean(fs, val.bprogressEconomy);
   WriteBoolean(fs, val.bprogressConstruction);
   WriteBoolean(fs, val.bprogressProduce);
   WriteBoolean(fs, val.bprogressUpgrades);
   WriteBoolean(fs, val.bprogressWar);
   
   // ver = 32
   WriteBoolean(fs, val.waterBattle);
end;

// _serial_AiDataReader
//
procedure _serial_AiDataReader(const fs: Integer; var val: TAiData; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   var maxCountryCount, countryMaxMembers : Integer;
   if gSerialVersion<54 then
   maxCountryCount := 13
   else
   maxCountryCount := gc_MaxCountryCount; // 24
   
   if gSerialVersion<55 then
   countryMaxMembers := 64
   else
   countryMaxMembers := gc_country_maxmembers;
   
   ReadInteger(fs, val.basenation);
   ReadBoolean(fs, val.centerfound);
   ReadFloat  (fs, val.centerx);
   ReadFloat  (fs, val.centerz);
   var pbuf: Pointer;
   var i, j: Integer;
   if gSerialVersion<54 then
   begin
      for i:=0 to maxCountryCount-1 do
      ReadInteger(fs, val.developmentera[i]);
   end
   else
   begin
      pbuf:=val.developmentera;
      ReadBuffer (fs, pbuf, SizeOf(val.developmentera));
   end;
   var typdst: Pointer=PointerOf(TAIBuildingProject);
   var typsrc: Pointer=GetTypeBaseByTypeName('TAIBuildingProject', true);
   for i:=0 to gc_ai_max_construction_sites-1 do begin
      pbuf:=val.buildprojects[i];
      //LoadStreamTypeBase(fs, typdst, pbuf, 'buildprojects', sm, true);
      MergeStreamTypeBase(fs, typdst, pbuf, 'buildprojects', sm, true{useproc}, typsrc, cmp=1{compared});
      
      if gSerialVersion<51 then
      val.buildprojects[i].maxTryDist := -1;
   end;
   pbuf:=val.resbalance;
   ReadBuffer (fs, pbuf, SizeOf(val.resbalance));
   
   if gSerialVersion>=2 then
   begin
      typdst := PointerOf(TIntegerList);
      typsrc := GetTypeBaseByTypeName('TIntegerList', true);
      pbuf := val.defenders;
      MergeStreamTypeBase(fs, typdst, pbuf, 'defenders', sm, true{useproc}, typsrc, cmp=1{compared});
      
      pbuf := val.guards;
      MergeStreamTypeBase(fs, typdst, pbuf, 'guards', sm, true{useproc}, typsrc, cmp=1{compared});
      
      pbuf := val.agressors;
      MergeStreamTypeBase(fs, typdst, pbuf, 'agressors', sm, true{useproc}, typsrc, cmp=1{compared});
      
      pbuf := val.freewarriors;
      MergeStreamTypeBase(fs, typdst, pbuf, 'freewarriors', sm, true{useproc}, typsrc, cmp=1{compared});
      
      typdst := PointerOf(TArmyList);
      typsrc := GetTypeBaseByTypeName('TArmyList', true);
      pbuf := val.armyList;
      MergeStreamTypeBase(fs, typdst, pbuf, 'armylist', sm, true{useproc}, typsrc, cmp=1{compared});
   end;
   
   if gSerialVersion>=4 then
   begin
      typdst := PointerOf(TAiProtectedBuildingList);
      typsrc := GetTypeBaseByTypeName('TAiProtectedBuildingList', true);
      pbuf := val.defBuildings;
      MergeStreamTypeBase(fs, typdst, pbuf, 'defBuildings', sm, true{useproc}, typsrc, cmp=1{compared});
      
      for i := 0 to gc_ai_max_flags-1 do
      ReadBoolean(fs, val.bFlags[i]);
   end;
   
   if gSerialVersion>=5 then
   begin
      ReadBoolean(fs, val.defenceStage);
      ReadBoolean(fs, val.makeDiversion);
      ReadBoolean(fs, val.landBattle);
   end;
   
   if gSerialVersion>=6 then
   ReadInteger(fs, val.agressorsSent);
   
   if gSerialVersion>=10 then
   ReadFloat(fs, val.inittime)
   else
   val.inittime := 0;
   
   if gSerialVersion>=14 then
   begin
      if gSerialVersion<17 then
      begin
         for i := 0 to maxCountryCount-1 do
         for j := 0 to 11-1 do
         ReadBoolean(fs, val.avUnits[i][j]);
      end
      else
      begin
         for i := 0 to maxCountryCount-1 do
         for j := 0 to countryMaxMembers-1 do
         ReadBoolean(fs, val.avUnits[i][j]);
      end;
   end;
   
   if gSerialVersion>=21 then
   begin
      var uid : Integer;
      for i := 0 to maxCountryCount-1 do
      begin
         ReadInteger(fs, uid);
         val.officer17[i] := GetGameObjectHandleByUniqueId(uid);
      end;
      
      for i := 0 to maxCountryCount-1 do
      begin
         ReadInteger(fs, uid);
         val.drummer17[i] := GetGameObjectHandleByUniqueId(uid);
      end;
      
      for i := 0 to maxCountryCount-1 do
      begin
         ReadInteger(fs, uid);
         val.officer18[i] := GetGameObjectHandleByUniqueId(uid);
      end;
      
      for i := 0 to maxCountryCount-1 do
      begin
         ReadInteger(fs, uid);
         val.drummer18[i] := GetGameObjectHandleByUniqueId(uid);
      end;
   end
   else
   begin
      for i := 0 to maxCountryCount-1 do
      begin
         val.officer17[i] := 0;
         val.drummer17[i] := 0;
         val.officer18[i] := 0;
         val.drummer18[i] := 0;
      end;
   end;
   
   if gSerialVersion>=24 then
   begin
      ReadBoolean(fs, val.bhumanai);
      ReadBoolean(fs, val.bprogressEconomy);
      ReadBoolean(fs, val.bprogressConstruction);
      ReadBoolean(fs, val.bprogressProduce);
      ReadBoolean(fs, val.bprogressUpgrades);
      ReadBoolean(fs, val.bprogressWar);
   end
   else
   begin
      val.bhumanai := False;
      val.bprogressEconomy := True;
      val.bprogressConstruction := True;
      val.bprogressProduce := True;
      val.bprogressUpgrades := True;
      val.bprogressWar := True;
   end;
   
   if gSerialVersion>=32 then
   begin
      ReadBoolean(fs, val.waterBattle);
      if gSerialVersion<38 then
      val.waterBattle := true;
   end
   else
   val.waterBattle := true;
end;

// _serial_AiDataSize
//
procedure _serial_AiDataSize(var res: Integer; var val: TAiData; var nam: String; const sm, tp: Integer);
begin
   var maxCountryCount, countryMaxMembers : Integer;
   if gSerialVersion<54 then
   maxCountryCount := 13
   else
   maxCountryCount := gc_MaxCountryCount; // 24
   
   if gSerialVersion<55 then
   countryMaxMembers := 64
   else
   countryMaxMembers := gc_country_maxmembers;
   
   res:=0;
   res:=res+SizeOf(Integer);            //val.basenation
   res:=res+SizeOf(Boolean);            //val.centerfound
   res:=res+SizeOf(Float);              //val.centerx
   res:=res+SizeOf(Float);              //val.centerz
   
   var i: Integer;
   if gSerialVersion<54 then
   begin
      for i:=0 to maxCountryCount-1 do
      res:=res+SizeOf(Integer);
   end
   else
   res:=res+SizeOf(val.developmentera); //val.developmentera
   var ptyp: Pointer=PointerOf(TAIBuildingProject); //GetTypeBaseByTypeName('TAIBuildingProject', false); //gSerialMode: Integer; // 0 - none; 1 - serial; 2 - unserial;
   for i:=0 to gc_ai_max_construction_sites-1 do begin
      var pbuf: Pointer=val.buildprojects[i];
      res:=res+GetStreamSizeTypeBase(ptyp, pbuf, 'buildprojects', sm, true);
   end;
   res:=res+SizeOf(val.resbalance);
   
   ptyp := PointerOf(TIntegerList);
   var pBuf : Pointer = val.defenders;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'defenders', sm, true);
   
   pBuf := val.guards;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'guards', sm, true);
   
   pBuf := val.agressors;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'agressors', sm, true);
   
   pBuf := val.freewarriors;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'freewarriors', sm, true);
   
   ptyp := PointerOf(TArmyList);
   pBuf := val.armyList;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'armylist', sm, true);
   
   ptyp := PointerOf(TAiProtectedBuildingList);
   pBuf := val.defBuildings;
   res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'defBuildings', sm, true);
   
   res := res + gc_ai_max_flags*SizeOf(Boolean);
   
   // ver = 5
   res:=res+SizeOf(Boolean); //val.defenceStage
   res:=res+SizeOf(Boolean); //val.makeDiversion
   res:=res+SizeOf(Boolean); //val.landBattle
   
   // ver = 6
   res:=res+SizeOf(Integer); //val.agressorsSent
   
   // ver = 10
   res:=res+SizeOf(Float); //val.inittime
   
   // ver = 17 (14)
   res := res + maxCountryCount * countryMaxMembers * SizeOf(Boolean); //val.avUnits
   
   // ver = 21
   res := res + maxCountryCount * SizeOf(Integer); //val.officer17
   res := res + maxCountryCount * SizeOf(Integer); //val.drummer17
   res := res + maxCountryCount * SizeOf(Integer); //val.officer18
   res := res + maxCountryCount * SizeOf(Integer); //val.drummer18
   
   // ver = 24
   res := res + SizeOf(Boolean); //val.bhumanai
   res := res + SizeOf(Boolean); //val.bprogressEconomy
   res := res + SizeOf(Boolean); //val.bprogressConstruction
   res := res + SizeOf(Boolean); //val.bprogressProduce
   res := res + SizeOf(Boolean); //val.bprogressUpgrades
   res := res + SizeOf(Boolean); //val.bprogressWar
   
   // ver = 32
   res := res + SizeOf(Boolean); //val.waterBattle
end;

// _serial_AiDataPost
//
procedure _serial_AiDataPost(var val: TAiData; var nam: String; const sm: Integer);
begin
   if gSerialVersion<17 then
   begin
      var i, j : Integer;
      for i := 0 to gc_MaxCountryCount-1 do
      for j := 0 to gc_country_maxmembers-1 do
      val.avUnits[i][j] := true;
   end;
end;

// _serial_AiDataSeek
//
procedure _serial_AiDataSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   var maxCountryCount, countryMaxMembers : Integer;
   if gSerialVersion<54 then
   maxCountryCount := 13
   else
   maxCountryCount := gc_MaxCountryCount; // 24
   
   if gSerialVersion<55 then
   countryMaxMembers := 64
   else
   countryMaxMembers := gc_country_maxmembers;
   
   SeekInteger(fs); //val.basenation
   SeekBoolean(fs); //val.centerfound
   SeekFloat  (fs); //val.centerx
   SeekFloat  (fs); //val.centerz
   SeekBuffer (fs, maxCountryCount*SizeOf(Integer){SizeOf(TAiData.developmentera)});
   var ptyp: Pointer=GetTypeBaseByTypeName('TAIBuildingProject', true);
   var i: Integer;
   for i:=0 to gc_ai_max_construction_sites-1 do
   SeekStreamTypeBase(fs, ptyp, 'buildprojects', sm, true{useproc});
   SeekBuffer (fs, gc_ResCount*3*SizeOf(Integer){SizeOf(TAiData.resbalance)});
   
   if gSerialVersion>=2 then
   begin
      var ptyp : Pointer = GetTypeBaseByTypeName('TIntegerList', true);
      
      SeekStreamTypeBase(fs, ptyp, 'defenders', sm, true);
      SeekStreamTypeBase(fs, ptyp, 'guards', sm, true);
      SeekStreamTypeBase(fs, ptyp, 'agressors', sm, true);
      SeekStreamTypeBase(fs, ptyp, 'freewarriors', sm, true);
      
      ptyp := GetTypeBaseByTypeName('TArmyList', true);
      SeekStreamTypeBase(fs, ptyp, 'armylist', sm, true);
   end;
   
   if gSerialVersion>=4 then
   begin
      ptyp := GetTypeBaseByTypeName('TAiProtectedBuildingList', true);
      SeekStreamTypeBase(fs, ptyp, 'defBuildings', sm, true);
      
      SeekBuffer (fs, gc_ai_max_flags*SizeOf(Boolean));
   end;
   
   if gSerialVersion>=5 then
   begin
      SeekBoolean(fs); //val.defenceStage
      SeekBoolean(fs); //val.makeDiversion
      SeekBoolean(fs); //val.landBattle
   end;
   
   if gSerialVersion>=6 then
   SeekInteger(fs); //val.agressorsSent
   
   if gSerialVersion>=10 then
   SeekFloat(fs); //val.inittime
   
   if gSerialVersion>=14 then
   begin
      if gSerialVersion<17 then
      SeekBuffer(fs, maxCountryCount * 11 * SizeOf(Boolean)) //val.avUnits
      else
      SeekBuffer(fs, maxCountryCount * countryMaxMembers * SizeOf(Boolean)) //val.avUnits
   end;
   
   if gSerialVersion>=21 then
   begin
      SeekBuffer(fs, maxCountryCount * SizeOf(Integer)); //val.officer17
      SeekBuffer(fs, maxCountryCount * SizeOf(Integer)); //val.drummer17
      SeekBuffer(fs, maxCountryCount * SizeOf(Integer)); //val.officer18
      SeekBuffer(fs, maxCountryCount * SizeOf(Integer)); //val.drummer18
   end;
   
   if gSerialVersion>=24 then
   begin
      SeekBoolean(fs); //val.bhumanai
      SeekBoolean(fs); //val.bprogressEconomy
      SeekBoolean(fs); //val.bprogressConstruction
      SeekBoolean(fs); //val.bprogressProduce
      SeekBoolean(fs); //val.bprogressUpgrades
      SeekBoolean(fs); //val.bprogressWar
   end;
   
   if gSerialVersion>=32 then
   SeekBoolean(fs); //val.waterBattle
end;

//
// TPlayer
//

// _serial_PlayerPost
//
procedure _serial_PlayerPost(var val: TPlayer{; var nam: String; const sm: Integer});
begin
   var plInd : Integer = val.id;
   var i, j : Integer;
   var count : Integer = gPlayer[plInd].aiData.armyList.GetCount;
   var sqCount : Integer = gPlayer[plInd].squads.GetCount;
   for i := 0 to count-1 do
   begin
      var pArmy : Pointer = gPlayer[plInd].aiData.armyList.Get(i);
      for j := TArmy(pArmy).fSquadList.GetCount-1 downto 0 do
      begin
         var pArSquad : Pointer = TArmy(pArmy).fSquadList.GetPointer(j);
         var ind : Integer = PointerToAddr(pArSquad);
         
         var pSquad : Pointer = gPlayer[plInd].squads.Get(ind);
         if pSquad <> nil then
         TArmy(pArmy).fSquadList.SetPointer(pSquad, j)
         else
         TArmy(pArmy).fSquadList.Delete(j);
      end;
   end;
   
   if (gSerialVersion<30) then
   begin
      for i:=0 to gc_ResCount-1 do
      begin
         val.setres[i] := val.res[i];
         val.lanres[i] := val.res[i];
      end;
   end;
   
   val.lastcheckexists := plInd*0.25+gc_global_TimeCheckExists;
   val.lastcalcsquadsmovecounttime := plInd*0.25+gc_global_TimeCalcSquadsMoveCount;
   val.lastprogressaitime := plInd*0.25+gc_global_TimeProgressAI;
   val.lastseedwheattime := plInd*0.25+gc_global_TimeSeedWheat;
   
   _player_GetOrCreateEnemyInfo(plInd);
end;

//
// TTower
//

// _serial_TowerWriter
//
procedure _serial_TowerWriter(const fs: Integer; var val: TTower; var nam: String; const sm, tp: Integer);
begin
   if val.hnd <> 0 then
   val.hnd := GetGameObjectUniqueIdByHandle(val.hnd);
   
   var typ : Pointer = AddrToPointer(tp);
   var addr: Pointer = val;
   SaveStreamTypeBase(fs, typ, addr, nam, sm, false);
   
   if val.hnd <> 0 then
   val.hnd := GetGameObjectHandleByUniqueId(val.hnd);
end;

// _serial_TowerReader
//
procedure _serial_TowerReader(const fs: Integer; var val: TTower; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   var typdst: Pointer=AddrToPointer(tpd);
   var typsrc: Pointer=AddrToPointer(tps);
   var addr  : Pointer=val;
   MergeStreamTypeBase(fs, typdst, addr, nam, sm, false{useproc}, typsrc, cmp=1{compared});
end;

// _serial_TowerSize
//
procedure _serial_TowerSize(var res: Integer; var val: TTower; var nam: String; const sm, tp: Integer);
begin
   var typ : Pointer=AddrToPointer(tp);
   var addr: Pointer=val;
   res:=GetStreamSizeTypeBase(typ, addr, nam, sm, false);
end;

// _serial_TowerPost
//
procedure _serial_TowerPost(var val: TTower{; var nam: String; const sm: Integer});
begin
   if val.hnd <> 0 then
   val.hnd := GetGameObjectHandleByUniqueId(val.hnd);
end;

// _serial_TowerSeek
//
procedure _serial_TowerSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   var typ: Pointer=AddrToPointer(tp);
   SeekStreamTypeBase(fs, typ, nam, sm, false{useproc});
end;

//
// TEnemyInfoList
//

// _serial_EnemyInfoListWriter
//
procedure _serial_EnemyInfoListWriter(const fs: Integer; var val: TEnemyInfoList; var nam: String; const sm, tp: Integer);
begin
   var count : Integer = val.GetCount;
   WriteInteger(fs, count);
   var i, j : Integer;
   for i := 0 to count-1 do
   begin
      var p : Pointer = val.Get(i);
      var tCount : Integer = TEnemyInfo(p).towers.GetCount;
      WriteInteger(fs, tCount);
      var ptyp : Pointer = PointerOf(TTower);
      for j := 0 to tCount-1 do
      begin
         var pBuf : Pointer = TEnemyInfo(p).towers.Get(j);
         SaveStreamTypeBase(fs, ptyp, pbuf, 'towers', sm, true);
      end;
      
      var pbuf : Pointer = TEnemyInfo(p).towerMap;
      WriteBuffer(fs, pbuf, SizeOf(TEnemyInfo(p).towerMap));
      
      WriteInteger(fs, TEnemyInfo(p).team);
      WriteInteger(fs, TEnemyInfo(p).enemyMask);
      WriteBoolean(fs, TEnemyInfo(p).changed);
      WriteBoolean(fs, TEnemyInfo(p).enabled);
      
      // ver = 12
      pbuf := TEnemyInfo(p).armyInfos;
      ptyp := PointerOf(TArmyInfoList);
      SaveStreamTypeBase(fs, ptyp, pbuf, 'armyInfos', sm, true);
   end;
end;

// _serial_EnemyInfoListReader
//
procedure _serial_EnemyInfoListReader(const fs: Integer; var val: TEnemyInfoList; var nam: String; const sm, tpd, tps, cmp: Integer);
begin
   val.Clear;
   var count : Integer;
   ReadInteger(fs, count);
   var i, j : Integer;
   for i := 0 to count-1 do
   begin
      var p : Pointer = val.Add;
      var tCount : Integer;
      ReadInteger(fs, tCount);
      if tCount > 0 then
      begin
         var typdst: Pointer=PointerOf(TTower);
         var typsrc: Pointer=GetTypeBaseByTypeName('TTower', true);
         for j := 0 to tCount-1 do
         begin
            var pbuf : Pointer = TEnemyInfo(p).towers.Add(0);
            MergeStreamTypeBase(fs, typdst, pbuf, 'towers', sm, true, typsrc, cmp=1);
         end;
      end;
      
      var pbuf : Pointer = TEnemyInfo(p).towerMap;
      if gSerialVersion<53 then
      ReadBuffer(fs, pbuf, SizeOf(Float)*80*80)
      else
      ReadBuffer(fs, pbuf, SizeOf(TEnemyInfo(p).towerMap));
      
      ReadInteger(fs, TEnemyInfo(p).team);
      ReadInteger(fs, TEnemyInfo(p).enemyMask);
      ReadBoolean(fs, TEnemyInfo(p).changed);
      ReadBoolean(fs, TEnemyInfo(p).enabled);
      
      if gSerialVersion>=12 then
      begin
         var typdst: Pointer=PointerOf(TArmyInfoList);
         var typsrc: Pointer=GetTypeBaseByTypeName('TArmyInfoList', false);
         var pbuf : Pointer = TEnemyInfo(p).armyInfos;
         MergeStreamTypeBase(fs, typdst, pbuf, 'armyinfos', sm, true, typsrc, cmp=1);
      end;
   end;
end;

// _serial_EnemyInfoListSize
//
procedure _serial_EnemyInfoListSize(var res: Integer; var val: TEnemyInfoList; var nam: String; const sm, tp: Integer);
begin
   res := SizeOf(Integer);
   var count : Integer = val.GetCount;
   var i, j : Integer;
   for i := 0 to count-1 do
   begin
      var p : Pointer = val.Get(i);
      res := res + SizeOf(Integer);
      var tCount : Integer = TEnemyInfo(p).towers.GetCount;
      if tCount > 0 then
      begin
         var ptyp: Pointer = PointerOf(TTower);
         for j := 0 to tCount-1 do
         begin
            var pbuf: Pointer = TEnemyInfo(p).towers.Get(j);
            res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'towers', sm, true);
         end;
      end;
      
      if gSerialVersion<53 then
      res := res + SizeOf(Float)*80*80
      else
      res := res + SizeOf(TEnemyInfo(p).towerMap);
      
      res := res + SizeOf(Integer); //TEnemyInfo(p).team
      res := res + SizeOf(Integer); //TEnemyInfo(p).enemyMask
      res := res + SizeOf(Boolean); //TEnemyInfo(p).changed
      res := res + SizeOf(Boolean); //TEnemyInfo(p).enabled
      
      var ptyp: Pointer = PointerOf(TArmyInfoList);
      var pbuf: Pointer = TEnemyInfo(p).armyInfos;
      res := res + GetStreamSizeTypeBase(ptyp, pbuf, 'armyInfos', sm, true);
   end;
end;

// _serial_EnemyInfoListSeek
//
procedure _serial_EnemyInfoListSeek(const fs: Integer; var nam: String; const sm, tp: Integer);
begin
   var i, count : Integer;
   ReadInteger(fs, count);
   for i := 0 to count-1 do begin
      var n: Integer;
      ReadInteger(fs, n);
      if n > 0 then
      begin
         var j : Integer;
         var ptyp : Pointer = GetTypeBaseByTypeName('TTower', true);
         for j := 0 to n-1 do
         SeekStreamTypeBase(fs, ptyp, 'towers', sm, true{useproc});
      end;
      
      if gDataVersion<53 then
      SeekBuffer(fs, SizeOf(Float)*80*80)
      else
      SeekBuffer(fs, SizeOf(Float)*gc_scangrid_countx*gc_scangrid_county);
      
      SeekInteger(fs);
      SeekInteger(fs);
      SeekBoolean(fs);
      SeekBoolean(fs);
      
      if gSerialVersion>=12 then
      begin
         var ptyp : Pointer = GetTypeBaseByTypeName('TArmyInfoList', true);
         SeekStreamTypeBase(fs, ptyp, 'armyinfos', sm, true{useproc});
      end;
   end;
end;

