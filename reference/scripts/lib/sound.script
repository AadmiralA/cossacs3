//
// sound.script
//

type TSoundLibraryGroups = class
   mincount : Integer;
   maxcount : Integer;
   sndind : Integer;
   loudness : Float;
end;

type TSoundLibrary = class
   loudness : Float;
   count : Integer;
   sndfreq : Integer;
   groupscount : Integer;
   list : array [0..gc_soundlibrary_sounds_maxcount-1] of String;
   groups : array [0..gc_soundlibrary_soundgroups_maxcount-1] of TSoundLibraryGroups;
end;

global gSoundLibrary : array [0..gc_soundlibrary_maxcount-1] of TSoundLibrary;

// _sound_GetIndexesByTag
//
procedure _sound_GetIndexesByTag(const tag : Integer; var sndlibindex, sndindex : Integer);
begin
   sndlibindex := tag div gc_soundlibrary_sounds_maxcount;
   sndindex := tag mod gc_soundlibrary_sounds_maxcount;
end;

// _sound_GetTagByIndexes
//
function _sound_GetTagByIndexes(const sndlibindex, sndindex : Integer) : Integer;
begin
   Result := (sndlibindex*gc_soundlibrary_sounds_maxcount)+sndindex;
end;

// _sound_AddSoundToSoundLibrary
//
procedure _sound_AddSoundToSoundLibrary(const sndlibindex : Integer; const sound : String; const loudness : Float; const sndfreq : Integer);
begin
   var ind : Integer = gSoundLibrary[sndlibindex].count;
   if (ind<gc_soundlibrary_sounds_maxcount) then
   begin
      gSoundLibrary[sndlibindex].list[ind] := sound;
      //var tag : Integer = _sound_GetTagByIndexes(sndlibindex, ind);
      //SndGetOrCreateSound(tag, 'units', GetSoundManagerListenerHandle);
      gSoundLibrary[sndlibindex].count := ind+1;
      gSoundLibrary[sndlibindex].loudness := loudness;
      gSoundLibrary[sndlibindex].sndfreq := sndfreq;
   end
   else
   ErrorLog('sound : AddSoundToSoundLibrary count out of bounds');
end;

// _sound_AddSoundToSoundLibraryGroup
//
procedure _sound_AddSoundToSoundLibraryGroup(const sndlibindex, sndgrouplibindex, mincount, maxcount, loudness : Integer);
begin
   if (gSoundLibrary[sndlibindex].groupscount<(gc_soundlibrary_soundgroups_maxcount-1)) then
   begin
      gSoundLibrary[sndlibindex].groups[gSoundLibrary[sndlibindex].groupscount].sndind := sndgrouplibindex;
      gSoundLibrary[sndlibindex].groups[gSoundLibrary[sndlibindex].groupscount].mincount := mincount;
      gSoundLibrary[sndlibindex].groups[gSoundLibrary[sndlibindex].groupscount].maxcount := maxcount;
      gSoundLibrary[sndlibindex].groups[gSoundLibrary[sndlibindex].groupscount].loudness := loudness;
      gSoundLibrary[sndlibindex].groupscount := gSoundLibrary[sndlibindex].groupscount+1;
   end;
end;

// _sound_ClearSoundLibrary
//
procedure _sound_ClearSoundLibrary();
begin
   var i, j : Integer;
   for i:=0 to gc_soundlibrary_maxcount-1 do
   begin
      gSoundLibrary[i].count := 0;
      gSoundLibrary[i].groupscount := 0;
      gSoundLibrary[i].loudness := 0;
      for j:=0 to gc_soundlibrary_sounds_maxcount-1 do
      gSoundLibrary[i].list[j] := '';
      for j:=0 to gc_soundlibrary_soundgroups_maxcount-1 do
      begin
         gSoundLibrary[i].groups[j].mincount := 0;
         gSoundLibrary[i].groups[j].maxcount := 0;
         gSoundLibrary[i].groups[j].sndind := 0;
         gSoundLibrary[i].groups[j].loudness := 0;
      end;
   end;
end;

