// _sound_EmitterPlaySound
//
function _sound_EmitterPlaySound(const emitterHnd : Integer; const libind, sndlibind : Integer; bplayuniq : Boolean) : Integer;
begin
   if (emitterHnd<>0) then
   begin
      var newind : Integer;
      var rndind : Integer;
      var maxind : Integer = gSoundLibrary[sndlibind].count-1;
      if (maxind>0) then
      rndind := floor(random*(maxind+1));
      var i : Integer;
      for i:=0 to maxind do
      begin
         newind := rndind+i;
         if (newind>maxind) then
         newind := newind-maxind-1;
         var libname : String;
         case libind of
            gc_sndlib_ind_units : libname := 'units';
            gc_sndlib_ind_interface : libname := 'interface';
            gc_sndlib_ind_ambient : libname := 'ambient';
         end;
         var sndTag : Integer;
         if (not bplayuniq) then
         sndtag := _sound_GetTagByIndexes(sndlibind, newind)
         else
         sndtag := 1000000+sndlibind;
         //var sndtag : Integer = floor(random*1000000);
         Result := sndtag;
         //SndRemoveSound(sndtag, emitterHnd);
         
         var sndHnd : Integer = SndGetOrCreateSound(sndtag, libname, emitterHnd);
         if (not GetSndSoundPlaying(sndHnd)) then
         begin
            gint_dbg_logsoundcount := gint_dbg_logsoundcount+1;
            SetSndSoundSourceName(gSoundLibrary[sndlibind].list[newind], sndHnd);
            //if (not gbool_profiler_enabled) then
            //log('_sound_EmitterPlaySound : '+gSoundLibrary[sndlibind].list[newind]);
            SetSndSoundRadius({40}8000, sndHnd); //80 - for 3D sound, 8000 for isometric sound
            //SetSndSoundRadiuses(10, 60, sndHnd);
            SetSndSoundPlaying(True, sndHnd);
            break;
         end;
      end;
   end
   else
   Result := 0;
end;

// _sound_EmitterFadeSound
//
function _sound_EmitterFadeSound(const emitterHnd : Integer; const libind, sndlibind : Integer; bplayuniq, fadein : Boolean; fadetime : Float; bloop : Boolean) : Integer;
begin
   if (emitterHnd<>0) then
   begin
      var newind : Integer;
      var rndind : Integer;
      var maxind : Integer = gSoundLibrary[sndlibind].count-1;
      if (maxind>0) then
      rndind := floor(random*(maxind+1));
      var i : Integer;
      for i:=0 to maxind do
      begin
         newind := rndind+i;
         if (newind>maxind) then
         newind := newind-maxind-1;
         var libname : String;
         case libind of
            gc_sndlib_ind_units : libname := 'units';
            gc_sndlib_ind_interface : libname := 'interface';
            gc_sndlib_ind_ambient : libname := 'ambient';
         end;
         var sndTag : Integer;
         if (not bplayuniq) then
         sndtag := _sound_GetTagByIndexes(sndlibind, newind)
         else
         sndtag := 1000000+sndlibind;
         //var sndtag : Integer = floor(random*1000000);
         Result := sndtag;
         //SndRemoveSound(sndtag, emitterHnd);
         
         var sndHnd : Integer = SndGetOrCreateSound(sndtag, libname, emitterHnd);
         //SetSndSoundPlaying(False, sndHnd);
         var bPlaying : Boolean = GetSndSoundPlaying(sndHnd);
         if ((fadein) and (not bPlaying)) or ((not fadein) and (bPlaying)) then
         begin
            //if (not gbool_profiler_enabled) then
            //log('_sound_EmitterFadeSound : fadein='+BoolToStr(fadein)+' '+gSoundLibrary[sndlibind].list[newind]);
            SetSndSoundSourceName(gSoundLibrary[sndlibind].list[newind], sndHnd);
            SetSndSoundRandomOffset(0, sndHnd);
            SetSndSoundRadius(8000, sndHnd); //80 - for 3D sound, 8000 for isometric sound
            SetSndSoundMaxRadius(0, sndHnd);
            SetSndSoundLoop(bloop, sndHnd);
            if (fadetime=0) then
            SetSndSoundPlaying(fadein, sndHnd)
            else
            SetSndSoundFadePlaying(fadein, fadetime, sndHnd);
            break;
         end;
      end;
   end
   else
   Result := 0;
end;

// _sound_PlaySound
//
function _sound_PlaySound(const libind, sndlibind : Integer) : Boolean;
begin
   Result := False;
   var newind : Integer;
   var rndind : Integer;
   var maxind : Integer = gSoundLibrary[sndlibind].count-1;
   if (maxind>0) then
   rndind := floor(random*(maxind+1));
   var i : Integer;
   for i:=0 to maxind do
   begin
      newind := rndind+i;
      if (newind>maxind) then
      newind := newind-maxind-1;
      var sndTag : Integer = _sound_GetTagByIndexes(sndlibind, newind);
      var libname : String;
      case libind of
         gc_sndlib_ind_units : libname := 'units';
         gc_sndlib_ind_interface : libname := 'interface';
         gc_sndlib_ind_ambient : libname := 'ambient';
      end;
      var sndHnd : Integer = SndGetOrCreateSound(sndTag, libname, GetSoundManagerListenerHandle);
      if (not GetSndSoundPlaying(sndHnd)) then
      begin
         Result := True;
         gint_dbg_logsoundcount := gint_dbg_logsoundcount+1;
         SetSndSoundSourceName(gSoundLibrary[sndlibind].list[newind], sndHnd);
         if (False) then
         log('units'+' ind='+IntToStr(sndlibind)+' snd='+gSoundLibrary[sndlibind].list[newind]);
         SetSndSoundRandomOffset(0, sndHnd);
         SetSndSoundRadius(8000, sndHnd); //80 - for 3D sound, 8000 for isometric sound
         SetSndSoundMaxRadius(0, sndHnd);
         SetSndSoundPlaying(True, sndHnd);
         break;
      end;
   end;
end;

// _sound_RequestPlaySound
//
procedure _sound_RequestPlaySound(const libind, sndlibind : Integer; const posx, posz : Float);
begin
   var gridx, gridy : Integer;
   if (_misc_PosToSoundGridIndices(posx, posz, gridx, gridy)) then
   begin
      gint_dbg_logrequestsoundcount := gint_dbg_logrequestsoundcount+1;
      var psoundgrid : Pointer = gSoundGrid[gridx, gridy];
      TSoundGrid(psoundgrid).sndrequests[sndlibind] := TSoundGrid(psoundgrid).sndrequests[sndlibind]+1;
      TSoundGrid(psoundgrid).bsndrequestexist := True;
   end;
end;

// _sound_MusicSwitchToBattle
//
procedure _sound_MusicSwitchToBattle();
begin
   var musthread : Integer = GetSndAmbientThreadHandleByName('music');
   var batthread : Integer = GetSndAmbientThreadHandleByName('battle');
   if (not GetSndAmbientThreadSetPlaying(batthread)) then
   begin
      //SetSndAmbientThreadLoop(False, musthread);
      SetSndAmbientThreadSetPlayingFade(musthread, False, 3);
      
      SetSndAmbientThreadSetPlayingFade(batthread, True, 5);
      SetSndAmbientThreadResetCurrentDelay(batthread);
      
      gfloat_gui_musiclastbattletimestart := GetCurrentTime;
      gfloat_gui_musiclastnationaltimeend := GetCurrentTime;
      Log('Music Switch To Battle : time = '+FloatToStr(GetCurrentTime));
   end;
end;

// _sound_MusicSwitchToNational
//
procedure _sound_MusicSwitchToNational();
begin
   var musthread : Integer = GetSndAmbientThreadHandleByName('music');
   var batthread : Integer = GetSndAmbientThreadHandleByName('battle');
   if (not GetSndAmbientThreadSetPlaying(musthread)) then
   begin
      //SetSndAmbientThreadLoop(False, batthread);
      SetSndAmbientThreadSetPlayingFade(batthread, False, 3);
      
      SetSndAmbientThreadSetPlayingFade(musthread, True, 5);
      SetSndAmbientThreadResetCurrentDelay(musthread);
      
      gfloat_gui_musiclastnationaltimestart := GetCurrentTime;
      gfloat_gui_musiclastbattletimeend := GetCurrentTime;
      Log('Music Switch To National : time = '+FloatToStr(GetCurrentTime));
   end;
end;

_sound_InitSoundLibrary;
