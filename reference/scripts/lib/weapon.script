   function GetWeaponIDBySIDConst(const weaponsid : String) : Integer;
   begin
      var tweaponsid : String = weaponsid;
      Result := _weapon_GetWeaponIdBySID(tweaponsid);
   end;
   
   // Sound
   _weapon_SetWeaponSound('SHOTMUSKET', gc_snd_ind_musket);
   _weapon_SetWeaponSound('PPOINTT', gc_snd_ind_shotcannon);
   _weapon_SetWeaponSound('PPOINTTTOW', gc_snd_ind_shotcannon);
   _weapon_SetWeaponSound('PPOINTTKOR', gc_snd_ind_shotship);
   _weapon_SetWeaponSound('PSMPOINTTPUS', gc_snd_ind_shotcannoncannister);
   _weapon_SetWeaponSound('DIMMORT1', gc_snd_ind_shothowitzer);
   _weapon_SetWeaponSound('DIMMORT2NEW', gc_snd_ind_shotmortar);
   _weapon_SetWeaponSound('DIMMORT2KOR', gc_snd_ind_shotmortar);
   _weapon_SetWeaponSound('PSMPOINTT', gc_snd_ind_shotmulticannon);
   
   _weapon_SetWeaponSound('PUEXPBLD', gc_snd_ind_cannonballhitbuilding);
   _weapon_SetWeaponSound('PUEXP', gc_snd_ind_explcannon);
   _weapon_SetWeaponSound('PUEXPONSHIP', gc_snd_ind_cannonballhitship);
   _weapon_SetWeaponSound('PUEXPKORVSKOR', gc_snd_ind_cannonballhitship);
   _weapon_SetWeaponSound('PUEXPHOWITZERBLD', gc_snd_ind_cannonballhitbuilding);
   _weapon_SetWeaponSound('PUEXPHOWITZER', gc_snd_ind_explhowitzer);
   _weapon_SetWeaponSound('PUNOEXP', gc_snd_ind_none);
   _weapon_SetWeaponSound('VODABUL', gc_snd_ind_watersplash);
   _weapon_SetWeaponSound('VODABUL2', gc_snd_ind_watersplash);
   //_weapon_SetWeaponSound('SMALL2', gc_snd_ind_mortarballhitground);
   _weapon_SetWeaponSound('STRELDEZPRO', gc_snd_ind_arrowimpact);
   _weapon_SetWeaponSound('STRELA', gc_snd_ind_arrow);
   _weapon_SetWeaponSound('OSTRELA', gc_snd_ind_firearrow);
   _weapon_SetWeaponSound('POINTSTONE4', gc_snd_ind_cannonballhitbuilding); // weapon, when mortar ball hit building
   _weapon_SetWeaponSound('PPOINTTFRAME', gc_snd_ind_shotcannon); //choose the best
   _weapon_SetWeaponSound('PPOINTTFRAME5', gc_snd_ind_shotship); //choose the best
   // Trail
   _weapon_SetWeaponTrail('NUCL2P', cFXTrailCannonBall);
   _weapon_SetWeaponTrail('NUCL2PTOW', cFXTrailCannonBall);
   _weapon_SetWeaponTrail('NUCL2PKOR', cFXTrailCannonBallShip);
   _weapon_SetWeaponTrail('NUCL3M', cFXTrailHowitzerBall);
   _weapon_SetWeaponTrail('NUCL3MONO', cFXTrailMortarBall);
   _weapon_SetWeaponTrail('NUCL3MONONEW', cFXTrailMortarBall);
   _weapon_SetWeaponTrail('NUCL3MONONEWDMG', cFXTrailMortarBall);
   _weapon_SetWeaponTrail('NUCLGRE', cFXTrailGrenade);
   _weapon_SetWeaponTrail('NUCLMOSKOL', cFXTrailHowitzerBallFragment);
   _weapon_SetWeaponTrail('STRELA', cFXTrailArrow);
   _weapon_SetWeaponTrail('OSTRELA', cFXTrailFireArrow);
   _weapon_SetWeaponTrail('debriswood', cFXTrailDebrisWood);
   _weapon_SetWeaponTrail('debrisstone', cFXTrailDebrisStone);
   _weapon_SetWeaponTrail('PPOINTTFRAME', cFXTrailGrenade);
   
   // Use owner damage
   _weapon_SetWeaponUseOwnerDamage('STRELA');
   _weapon_SetWeaponUseOwnerDamage('OSTRELA');
   _weapon_SetWeaponUseOwnerDamage('NUCLGRE');
   //_weapon_SetWeaponUseOwnerDamage('PPOINTTFRAME');
   // Use explosion decal
   const cExpDecNameDef = 'groundexp';
   _weapon_SetWeaponUseExpDecal('NUCL2P', cExpDecNameDef);
   _weapon_SetWeaponUseExpDecal('NUCL2PTOW', cExpDecNameDef);
   _weapon_SetWeaponUseExpDecal('NUCL2PKOR', cExpDecNameDef);
   _weapon_SetWeaponUseExpDecal('NUCL3M', cExpDecNameDef);
   _weapon_SetWeaponUseExpDecal('NUCL3MONO', cExpDecNameDef);
   _weapon_SetWeaponUseExpDecal('NUCL3MONONEW', cExpDecNameDef);
   
   // turn off collision detection for mass projectiles
   var id : Integer = GetWeaponIDBySIDConst('STRELA');
   if (id>-1) then
   gWeapons[id].bcollisiondetection := False;
   
   id := GetWeaponIDBySIDConst('OSTRELA');
   if (id>-1) then
   gWeapons[id].bcollisiondetection := False;
   //gWeapons[GetWeaponIDBySIDConst('OSTRELA')].bcollisiondetection := False;
   
   id := GetWeaponIDBySIDConst('SMALL2');
   if (id>-1) then
   gWeapons[id].volumeclippedfreq := 0.9;
   
   id := GetWeaponIDBySIDConst('SHOTMUSKET');
   if (id>-1) then
   gWeapons[id].volumeclippedfreq := 0.75;
   
   // turn on rotation
   id := GetWeaponIDBySIDConst('STRELA');
   if (id>-1) then
   gWeapons[id].brotate := True;
   id := GetWeaponIDBySIDConst('OSTRELA');
   if (id>-1) then
   gWeapons[id].brotate := True;
   
   // turn off bcheckfriendonline
   _weapon_SetWeaponCheckFriendOnLine('STRELA', False);
   _weapon_SetWeaponCheckFriendOnLine('OSTRELA', False);
   _weapon_SetWeaponCheckFriendOnLine('SHOTMUSKET', False);
   _weapon_SetWeaponCheckFriendOnLine('SHOTBLOCKHOUSE', False);
   _weapon_SetWeaponCheckFriendOnLine('NUCLGRE', False);
   _weapon_SetWeaponCheckFriendOnLine('PSMPOINTTPUS', False);
   _weapon_SetWeaponCheckFriendOnLine('DIMMORT1', False);
   _weapon_SetWeaponCheckFriendOnLine('DIMMORT2NEW', False);
   _weapon_SetWeaponCheckFriendOnLine('PSMPOINTT', False);
   _weapon_SetWeaponCheckFriendOnLine('DIMMORT2KOR', False);
   
   // Use owner fxshot
   _weapon_SetWeaponUseOwnerFXShot('SHOTMUSKET');
   _weapon_SetWeaponUseOwnerFXShot('SHOTCANNON');
   _weapon_SetWeaponUseOwnerFXShot('SHOTTOWER');
   _weapon_SetWeaponUseOwnerFXShot('SHOTSHIP');
   _weapon_SetWeaponUseOwnerFXShot('SHOTCANNISTER');
   _weapon_SetWeaponUseOwnerFXShot('SHOTMORTAR');
