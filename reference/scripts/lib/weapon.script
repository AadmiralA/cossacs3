// _weapon_SetWeaponChilds
//
procedure _weapon_SetWeaponChilds(const weaponsid : String; mincount, maxcount : Integer; buseparentdestpos : Boolean; const s1, s2, s3, s4 : String);
begin
   var tweaponsid : String = weaponsid;
   var id : Integer = _weapon_GetWeaponIdBySID(tweaponsid);
   if (id>-1) then
   begin
      gWeapons[id].childs.mincount := mincount;
      gWeapons[id].childs.maxcount := maxcount;
      gWeapons[id].childs.buseparentdestpos := buseparentdestpos;
      var id1, id2, id3, id4 : Integer = -1;
      var ts1 : String = s1;
      var ts2 : String = s2;
      var ts3 : String = s3;
      var ts4 : String = s4;
      if (ts1<>'') then id1 := _weapon_GetWeaponIdBySID(ts1);
      if (ts2<>'') then id2 := _weapon_GetWeaponIdBySID(ts2);
      if (ts3<>'') then id3 := _weapon_GetWeaponIdBySID(ts3);
      if (ts4<>'') then id4 := _weapon_GetWeaponIdBySID(ts4);
      if (id1>-1) then gWeapons[id].childs.list.Add(id1);
      if (id2>-1) then gWeapons[id].childs.list.Add(id2);
      if (id3>-1) then gWeapons[id].childs.list.Add(id3);
      if (id4>-1) then gWeapons[id].childs.list.Add(id4);
   end;
end;

// _weapon_SetWeaponChildsByList
//
procedure _weapon_SetWeaponChildsByList(var weaponsid : String; mincount, maxcount : Integer; buseparentdestpos : Boolean; var childlist : TIntegerList; bClearList : Boolean);
begin
   var id : Integer = _weapon_GetWeaponIdBySID(weaponsid);
   if (id>-1) then
   begin
      gWeapons[id].childs.mincount := mincount;
      gWeapons[id].childs.maxcount := maxcount;
      gWeapons[id].childs.buseparentdestpos := buseparentdestpos;
      gWeapons[id].childs.list := childlist; // check if integerlist can be so easily copied
   end;
   if (bClearList) then
   childlist.Clear;
end;

// _weapon_AddWeaponToList
//
procedure _weapon_AddWeaponToList(var childlist : TIntegerList; var weaponsid : String);
begin
   var id : Integer = _weapon_GetWeaponIdBySID(weaponsid);
   if (id>-1) then
   childlist.Add(id);
end;

// _weapon_SetWeaponSyncWeapon
//
procedure _weapon_SetWeaponSyncWeapon(const weaponsid : String; const s1, s2, s3, s4 : String);
begin
   var tweaponsid : String = weaponsid;
   var id : Integer = _weapon_GetWeaponIdBySID(tweaponsid);
   if (id>-1) then
   begin
      var id1, id2, id3, id4 : Integer = -1;
      var ts1 : String = s1;
      var ts2 : String = s2;
      var ts3 : String = s3;
      var ts4 : String = s4;
      if (ts1<>'') then id1 := _weapon_GetWeaponIdBySID(ts1);
      if (ts2<>'') then id2 := _weapon_GetWeaponIdBySID(ts2);
      if (ts3<>'') then id3 := _weapon_GetWeaponIdBySID(ts3);
      if (ts4<>'') then id4 := _weapon_GetWeaponIdBySID(ts4);
      if (id1>-1) then gWeapons[id].syncweaponslist.Add(id1);
      if (id2>-1) then gWeapons[id].syncweaponslist.Add(id2);
      if (id3>-1) then gWeapons[id].syncweaponslist.Add(id3);
      if (id4>-1) then gWeapons[id].syncweaponslist.Add(id4);
   end;
end;

// _weapon_SetWeaponCustomExplosions
//
procedure _weapon_SetWeaponCustomExplosions(const weaponsid : String; material, mincount, maxcount : Integer; const s1, s2, s3, s4, s5 : String);
begin
   var tweaponsid : String = weaponsid;
   var id : Integer = _weapon_GetWeaponIdBySID(tweaponsid);
   if (id>-1) then
   begin
      gWeapons[id].customexplosions[material].mincount := mincount;
      gWeapons[id].customexplosions[material].maxcount := maxcount;
      var id1, id2, id3, id4, id5 : Integer = -1;
      var ts1 : String = s1;
      var ts2 : String = s2;
      var ts3 : String = s3;
      var ts4 : String = s4;
      var ts5 : String = s5;
      if (ts1<>'') then id1 := _weapon_GetWeaponIdBySID(ts1);
      if (ts2<>'') then id2 := _weapon_GetWeaponIdBySID(ts2);
      if (ts3<>'') then id3 := _weapon_GetWeaponIdBySID(ts3);
      if (ts4<>'') then id4 := _weapon_GetWeaponIdBySID(ts4);
      if (ts5<>'') then id5 := _weapon_GetWeaponIdBySID(ts5);
      if (id1>-1) then gWeapons[id].customexplosions[material].list.Add(id1);
      if (id2>-1) then gWeapons[id].customexplosions[material].list.Add(id2);
      if (id3>-1) then gWeapons[id].customexplosions[material].list.Add(id3);
      if (id4>-1) then gWeapons[id].customexplosions[material].list.Add(id4);
      if (id5>-1) then gWeapons[id].customexplosions[material].list.Add(id5);
   end;
end;

// _weapon_Init
//
procedure _weapon_Init();
begin
   const cFXNone = '';
   const cFXPoint = '';
   
   // SHOT EFFECT
   const cFXMusket = 'shotmusket';
   const cFXCannon = 'shotcannon';
   const cFXCannonCannister = 'shotcannon';
   const cFXCannonShip = 'shotcannon';
   const cFXMulticannon = 'shotmusket';
   const cFXMortar = 'shotmortar';
   const cFXHowitzer = 'shotmortar';
   const cFXTower = 'shottower';
   
   // IMPACT EFFECT (GROUND, BUILDING, WATER)
   const cFXImpDust = 'impactdust';
   const cFXImpDustBuilding = 'impactsmoke';
   const cFXImpWaterSmall = 'waterblastsmall';
   const cFXImpWaterLarge = 'waterblast';
   
   // EXPLOSIONS
   const cFXGrenadeExp = 'grenadeexp'; // grenade explosion
   const cFXCannonExp = 'cannonexpground'; // cannon ball terrain explosion
   const cFXCannonExpBuilding = 'cannonexpbuilding'; // cannon ball building explosion
   const cFXHowitzerExp = 'howitzerexpground'; // howitzer ball terrain explosion
   const cFXHowitzerExpBuilding = 'howitzerexpbuilding'; // howitzer ball building explosion
   const cFXBuildingExp = 'grenadeexp'; // building explosion on death
   const cFXShipExp = 'grenadeexp'; // ship explosion on death
   const cFXCannonShipExp = 'cannonexpground'; // ship explosion on death
   const cFXFramExp = 'framexp'; // framegun explosion
   
   // TRAILS
   const cFXTrailCannonBall = 'bullettrail';
   const cFXTrailHowitzerBall = 'bullettrail';
   const cFXTrailMortarBall = 'bullettrail';
   const cFXTrailGrenade = 'bullettrail';
   const cFXTrailArrow = 'bullettrail';
   const cFXTrailFireArrow = 'firearrowtrail';
   const cFXTrailCannonBallShip = 'bullettrail';
   const cFXTrailHowitzerBallFragment = 'fragtrail';
   const cFXTrailDebrisWood = 'fragtrail';
   const cFXTrailDebrisStone = 'fragtrail';
   
   // MISC
   const cFXArrow = 'arrow';
   const cFXFireArrow = 'firearrow';
   
   // PROJECTILES MESHES
   const cProjNone = gc_basename_point;
   const cProjUnused = gc_basename_point;
   const cProjPoint = gc_basename_point;
   const cProjDummy = 'projectile';
   const cProjCannonBall = 'projcannonball';
   const cProjHowitzerBall = 'projhowitzerball';
   const cProjHowitzerBallFragment = 'projhowitzerballfragment';
   const cProjMortarBall = 'projmortarball';
   const cProjGrenade = 'projgrenade';
   const cProjArrow = 'projarrow';
   const cProjArrowGround = 'projarrow';
   const cProjDebrisWood = 'debris_wood';
   const cProjDebrisStone = 'debris_stone';
   
   // Register new weapon member
   // null
   var ind : Integer;
   _weapon_AddWeapon(ind, '', '', '', 0, 0, gc_weapon_gravity_0, gc_weapon_propagation_stand, 0, gc_weapon_time_cPlayOnce);
   // others
   _weapon_AddWeapon(ind, 'SHOTMUSKET', cFXMusket, cProjNone, 0, 0, gc_weapon_gravity_0, gc_weapon_propagation_immediate{gc_weapon_propagation_stand}, 1, gc_weapon_time_cPlayOnce);
   _weapon_AddWeapon(ind, 'SHOTCANNON', cFXCannon, cProjNone, 0, _misc_PixelsToTiles(20), gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce); // change damage from 1 to 0, dont think that this is important
   _weapon_AddWeapon(ind, 'SHOTSHIP', cFXCannonShip, cProjNone, 0, _misc_PixelsToTiles(20), gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce); // change damage from 1 to 0, dont think that this is important
   _weapon_AddWeapon(ind, 'SHOTCANNISTER', cFXCannonCannister, cProjNone, 0, _misc_PixelsToTiles(20), gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce); // change damage from 1 to 0, dont think that this is important
   _weapon_AddWeapon(ind, 'SHOTMORTAR', cFXMortar, cProjNone, 0, 0, gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce);
   _weapon_AddWeapon(ind, 'SHOTHOWITZER', cFXHowitzer, cProjNone, 0, 0, gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce);
   _weapon_AddWeapon(ind, 'SHOTMULTICANNON', cFXMulticannon, cProjNone, 0, 0, gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce);
   _weapon_AddWeapon(ind, 'SHOTTOWER', cFXCannon, cProjNone, 0, _misc_PixelsToTiles(20), gc_weapon_gravity_0, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce); // change damage from 1 to 0, dont think that this is important
   _weapon_AddWeapon(ind, 'NUCL2P', cFXNone, cProjCannonBall, 340, _misc_PixelsToTiles(35), gc_weapon_gravity_2, gc_weapon_propagation_angle, 10, gc_weapon_time_cInfinite);
   _weapon_AddWeapon(ind, 'NUCL2PTOW', cFXNone, cProjCannonBall, 340, _misc_PixelsToTiles(35), gc_weapon_gravity_2, gc_weapon_propagation_fly, 38, gc_weapon_time_cInfinite);
