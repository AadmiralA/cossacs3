   _weapon_SetWeaponCustomExplosions('NUCL3MONOEXPL', gc_obj_explmedia_building, 1, 1, 'SMALL2BLD', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('NUCL3MONOEXPL', gc_obj_explmedia_grass, 1, 1, 'SMALL2', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('NUCL3MONOEXPL', gc_obj_explmedia_water, 1, 1, 'VODABUL', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('POINTOTVZRIV', gc_obj_explmedia_water, 1, 1, 'VODABUL2', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('debriswood', gc_obj_explmedia_water, 1, 1, 'VODABUL2', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('debrisstone', gc_obj_explmedia_water, 1, 1, 'VODABUL2', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('POINT', gc_obj_explmedia_water, 1, 1, 'VODABUL2', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('NUCLMOSKOL', gc_obj_explmedia_water, 1, 1, 'VODABUL2', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('STRELA', gc_obj_explmedia_grass, 1, 1, 'STRELDEZPRO', 'POINT', 'POINT', 'POINT', '');
   _weapon_SetWeaponCustomExplosions('OSTRELA', gc_obj_explmedia_grass, 1, 1, 'STRELDEZPRO', 'POINT', 'POINT', 'POINT', '');
   _weapon_SetWeaponCustomExplosions('PUEXP', gc_obj_explmedia_building, 5, 9, 'debriswood', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('PUEXP', gc_obj_explmedia_wood, 5, 9, 'debriswood', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('PUEXP', gc_obj_explmedia_ship, 4, 4, 'debriswood', 'debriswood', 'debriswood', 'KAPEZ', '');
   _weapon_SetWeaponCustomExplosions('PUEXPONSHIP', gc_obj_explmedia_ship, 4, 4, 'debriswood', 'debriswood', 'debriswood', 'KAPEZ', '');
   _weapon_SetWeaponCustomExplosions('PUEXPBLD', gc_obj_explmedia_building, 5, 9, 'debriswood', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('PUNOEXPBLD', gc_obj_explmedia_building, 5, 9, 'debriswood', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('PUEXPKOR', gc_obj_explmedia_wood, 10, 20, 'debriswood', '', '', '', '');
   _weapon_SetWeaponCustomExplosions('PUEXPKOR', gc_obj_explmedia_ship, 20, 30, 'debriswood', '', '', '', '');
   
   gDestructListBuilding.Clear;
   gDestructListBuilding.Add(GetWeaponIDBySIDConst('debrisstone'));
   gDestructListBuilding.Add(GetWeaponIDBySIDConst('debrisstone'));
   gDestructListBuilding.Add(GetWeaponIDBySIDConst('PUEXPBUILDINGDEATH'));
   
   gDestructListShip.Clear;
   gDestructListShip.Add(GetWeaponIDBySIDConst('debriswood'));
   gDestructListShip.Add(GetWeaponIDBySIDConst('debriswood'));
   gDestructListShip.Add(GetWeaponIDBySIDConst('PUEXPKORDEATH'));
end;

// _weapon_CalcShotDispertion
//
procedure _weapon_CalcShotDispertion(goHnd : Integer; disp, tx, ty, tz : Float; var dx, dy, dz : Float);
begin
   if (goHnd<>0) and (disp>0) then
   begin
      var px : Float = GetGameObjectPositionXByHandle(goHnd);
      var pz : Float = GetGameObjectPositionZByHandle(goHnd);
      var dist : Float = VectorDistance(px, 0, pz, tx, 0, tz);
      var maxdisp : Float = dist*disp*gc_pixels_to_tile/2000;
      dx := tx+(1-RandomExt*2)*maxdisp;
      dz := tz+(1-RandomExt*2)*maxdisp;
      dy := ty;
      //dy := RayCastHeight(dx, dz);
   end
   else
   begin
      dx := tx;
      dy := ty;
      dz := tz;
   end;
end;

// _weapon_GetUnitShotStartPosition
//
procedure _weapon_GetUnitShotStartPosition(goHnd : Integer; var sx, sy, sz : Float);
begin
   // find shot point
   // use shot point offset
   // if no shot point, use this numbers, perhaps?
   {var zpoint : Float;
   var unittype : Integer = _misc_GetUnitType(goHnd);
   if (unittype=gc_result_unittype_inf) then
   zpoint := 27
   else
   if (unittype=gc_result_unittype_cav) then
   zpoint := 51
   else
   zpoint := 3;}
   // return real point where shot should be (visual ending of rifle or cannon)
   GetGameObjectAbsolutePositionByHandle(goHnd, sx, sy, sz);
   if (sy<0) then
   sy := 0.05;
end;

// _weapon_GetUnitShotEndPosition
//
procedure _weapon_GetUnitShotEndPosition(goHnd : Integer; var dx, dy, dz : Float);
begin
   var pobj : Pointer = _misc_GetObjectArgData(goHnd, gc_argunit_obj);
   if (pobj<>nil) and ((gObjProp[TObj(pObj).cid][TObj(pObj).id].bbuilding) or (gObjProp[TObj(pObj).cid][TObj(pObj).id].explmedia=gc_obj_explmedia_ship)) then
   begin
      var dirx, diry, dirz : Float;
      var bUseCustTransformed : Boolean = GetGameObjectUseCustTransformedByHandle(goHnd);
      if (bUseCustTransformed) then
      begin
         var upx, upy, upz : Float;
         GetGameObjectOrientationByHandle(goHnd, upx, upy, upz, dirx, diry, dirz);
         var angle : Float = VectorAngle(-1, 0, 0, upx, 0, upz);
         var tmpx, tmpy, tmpz : Float;
         VectorCross(-1, 0, 0, upx, 0, upz, tmpx, tmpy, tmpz);
         if (tmpy<0) then
         angle := -angle;
         
         var minx, miny, minz, maxx, maxy, maxz : Float;
         GetGameObjectCustomBoundingAABBByHandle(goHnd, minx, miny, minz, maxx, maxy, maxz);
         dirx := (minx+maxx)*0.5;
         if (gObjProp[TObj(pObj).cid][TObj(pObj).id].explmedia=gc_obj_explmedia_ship) then
         diry := (miny+maxy)*(0.05+RandomExt*0.075) // (0.2+RandomExt*0.3)
         else
         if (gObjProp[TObj(pObj).cid][TObj(pObj).id].bwall) then
         diry := (miny+maxy)*(0.15+RandomExt*0.3)
         else
         diry := (miny+maxy)*(0.2+RandomExt*0.4);
         //diry := (miny+maxy)*(0.25+RandomExt*0.5);
         dirz := (minz+maxz)*0.5;
         VectorRotateY(dirx, diry, dirz, angle);
      end;
      GetGameObjectAbsolutePositionByHandle(goHnd, dx, dy, dz);
      dx := dx+dirx;
      dy := dy+diry;
      dz := dz+dirz;
   end
   else
   begin
      {var zpoint : Float;
      var basename : String = GetGameObjectBaseNameByHandle(goHnd);
      case basename of
         'cannon' : zpoint := 30;
         'howitzer' : zpoint := 15;
         'mortar' : zpoint := 15;
         'multicannon' : zpoint := 27;
         'eurtow', 'rustow', 'turtow' : zpoint := 51;
         else
         begin
            var unittype : Integer = _misc_GetUnitType(goHnd);
            if (unittype=gc_result_unittype_inf) then
            zpoint := 27
            else
            if (unittype=gc_result_unittype_cav) then
            zpoint := 51
            else
            zpoint := 3;
         end;
      end;
      zpoint := zpoint*gc_tiles_to_pixels;}
      
      // return real point where shot should be (visual ending of rifle or cannon)
      GetGameObjectAbsolutePositionByHandle(goHnd, dx, dy, dz);
      {dx := GetGameObjectPositionXByHandle(goHnd);
      dy := GetGameObjectPositionYByHandle(goHnd);// +zpoint shot in legs, not in air+0.5;
      dz := GetGameObjectPositionZByHandle(goHnd);}
   end;
end;

// _weapon_CheckWeapon
//
function _weapon_CheckWeaponTargetable(weaponid : Integer) : Boolean;
begin
   Result := (gWeapons[weaponid].propagation=gc_weapon_propagation_immediate) or (gWeapons[weaponid].propagation=gc_weapon_propagation_fly) or (gWeapons[weaponid].propagation=gc_weapon_propagation_angle) or (gWeapons[weaponid].propagation=gc_weapon_propagation_random) or (gWeapons[weaponid].propagation=gc_weapon_propagation_randomsimulate);
end;

// _weapon_CheckWeapon
//
function _weapon_CheckWeapon(weaponid : Integer) : Boolean;
begin
   Result := (gWeapons[weaponid].propagation=gc_weapon_propagation_immediate) or (gWeapons[weaponid].propagation=gc_weapon_propagation_fly) or (gWeapons[weaponid].propagation=gc_weapon_propagation_angle);
end;

// _weapon_GetFlyChild
//
function _weapon_GetFlyChild(weaponid : Integer) : Integer;
begin
   if (_weapon_CheckWeapon(weaponid)) then
   begin
      Result := weaponid;
      exit;
   end;
   
   Result := 0;
   if (weaponid<>0) then
   begin
      var pweapon : Pointer = gWeapons[weaponid];
      if (pweapon<>nil) then
      begin
         var i : Integer;
         for i:=0 to TWeapon(pweapon).childs.list.GetCount-1 do
         begin
            var childweaponid : Integer = TWeapon(pweapon).childs.list.Get(i);
            if (_weapon_CheckWeapon(childweaponid)) then
            begin
               Result := childweaponid;
               exit;
            end;
         end;
         for i:=0 to TWeapon(pweapon).syncweaponslist.GetCount-1 do
         begin
            var syncweaponid : Integer = TWeapon(pweapon).syncweaponslist.Get(i);
            if (_weapon_CheckWeapon(syncweaponid)) then
            begin
               Result := syncweaponid;
               exit;
            end;
         end;
      end;
   end;
end;

// _weapon_PredictShot
//
function _weapon_PredictShot(myHnd, parentweaponid : Integer; sx, sy, sz, dx, dy, dz : Float) : Boolean;
begin
   Result := False;
   var weaponid : Integer = _weapon_GetFlyChild(parentweaponid);
   if (weaponid<>0) then
   begin
      Result := True;
   end;
end;

// _weapon_ThrowByAngle
//
function _weapon_ThrowByAngle(bHnd : Integer; angle, posX, posY, posZ, trgX, trgY, trgZ : Float) : Boolean;
begin
   SetBehaviourAffineVectorProperty(bHnd, 'TargetPosition', trgX, trgY, trgZ);
   
   var dirX, dirY, dirZ : Float;
   dirX := trgX-posX;
   dirY := 0;
   dirZ := trgZ-posZ;
   
   var rX, rY, rZ : Float;
   VectorCross(0, 1, 0, dirX, dirY, dirZ, rX, rY, rZ);
   VectorRotateAxis(dirX, dirY, dirZ, rX, rY, rZ, angle);
   
   SetBehaviourAffineVectorProperty(bHnd, 'Direction', dirX, dirY, dirZ);
   Result := GetBehaviourBoolProperty(bHnd, 'CalcSpeedByDirAndTrgPos');
end;

// _weapon_ThrowByHSpeed
//
function _weapon_ThrowByHSpeed(bHnd : Integer; hSpeed, trgX, trgY, trgZ : Float) : Boolean;
begin
   SetBehaviourAffineVectorProperty(bHnd, 'TargetPosition', trgX, trgY, trgZ);
   
   SetBehaviourFloatProperty(bHnd, 'HSpeed', hSpeed);
   Result := GetBehaviourBoolProperty(bHnd, 'CalcDirByHSpeedAndTrgPos');
end;

// _weapon_ThrowRandom
//
procedure _weapon_ThrowRandom(bHnd : Integer; speed : Float);
begin
   var spX : Float = 2*(RandomExt-0.5)*speed;
   var spY : Float = RandomExt * speed;
   var spZ : Float = 2*(RandomExt-0.5)*speed;
   
   var len : Float = VectorLength(spX, spY, spZ);
   if (len=0) then
   begin
      spX := speed;
      spY := speed;
      spZ := speed;
      len := VectorLength(spX, spY, spZ);
   end;
   SetBehaviourFloatProperty(bHnd, 'Speed', len);
   SetBehaviourAffineVectorProperty(bHnd, 'Direction', spX, spY, spz);
   SetupThrowBehaviourSpeed(bHnd);
end;

// _weapon_InitProjectile
//
procedure _weapon_InitProjectile(projHnd : Integer);
begin
   const cFXPlayOnceDummy = 'shotmusket';
   
   var pproj : Pointer = _weapon_GetTProj(projHnd);
   var id : Integer = TProj(pproj).weaponid;
   if (id>-1) then
   begin
      //_misc_ProfilerBegin('_wpn_InitProj');
      var px : Float = TProj(pproj).px;
      var py : Float = TProj(pproj).py;
      var pz : Float = TProj(pproj).pz;
      var tx : Float = TProj(pproj).dx;
      var ty : Float = TProj(pproj).dy;
      var tz : Float = TProj(pproj).dz;
      var speed : Float = _misc_PixelsToTiles(floor(gWeapons[id].speed*1000))*0.001*gc_time_to_frames;
      var time : Float = gWeapons[id].time;
      var propagation : Integer = gWeapons[id].propagation;
      var gravity : Float;
      // constangle and random
      case (gWeapons[id].gravity) of
         gc_weapon_gravity_0 : gravity := 2; // need at least some gravity to work properly. used by gc_weapon_propagation_stand and gc_weapon_propagation_slightup and cannon and multicannon cannister
         gc_weapon_gravity_1 : gravity := 2.5; // no one use
         gc_weapon_gravity_2 : gravity := 3.75; // cannonball/towerball/shipball and arrows
         gc_weapon_gravity_3 : gravity := 7;//5.625; use debris and unvisible point dmg random dir projectiles
         gc_weapon_gravity_4 : gravity := 9.25; // no one use
         gc_weapon_gravity_5 : gravity := 11.5; // mortar and howitzer balls and their fragments
      end;
      if (propagation=gc_weapon_propagation_fly) then
      begin
         case (gWeapons[id].gravity) of
            gc_weapon_gravity_2 : gravity := 11.5; // arrows
         end;
      end;
      //test
      //gravity := gWeapons[id].gravity*128*gc_tiles_to_pixels;
      
      if (gravity=0) then
      gravity := 2;
      
      //log(gWeapons[id].sid+' g='+FloatToStr(gravity));
      SetGameObjectPositionByHandle(projHnd, px, py, pz);
      
      var bPlayOnce : Boolean = (time=gc_weapon_time_cPlayOnce);
      if (not bPlayOnce) then
      begin
         {if (propagation=gc_weapon_propagation_random) then // tune visual part of fragments
         begin
            const cModifierGravity = 0.4;
            const cModifierSpeed = cModifierGravity*(1/cModifierGravity)/2;
            gravity := gravity*cModifierGravity;
            speed := speed*cModifierSpeed;
         end;}
         
         var energyloss : Float;
         if (gWeapons[id].gravity<>0) then
         energyloss := 1;
         var onstopevent : String;
         if (time=gc_weapon_time_cInfinite) then
         onstopevent := 'OnStopEvent';
         
         var bHnd : Integer = BehaviourCreate(projHnd, 'TXThrowBehaviour', true, false);
         SetBehaviourStringProperty(bHnd, 'OnStopEvent', onstopevent);
         SetBehaviourFloatProperty(bHnd, 'ProgressDeltaTime', 0.00000001);
         SetBehaviourFloatProperty(bHnd, 'EnergyLoss', energyloss);
         SetBehaviourFloatProperty(bHnd, 'DecFactor', 0);
         SetBehaviourFloatProperty(bHnd, 'Speed', speed);
         SetBehaviourFloatProperty(bHnd, 'Deceleration', 0);
         SetBehaviourFloatProperty(bHnd, 'Height', py);
         SetBehaviourFloatProperty(bHnd, 'Gravity', gravity);
         SetBehaviourFloatProperty(bHnd, 'Radius', 0.01);
         SetBehaviourBoolProperty(bHnd, 'Rotate', gWeapons[id].brotate);
         SetBehaviourBoolProperty(bHnd, 'RayCastWater', True);
         SetBehaviourBoolProperty(bHnd, 'FreeWhenDone', False);
         
         if (gWeapons[id].brotate) then
         begin
            var rotspeed : Float;
            if (propagation=gc_weapon_propagation_random1) then
            rotspeed := (2+RandomExt*8)
            else
            rotspeed := (2+RandomExt*4);
            SetBehaviourFloatProperty(bHnd, 'RotationSpeed', rotspeed);
         end
         else
         SetBehaviourFloatProperty(bHnd, 'RotationSpeed', 0);
         
         var bthrow : Boolean;
         case propagation of
            gc_weapon_propagation_angle : begin
               bthrow := _weapon_ThrowByAngle(bHnd, gWeapons[id].angle, px, py, pz, tx, ty, tz);
               if (not bthrow) then
               log('unable to throw projectile bconstangle');
            end;
            gc_weapon_propagation_fly : begin
               SetBehaviourBoolProperty(bHnd, 'RotateToTangent', gWeapons[id].brotate);
               bthrow := _weapon_ThrowByHSpeed(bHnd, speed, tx, ty, tz);
               if (not bthrow) then
               log('unable to throw projectile bconstspeed');
            end;
            gc_weapon_propagation_random, gc_weapon_propagation_random1 : begin
               bthrow := False;
               _weapon_ThrowRandom(bHnd, speed);
            end;
            gc_weapon_propagation_randomsimulate : begin
               bthrow := False;
               _weapon_ThrowRandom(bHnd, speed);
            end;
         end;
         
         if (bthrow) and (gWeapons[id].bcollisiondetection) then
         begin
            SetGameObjectCollisionPriorityByHandle(projHnd, 10000);
            SetGameObjectCollisionDetectionByHandle(projHnd, True);
            SetGameObjectCollidedStateNameByHandle(projHnd, '_weapon_OnCollide');
            SetGameObjectCollisionExecAsFuncByHandle(projHnd, True);
         end
         else
         begin
            SetGameObjectCollisionDetectionByHandle(projHnd, False);
            SetGameObjectCollidedStateNameByHandle(projHnd, '');
            SetGameObjectCollisionExecAsFuncByHandle(projHnd, False);
         end;
         
         if (gWeapons[id].trailfx<>'') then
         gEffectLibrary.GetOrCreate(gWeapons[id].trailfx, projHnd);
         
         if (time>0) then
         GameObjectDelayExecuteStateByHandle(projHnd, 'OnStopEvent', time);
         //_misc_ProfilerEnd('_wpn_InitProj');
      end
      else
      begin
         SetGameObjectCollisionDetectionByHandle(projHnd, False);
         SetGameObjectCollidedStateNameByHandle(projHnd, '');
         SetGameObjectCollisionExecAsFuncByHandle(projHnd, False);
         SetGameObjectScaleByHandle(projHnd, 0.00001, 0.00001, 0.00001);
         if (gWeapons[id].buseownerfxshot) then
         begin
            var fxshot : String;
            var pobjweapon : Pointer = gObjProp[TProj(pproj).ownercid][TProj(pproj).ownerid].weapon[TProj(pproj).ownerweaponind];
            if (pobjweapon<>nil) then
            fxshot := TObjWeaponStatic(pobjweapon).fxshot;
            var ind : Integer = gEffectLibrary.GetOrCreate(fxshot, projHnd);
            //_misc_ProfilerEnd('_wpn_InitProj');
            GameObjectExecuteStateByHandle(projHnd, 'DoExplode');
            if (ind<0) then
            GameObjectExecuteStateByHandle(projHnd, 'FreeToPool');
         end
         else
         begin
            if (gWeapons[id].fx<>'') then
            begin
               var ind : Integer = -1;
               if (gWeapons[id].volumeclippedfreq<=0) or (gWeapons[id].volumeclippedfreq<random) or (gSoundManager.IsObjInFrustum(projHnd)) then // I use general random, cause no need to sync it and randomext may change planned results on dif PCs
               ind := gEffectLibrary.GetOrCreate(gWeapons[id].fx, projHnd);
               GameObjectExecuteStateByHandle(projHnd, 'DoExplode');
               if (ind<0) then
               GameObjectExecuteStateByHandle(projHnd, 'FreeToPool');
            end
            else
            if (gProfile.bDbgVisualizePlayOnceProjFX) then
            begin
               var fxshot : String = cFXPlayOnceDummy;
               var ind : Integer = gEffectLibrary.GetOrCreate(fxshot, projHnd);
               //_misc_ProfilerEnd('_wpn_InitProj');
               GameObjectExecuteStateByHandle(projHnd, 'DoExplode');
               if (ind<0) then
               GameObjectExecuteStateByHandle(projHnd, 'FreeToPool');
            end
            else
            begin
               GameObjectExecuteStateByHandle(projHnd, 'DoExplode');
               GameObjectExecuteStateByHandle(projHnd, 'FreeToPool');
            end;
         end;
      end;
   end;
end;

// _weapon_CreateProjectileByWeaponID
//
function _weapon_CreateProjectileByWeaponID(goHnd, trgHnd : Integer; bUseParentPosition : Boolean; tmppx, tmppy, tmppz : Float; weaponid : Integer; tx, ty, tz : Float; ownercid, ownerid, ownerweaponind : Integer; uniqrnd : Float) : Integer;
begin
   Result := 0;
   if (weaponid>-1) and (gWeapons[weaponid].projbasename<>'') then
   begin
      if (GetCountOfPlayers>=gc_playerind_misc) then
      begin
         var newuniqrnd : Float;
         if uniqrnd=0 then
         newuniqrnd := random
         else
         newuniqrnd := uniqrnd;
         SetRandomKey(floor(newuniqrnd*gc_MaxInt)); // sync multiplayer
         
         var plHnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
         var px, py, pz : Float;
         if (bUseParentPosition) then
         begin
            GetGameObjectAbsolutePositionByHandle(goHnd, px, py, pz);
            //_weapon_GetUnitShotStartPosition(goHnd, px, py, pz);
         end
         else
         begin
            px := tmppx;
            py := tmppy;
            pz := tmppz;
         end;
         var upx, upy, upz, dirx, diry, dirz : Float;
         
         if (goHnd<>0) then
         begin
            GetGameObjectOrientationByHandle(goHnd, upx, upy, upz, dirx, diry, dirz);
            if (gWeapons[weaponid].buseownercustomobjpoints) then
            begin
               gIntegerList.Clear;
               if (gCustomObjPoints[ownercid][ownerid].shotCount>0) then
               begin
                  var shotangle : Float;
                  var bRotatable : Boolean = (not gObjProp[ownercid][ownerid].bbuilding);
                  if (bRotatable) then
                  begin
                     var tmpx : Float = tx-px;
                     var tmpz : Float = tz-pz;
                     shotangle := _misc_VectorAngle(upx, upz, tmpx, tmpz);
                     shotangle := Abs(shotangle-180);
                  end
                  else
                  shotangle := _misc_GetAngleToXVectorInvert(tx, tz, px, pz);
                  var ind : Integer;
                  var i : Integer;
                  for i:=0 to gCustomObjPoints[ownercid][ownerid].shotCount-1 do
                  begin
                     if (not gCustomObjPoints[ownercid][ownerid].shotPoints[i].bcustomweaponind) or (gCustomObjPoints[ownercid][ownerid].shotPoints[i].weaponind=ownerweaponind) then
                     begin
                        if (gCustomObjPoints[ownercid][ownerid].shotPoints[i].bcustomdir) then
                        begin
                           var shotangletmp : Float;
                           var minangle : Float = gCustomObjPoints[ownercid][ownerid].shotPoints[i].minangle;
                           var maxangle : Float = gCustomObjPoints[ownercid][ownerid].shotPoints[i].maxangle;
                           if (minangle<0) then
                           begin
                              if (shotangle<180) then
                              shotangletmp := shotangle+360
                              else
                              shotangletmp := shotangle;
                              minangle := minangle+360;
                              maxangle := maxangle+360;
                           end
                           else
                           shotangletmp := shotangle;
                           if (shotangletmp>minangle) and (shotangletmp<maxangle) then
                           gIntegerList.Add(i);
                        end
                        else
                        gIntegerList.Add(i);
                     end;
                  end;
                  var count : Integer = gIntegerList.GetCount;
                  if (count>0) then
                  ind := gIntegerList.Get(floor(RandomExt*count));
                  var shotx : Float = gCustomObjPoints[ownercid][ownerid].shotPoints[ind].x;
                  var shoty : Float = gCustomObjPoints[ownercid][ownerid].shotPoints[ind].y;
                  var shotz : Float = gCustomObjPoints[ownercid][ownerid].shotPoints[ind].z;
                  if (bRotatable) then
                  begin
                     var lookangle : Float = _misc_GetAngleToXVectorDirectInvert(upx, upz);
                     VectorRotateY(shotx, shoty, shotz, -lookangle+180);
                  end;
                  px := px+shotx;
                  py := py+shoty;
                  pz := pz+shotz;
                  upx := px-tx;
                  upz := pz-tz;
                  VectorNormalize(upx, upy, upz);
               end;
            end;
            if (gWeapons[weaponid].propagation=gc_weapon_propagation_stand) then // cProjArrowGround
            py := RandomExt*0.125;
         end;
         
         //var projHnd : Integer = CreatePlayerGameObjectHandleByHandle(plHnd, gc_racename_misc, gWeapons[weaponid].projbasename, px, py, pz);
         var projHnd : Integer = CreatePoolGameObjectHandle(gc_racename_misc, gWeapons[weaponid].projbasename, px, py, pz);
         //BehaviourClearRequested(projHnd);
         GameObjectResetAndPitchTurnRollByHandle(projHnd, 0, 0, 0);
         GameObjectExecuteStateByHandle(projHnd, 'InitialEmpty');//'Initial');
         SetGameObjectVisibleByHandle(projHnd, True);
         //var projHnd : Integer = CreatePoolGameObjectHandle(gc_racename_misc, gWeapons[weaponid].projbasename, px, py, pz);
         
         if (gWeapons[weaponid].sndind<>0) then
         _sound_RequestPlaySound(gc_sndlib_ind_units, gWeapons[weaponid].sndind, px, pz);
         
         if (gWeapons[weaponid].propagation=gc_weapon_propagation_random1) then
         SetGameObjectOrientationByHandle(projHnd, (2*RandomExt-1), (2*RandomExt-1), (2*RandomExt-1), (2*RandomExt-1), (2*RandomExt-1), (2*RandomExt-1))
         else
         if (goHnd<>0) then
         begin
            SetGameObjectOrientationByHandle(projHnd, upx, upy, upz, dirx, diry, dirz);
            if (gWeapons[weaponid].propagation=gc_weapon_propagation_stand) then // cProjArrowGround
            GameObjectPitchByHandle(projHnd, -(30+RandomExt*30));
         end;
         
         var pproj : Pointer = _weapon_GetTProj(projHnd);
         if (pproj<>nil) then
         begin
            TProj(pproj).weaponid := weaponid;
            if (goHnd<>0) then
            TProj(pproj).owner := GetGameObjectUniqueIdByHandle(goHnd)
            else
            TProj(pproj).owner := 0; // needed after using pool
            if (trgHnd<>0) then
            TProj(pproj).trg := GetGameObjectUniqueIdByHandle(trgHnd)
            else
            TProj(pproj).trg := 0; // needed after using pool
            TProj(pproj).px := px;
            TProj(pproj).py := py;
            TProj(pproj).pz := pz;
            TProj(pproj).dx := tx;
            TProj(pproj).dy := ty;
            TProj(pproj).dz := tz;
            if (goHnd<>0) then
            TProj(pproj).ownerpl := GetPlayerIndexByHandle(GetGameObjectPlayerHandleByHandle(goHnd))
            else
            TProj(pproj).ownerpl := gc_MaxPlayerCount-1; // needed after using pool
            TProj(pproj).ownercid := ownercid;
            TProj(pproj).ownerid := ownerid;
            TProj(pproj).ownerweaponind := ownerweaponind;
            TProj(pproj).uniqrnd := newuniqrnd;
            _weapon_InitProjectile(projHnd);
         end;
         
         Result := projHnd;
      end;
   end;
end;

function _weapon_CreateDecalExp(var decname: String; x, z, ang: Float; rndang, rndind: Boolean; rndmax, rndoff: Integer; life: Float): Integer;
begin
   var rndval: Integer;
   const cdefdecname='groundexp';
   var tmpdecname : String = decname;
   if decname='' then begin
      tmpdecname:=cdefdecname;
      if not rndind then tmpdecname:=tmpdecname+'0';
   end;
   if rndind then begin
      rndval:=floor(random*rndmax+rndoff);
      tmpdecname:=tmpdecname+IntToStr(rndval);
   end;
   if rndang then
   ang:=random*360;
   var y : Float = RayCastHeight(x, z);
   var miscplhnd : Integer = GetPlayerHandleByIndex(gc_playerind_misc);
   //var dumhnd : Integer = CreatePlayerGameObjectHandleByHandle(miscplhnd, gc_racename_misc, 'decal', x, y, z);
   //GameObjectDelayExecuteStateByHandle(dumhnd, 'DoDeath', life);
   var dumhnd : Integer = CreatePoolGameObjectHandle(gc_racename_misc, 'decal', x, y, z);
   GameObjectDelayExecuteStateByHandle(dumhnd, 'DoDeath', life);
   //FreeToPoolGameObjectTimeoutHandle(dumhnd, life);
   var dechnd: Integer=AddNewDecalByLibName(dumhnd, x, z, ang, tmpdecname, tmpdecname);
   var effhnd: Integer=BaseObjectEffectCreateWithKey(dechnd, 'TXLifeColorEffect', 'lifecolor', false);
   SetBehaviourBoolProperty(effhnd, 'UseAmbient', false);
   SetBehaviourBoolProperty(effhnd, 'UseDiffuse', false);
   SetBehaviourBoolProperty(effhnd, 'UseEmission', false);
   SetBehaviourBoolProperty(effhnd, 'UseSpecular', false);
   SetBehaviourBoolProperty(effhnd, 'UseAlphaChannel', true);
   SetBehaviourBoolProperty(effhnd, 'UseShininess', false);
   SetBehaviourBoolProperty(effhnd, 'UseJustColorIfNoLight', true);
   SetBehaviourBoolProperty(effhnd, 'UseFrontFace', true);
   SetBehaviourBoolProperty(effhnd, 'UseBackFace', true);
   SetBehaviourIntProperty(effhnd,  'CurrIndex', 0);
   SetBehaviourBoolProperty(effhnd, 'Enable', true);
   SetBehaviourBoolProperty(effhnd, 'Loop', false);
   SetBehaviourBoolProperty(effhnd, 'ZWrite', false);
   SetBehaviourBoolProperty(effhnd, 'ZTest', true);
   SetBehaviourStringProperty(effhnd, 'Add', '');
   SetBehaviourFloatProperty(effhnd, 'AlphaChannel[0]', 1.0);
   SetBehaviourFloatProperty(effhnd, 'Time[0]', life);
   SetBehaviourStringProperty(effhnd, 'Add', '');
   SetBehaviourFloatProperty(effhnd, 'AlphaChannel[1]', 0.0);
   SetBehaviourFloatProperty(effhnd, 'Time[1]', 0.0);
   SetBehaviourBoolProperty(effhnd, 'OnEndReachedFreeOwner', False); // true lead to crash
   result:=dechnd;
end;

// _weapon_OnCollide
//
procedure _weapon_OnCollide(hnd : Integer);
begin
   var pproj : Pointer = _weapon_GetTProj(hnd);;
   var goHnd : Integer = GetGameObjectStateCollisionObjectByHandle(hnd);
   if (goHnd<>0) and (GetGameObjectHandleByUniqueId(TProj(pproj).owner)<>goHnd) then
   begin
      if (GetGameObjectHandleByUniqueId(TProj(pproj).trg)<>goHnd) and ((TProj(pproj).trg=0) or (not gWeapons[TProj(pproj).weaponid].buseownerdamage)) then
      begin
         var smhnd : Integer = GetGameObjectStateMachineHandle(goHnd);
         if (smhnd<>0) then
         begin
            var parg : Pointer = StateMachineGetArgDataByInd(smhnd, gc_argunit_obj);
            if (parg<>nil) and (TBaseObj(parg).baseid=gc_baseid_obj) and ((gObjProp[TObj(parg).cid][TObj(parg).id].bbuilding) or ((gObjProp[TObj(parg).cid][TObj(parg).id].explmedia=gc_obj_explmedia_ship) and GetPlayerHandleByIndex(hnd)<>GetPlayerHandleByIndex(goHnd))) then // prevent ships from friendly fire
            TProj(pproj).trg := GetGameObjectUniqueIdByHandle(goHnd);
         end;
      end;
      GameObjectSwitchToStateByHandle(hnd, 'Nothing')
   end
   else
   GameObjectSwitchToStateByHandle(hnd, 'NothingEmpty');
end;

_weapon_Init;