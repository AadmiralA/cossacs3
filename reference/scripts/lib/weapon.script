//
// weapon.script
//

// _weapon_GetTProj
//
function _weapon_GetTProj(goHnd : Integer) : Pointer;
begin
   Result := _misc_GetObjectArgData(goHnd, gc_argproj_proj);
   if (TBaseObj(Result).baseid<>gc_baseid_prj) then
   begin
      Result := nil;
      ErrorLog('_unit_GetTProj try to get wrong baseid : state='+GetCurrentStateName+' filename='+GetStateMachineFileName(GetCurrentStateMachineHandle));
   end;
   if (gProfile.bDbgLogPointerNil) then
   _init_DebugPointerNil(Result);
end;

// _weapon_GetWeaponIdBySID
//
function _weapon_GetWeaponIdBySID(var weaponsid : String) : Integer;
begin
   Result := -1;
   var i : Integer;
   for i:=0 to gc_weapon_maxmembers-1 do
   begin
      if (gWeapons[i].sid=weaponsid) then
      begin
         Result := i;
         break;
      end;
   end;
   if (Result=-1) then
   ErrorLog('GetWeaponIdBySID : unknown weaponsid = '+weaponsid);
end;

// _weapon_AddWeapon
//
procedure _weapon_AddWeapon(var ind : Integer; const weaponsid, fx, projbasename : String; damage : Integer; radius, gravity : Float; propagation : Integer; physvalue, time : Float);
begin
   //time<0 - gc_weapon_time_cInfinite
   //time=0 - gc_weapon_time_cPlayOnce
   //time>0 - play x time then die
   var weapon : TWeapon; // clear weapon with default settings
   weapon.sid := weaponsid;
   weapon.id := ind;
   weapon.fx := fx;
   weapon.sndind := gc_snd_ind_none;
   weapon.projbasename := projbasename;
   weapon.damage := damage;
   weapon.radius := radius;
   weapon.gravity := gravity;
   weapon.propagation := propagation;
   weapon.brotate := (propagation=gc_weapon_propagation_random1) and (projbasename<>'') and (projbasename<>'point');
   weapon.bcollisiondetection := ((propagation=gc_weapon_propagation_angle) or (propagation=gc_weapon_propagation_fly));
   weapon.bcheckfriendonline := True;
   weapon.volumeclippedfreq := 0;
   case propagation of
      gc_weapon_propagation_random, gc_weapon_propagation_random1, gc_weapon_propagation_fly, gc_weapon_propagation_randomsimulate : weapon.speed := physvalue;
      gc_weapon_propagation_angle : weapon.angle := physvalue;
      gc_weapon_propagation_slightup : weapon.gravity := -physvalue;
      gc_weapon_propagation_stand, gc_weapon_propagation_slightup, gc_weapon_propagation_immediate : ;
      else
      ErrorLog('AddWeapon, unknown propagation = '+IntToStr(propagation));
   end;
   weapon.time := time;
   gWeapons[ind] := weapon;
   ind := ind+1;
end;

// _weapon_SetWeaponTrail
//
procedure _weapon_SetWeaponTrail(const weaponsid, trailfx : String);
begin
   var tweaponsid : String = weaponsid;
   var id : Integer = _weapon_GetWeaponIdBySID(tweaponsid);
   if (id>-1) then
   gWeapons[id].trailfx := trailfx;
end;

