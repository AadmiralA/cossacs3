   _weapon_AddWeapon(ind, 'NUCL3MONO', cFXNone, cProjMortarBall, 250, _misc_PixelsToTiles(2), gc_weapon_gravity_5, gc_weapon_propagation_angle, 70, gc_weapon_time_cInfinite); // angle was 75
   _weapon_AddWeapon(ind, 'NUCL3MONONEW', cFXPoint, cProjMortarBall, 0, _misc_PixelsToTiles(2), gc_weapon_gravity_5, gc_weapon_propagation_angle, 70, gc_weapon_time_cInfinite); // angle was 75
