   _weapon_AddWeapon(ind, 'DIMMORT2', cFXPoint, cProjNone, 0, 0, gc_weapon_gravity_5, gc_weapon_propagation_slightup, 0, gc_weapon_time_cPlayOnce); // was propagaion=angle 60
