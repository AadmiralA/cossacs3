   _weapon_AddWeapon(ind, 'NUCLGRE', cFXNone, cProjGrenade, 110, _misc_PixelsToTiles(50), gc_weapon_gravity_5, gc_weapon_propagation_angle, 55, gc_weapon_time_cInfinite);
   _weapon_AddWeapon(ind, 'NUCLM', cFXPoint, cProjPoint, 100, _misc_PixelsToTiles(50), gc_weapon_gravity_5, gc_weapon_propagation_slightup, 0, _misc_FramesToTime(2));
