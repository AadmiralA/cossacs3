   _weapon_AddWeapon(ind, 'PUSSTRELA', cFXPoint, cProjPoint, 512, _misc_PixelsToTiles(25), gc_weapon_gravity_0, gc_weapon_propagation_fly, 20, _misc_FramesToTime(round(2*1.625))); // changed multiply to 1.5 in c3. Need to multiply 2, cause in c1 on fast speed weapon progress other way then on alow speed and cannister fire twice more far
